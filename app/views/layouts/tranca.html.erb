<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Arena - Tranca" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Arena">
    <meta name="mobile-web-app-capable" content="yes">
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/arena-favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/arena-favicon.svg">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-theme="<%= user_signed_in? ? current_theme_name : "tranca" %>" class="min-h-screen bg-base-200 text-base-content">
    <div class="min-h-screen theme-background pb-20 lg:pb-0">
      <header class="sticky top-0 z-50 border-b border-base-300/70 bg-base-100/90 backdrop-blur-xl">
        <div class="mx-auto flex w-full max-w-7xl items-center justify-between gap-6 px-4 py-3 sm:px-6 lg:px-8">
          <div class="shrink-0">
            <p class="text-[0.65rem] font-semibold uppercase tracking-[0.35em] text-base-content/50">Portal Tranca</p>
            <%= render "shared/brand", href: tranca_root_path %>
          </div>

          <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegação da Tranca">
            <%= link_to "Início", tranca_root_path, class: "btn btn-ghost btn-sm" %>
            <%= link_to "Classificação", tranca_root_path(anchor: "classificacao"), class: "btn btn-ghost btn-sm" %>
            <%= link_to "Resultados", tranca_root_path(anchor: "resultados"), class: "btn btn-ghost btn-sm" %>
            <%= link_to "Próximos jogos", tranca_root_path(anchor: "proximos-jogos"), class: "btn btn-ghost btn-sm" %>
            <% if @knockout_rounds&.any? %>
              <%= link_to "Mata-mata", tranca_root_path(anchor: "mata-mata"), class: "btn btn-ghost btn-sm" %>
            <% end %>
          </nav>

          <% if user_signed_in? %>
            <div class="flex items-center gap-2">
              <%= render "shared/theme_selector" %>
              <%= button_to "Sair", destroy_user_session_path, method: :delete, form: { class: "inline" }, class: "btn btn-primary btn-sm" %>
            </div>
          <% end %>
        </div>
      </header>

      <main id="content" class="mx-auto flex w-full max-w-7xl flex-1 flex-col gap-6 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
        <%= render "shared/flash" %>
        <%= yield %>
      </main>

      <nav class="fixed inset-x-0 bottom-0 z-50 border-t border-base-300 bg-base-100/95 px-3 py-2 backdrop-blur lg:hidden" aria-label="Navegação móvel da Tranca">
        <div class="mx-auto grid max-w-3xl grid-cols-4 gap-1 text-center text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-base-content/65">
          <%= link_to "Início", tranca_root_path, class: "rounded-xl px-2 py-3 hover:bg-base-200 hover:text-base-content" %>
          <%= link_to "Ranking", tranca_root_path(anchor: "classificacao"), class: "rounded-xl px-2 py-3 hover:bg-base-200 hover:text-base-content" %>
          <%= link_to "Resultados", tranca_root_path(anchor: "resultados"), class: "rounded-xl px-2 py-3 hover:bg-base-200 hover:text-base-content" %>
          <%= link_to "Próximos", tranca_root_path(anchor: "proximos-jogos"), class: "rounded-xl px-2 py-3 hover:bg-base-200 hover:text-base-content" %>
        </div>
      </nav>
    </div>
  </body>
</html>
