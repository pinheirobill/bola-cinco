<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Arena" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Arena">
    <meta name="mobile-web-app-capable" content="yes">
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/arena-favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/arena-favicon.svg">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-theme="<%= current_theme_name %>" class="min-h-screen bg-base-200 text-base-content">
    <div
      class="pointer-events-none fixed right-4 top-4 z-[60] flex w-[min(24rem,calc(100vw-2rem))] flex-col gap-3"
      data-controller="flash-message"
      data-action="clipboard:copied@document->flash-message#show"
    ></div>
    <a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-base-100 focus:px-4 focus:py-2 focus:shadow-lg">Pular para o conteúdo</a>
    <div class="min-h-screen theme-background">
      <div class="navbar relative z-50 border-b border-base-300/60 bg-base-100/80 px-4 backdrop-blur">
        <div class="navbar-start">
          <%= render "shared/brand", href: root_path %>
        </div>

        <div class="navbar-end relative z-50 gap-2">
          <% if user_signed_in? %>
            <%= render "shared/theme_selector" %>
            <span class="badge badge-neutral hidden sm:inline"><%= current_user.role.to_s.humanize %></span>
            <span class="hidden text-sm text-base-content/70 sm:inline"><%= current_user.email %></span>
            <%= button_to "Sair", destroy_user_session_path, method: :delete, form: { class: "inline" }, class: "btn btn-outline btn-sm" %>
          <% else %>
            <%= link_to "Entrar", new_user_session_path, class: "btn btn-primary btn-sm" %>
            <%= link_to "Criar conta", new_user_registration_path, class: "btn btn-ghost btn-sm" %>
          <% end %>
        </div>
      </div>

      <% if devise_controller? %>
        <main class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8">
          <%= render "shared/flash" %>
          <%= yield %>
        </main>
      <% elsif user_signed_in? %>
        <div class="mx-auto grid min-h-[calc(100vh-4rem)] w-full max-w-[1600px] grid-cols-1 gap-6 px-4 py-6 lg:grid-cols-[18rem_minmax(0,1fr)] lg:px-6">
          <aside class="rounded-3xl border border-base-300 bg-base-100 p-4 shadow-xl lg:sticky lg:top-6 lg:h-[calc(100vh-7rem)] lg:overflow-y-auto">
            <%= render "shared/sidebar" %>
          </aside>

          <main id="content" class="flex min-w-0 flex-col gap-6">
            <%= render "shared/flash" %>
            <%= yield %>
          </main>
        </div>
      <% else %>
        <main id="content" class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8">
          <%= render "shared/flash" %>
          <%= yield %>
        </main>
      <% end %>
    </div>
  </body>
</html>
