<% content_for :title, "Portal Tranca | Arena" %>

<section class="overflow-hidden rounded-3xl border border-base-300/70 bg-base-100 shadow-xl">
  <div class="grid gap-6 p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:p-10">
    <div class="flex min-w-0 items-center gap-5">
      <% if @championship&.logo&.attached? %>
        <div class="hidden h-28 w-28 shrink-0 items-center justify-center rounded-2xl bg-white p-3 shadow-sm sm:flex">
          <%= image_tag @championship.logo, alt: "Logo do campeonato", class: "max-h-full max-w-full object-contain" %>
        </div>
      <% end %>

      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <span class="badge badge-primary badge-outline">Tranca</span>
          <span class="badge badge-ghost"><%= @championship&.status.to_s.tr("_", " ").humanize.presence || "Em andamento" %></span>
        </div>
        <h1 class="mt-4 max-w-4xl text-3xl font-black leading-tight text-base-content sm:text-4xl lg:text-5xl">
          <%= @championship&.name || "Campeonato de Tranca" %>
        </h1>
        <p class="mt-3 text-base text-base-content/60">
          <%= @championship&.season %><%= " • #{@current_round}" if @current_round.present? %>
        </p>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-2">
      <div class="rounded-2xl bg-base-200 px-4 py-3">
        <p class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Finalizadas</p>
        <p class="mt-1 text-2xl font-black"><%= @stats[:total_finalizadas] %></p>
      </div>
      <div class="rounded-2xl bg-base-200 px-4 py-3">
        <p class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Próximas</p>
        <p class="mt-1 text-2xl font-black"><%= @upcoming_matches.size %></p>
      </div>
    </div>
  </div>
</section>

<% if @championship_winners.any? %>
  <section class="rounded-3xl border border-primary/30 bg-primary/10 p-6 shadow-sm">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary">Campeão</p>
    <p class="mt-2 text-3xl font-black text-base-content"><%= @championship_winners.map(&:name).to_sentence %></p>
  </section>
<% end %>

<section id="classificacao" class="scroll-mt-28 overflow-hidden rounded-3xl border border-base-300/70 bg-base-100 shadow-lg">
  <div class="flex flex-wrap items-end justify-between gap-3 border-b border-base-300/70 px-5 py-5 sm:px-6">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary">Ranking</p>
      <h2 class="mt-1 text-2xl font-black">Classificação geral</h2>
    </div>
    <p class="text-sm text-base-content/55">Atualizada conforme os resultados registrados</p>
  </div>

  <% if @standings_groups.any? %>
    <div class="divide-y divide-base-300/70">
      <% @standings_groups.each do |group| %>
        <div class="p-4 sm:p-6">
          <% if @standings_groups.size > 1 || group.group_key.present? %>
            <h3 class="mb-3 text-sm font-bold uppercase tracking-wide text-base-content/60">
              <%= [group.category&.name, group.group_key.presence].compact.join(" • ") %>
            </h3>
          <% end %>

          <div class="overflow-x-auto">
            <table class="table table-sm sm:table-md">
              <thead>
                <tr class="text-xs uppercase tracking-wide text-base-content/50">
                  <th class="w-14 text-center">Pos.</th>
                  <th>Dupla</th>
                  <th class="text-center">J</th>
                  <th class="text-center">V</th>
                  <th class="hidden text-center sm:table-cell">PTS Pró</th>
                  <th class="hidden text-center sm:table-cell">PTS Contra</th>
                  <th class="text-center">Saldo</th>
                  <th class="text-right">Pontos</th>
                </tr>
              </thead>
              <tbody>
                <% group.rows.each do |row| %>
                  <tr class="border-base-300/60">
                    <td class="text-center">
                      <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary/10 font-black text-primary"><%= row.posicao %></span>
                    </td>
                    <td class="min-w-48 font-bold"><%= row.dupla %></td>
                    <td class="text-center"><%= row.played %></td>
                    <td class="text-center"><%= row.wins %></td>
                    <td class="hidden text-center sm:table-cell"><%= row.goals_for %></td>
                    <td class="hidden text-center sm:table-cell"><%= row.goals_against %></td>
                    <td class="text-center font-semibold"><%= row.goal_diff.to_i.positive? ? "+#{row.goal_diff}" : row.goal_diff %></td>
                    <td class="text-right text-lg font-black text-primary"><%= row.pontos %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="p-8 text-center text-base-content/60">A classificação será exibida após o registro dos primeiros resultados.</div>
  <% end %>
</section>

<section class="grid gap-6 xl:grid-cols-2">
  <div id="resultados" class="scroll-mt-28 rounded-3xl border border-base-300/70 bg-base-100 p-5 shadow-lg sm:p-6">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary">Últimas partidas</p>
    <h2 class="mt-1 text-2xl font-black">Resultados recentes</h2>

    <% if @recent_results.any? %>
      <div class="mt-5 divide-y divide-base-300/70">
        <% @recent_results.each do |match| %>
          <div class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-3 py-4 first:pt-0 last:pb-0">
            <div>
              <p class="truncate font-semibold"><%= match.dupla_a %></p>
              <p class="mt-1 text-xs text-base-content/50"><%= match.mesa %></p>
            </div>
            <div class="rounded-xl bg-base-200 px-3 py-2 text-center font-black"><%= match.pontos_a %> × <%= match.pontos_b %></div>
            <p class="truncate text-right font-semibold"><%= match.dupla_b %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="mt-5 rounded-2xl bg-base-200 p-5 text-sm text-base-content/60">Nenhum resultado registrado até o momento.</p>
    <% end %>
  </div>

  <div id="proximos-jogos" class="scroll-mt-28 rounded-3xl border border-base-300/70 bg-base-100 p-5 shadow-lg sm:p-6">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary">Agenda</p>
    <h2 class="mt-1 text-2xl font-black">Próximos jogos</h2>

    <% if @upcoming_matches.any? %>
      <div class="mt-5 divide-y divide-base-300/70">
        <% @upcoming_matches.each do |match| %>
          <div class="py-4 first:pt-0 last:pb-0">
            <div class="flex items-center justify-between gap-3">
              <p class="text-xs font-bold uppercase tracking-wide text-base-content/50"><%= match.mesa %></p>
              <span class="badge badge-ghost badge-sm"><%= match.status %></span>
            </div>
            <p class="mt-2 font-semibold"><%= match.dupla_a %> <span class="px-1 text-base-content/40">×</span> <%= match.dupla_b %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="mt-5 rounded-2xl bg-base-200 p-5 text-sm text-base-content/60">Nenhum jogo agendado no momento.</p>
    <% end %>
  </div>
</section>

<% if @knockout_rounds.any? %>
  <section id="mata-mata" class="scroll-mt-28 rounded-3xl border border-base-300/70 bg-base-100 p-5 shadow-lg sm:p-6">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary">Fase eliminatória</p>
    <h2 class="mt-1 text-2xl font-black">Mata-mata</h2>
    <div class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
      <% @knockout_rounds.each do |round| %>
        <div class="rounded-2xl bg-base-200 p-4">
          <p class="text-xs font-bold uppercase tracking-wide text-base-content/50"><%= round.phase_label %></p>
          <div class="mt-2 flex items-center justify-between gap-3">
            <p class="font-bold"><%= round.label %></p>
            <span class="badge badge-outline"><%= round.partidas.size %> partidas</span>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
