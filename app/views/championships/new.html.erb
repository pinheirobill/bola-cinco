<% content_for :title, "Novo campeonato | Arena" %>

<%= page_header(
  title: "Novo campeonato",
  subtitle: "Crie o campeonato e siga para o onboarding completo com dados, formato, inscrições e equipes.",
  badge: "Cadastro",
  actions: [
    link_to("Voltar", championships_path, class: "btn btn-outline")
  ]
) %>

<%= surface_card(title: "Dados iniciais", subtitle: "Preencha o básico para abrir a configuração completa.") do %>
  <% if @championship.errors.any? %>
    <div class="alert alert-error shadow-sm">
      <div>
        <h3 class="font-semibold">Não foi possível criar o campeonato</h3>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
          <% @championship.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <%= form_with model: @championship, url: championships_path, class: "space-y-6" do |form| %>
    <div class="grid gap-4 md:grid-cols-2">
      <div class="form-control gap-2 md:col-span-2">
        <%= form.label :name, "Nome", class: "label-text font-medium" %>
        <%= form.text_field :name, class: "input input-bordered w-full", autofocus: true %>
      </div>

      <div class="form-control gap-2">
        <%= form.label :modality, "Modalidade", class: "label-text font-medium" %>
        <%= form.select :modality, Championship.modality_options, {}, class: "select select-bordered w-full" %>
      </div>

      <div class="form-control gap-2">
        <%= form.label :season, "Temporada", class: "label-text font-medium" %>
        <%= form.number_field :season, class: "input input-bordered w-full" %>
      </div>
    </div>

    <div class="rounded-2xl border border-base-300 bg-base-200 p-4 text-sm text-base-content/70">
      Depois de salvar, você entra direto na configuração completa do campeonato.
    </div>

    <div class="flex flex-wrap gap-3">
      <%= form.submit "Criar e iniciar onboarding", class: "btn btn-primary" %>
      <%= link_to "Cancelar", championships_path, class: "btn btn-outline" %>
    </div>
  <% end %>
<% end %>
