<% content_for :title, "#{@championship.name} | Tranca | Arena" %>

<%= page_header(
  title: @championship.name,
  subtitle: "#{@championship.modality_label} · #{@tranca_round_label}",
  badge: @championship.status.to_s.tr("_", " ").humanize,
  actions: [
    link_to("Portal da Tranca", tranca_root_path, class: "btn btn-outline"),
    link_to("Duplas", duplas_championship_path(@championship), class: "btn btn-outline"),
    link_to("Partidas", partidas_championship_path(@championship), class: "btn btn-outline"),
    link_to("Rodadas", rodadas_championship_path(@championship), class: "btn btn-outline"),
    link_to("Classificação", classificacao_championship_path(@championship), class: "btn btn-primary"),
    (user_signed_in? && @championship.manageable_by?(current_user) ? link_to("Configurar campeonato", setup_championship_path(@championship), class: "btn btn-primary") : nil),
    link_to("Voltar aos campeonatos", championships_path, class: "btn btn-outline")
  ].compact
) %>

<%= stats_grid([
  { label: "Duplas", value: @tranca_total_duplas, description: "Times vinculados ao campeonato" },
  { label: "Rodadas", value: @tranca_total_rodadas, description: "Fases e rodadas cadastradas" },
  { label: "Mão", value: @tranca_stats[:total_maos], description: "Mãos detalhadas registradas" },
  { label: "Mata-mata", value: @tranca_stats[:total_mata_mata], description: "Partidas de chaveamento" },
  { label: "Ao vivo", value: @tranca_live_matches.size, description: "Mesas em andamento" },
  { label: "Classificação", value: @tranca_total_classificados, description: "Linhas exibidas" }
]) %>

<% if @tranca_championship_winners.any? %>
  <%= surface_card(
    title: "Campeão",
    subtitle: "Vencedor do mata-mata",
    classes: "border-warning/30 bg-warning/10"
  ) do %>
    <p class="text-2xl font-black"><%= @tranca_championship_winners.map(&:name).to_sentence %></p>
    <p class="mt-2 text-sm text-base-content/70">O campeonato foi encerrado após a final.</p>
  <% end %>
<% end %>

<% if @tranca_signed_up_dupla.present? %>
  <%= surface_card(
    title: "Sua dupla foi cadastrada",
    subtitle: "Ela já entrou no portal público da Tranca e aparece destacada abaixo.",
    classes: "border-primary/30 bg-primary/5"
  ) do %>
    <div class="grid gap-3 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Dupla</p>
        <p class="mt-2 text-2xl font-black"><%= @tranca_signed_up_dupla.name %></p>
        <p class="mt-1 text-sm text-base-content/60"><%= @tranca_signed_up_dupla.entity.name %></p>
      </div>
      <span class="badge badge-primary badge-lg">Cadastrada</span>
    </div>
  <% end %>
<% end %>

<% if user_signed_in? && @championship.manageable_by?(current_user) %>
  <%= surface_card(
    title: "Administração das duplas",
    subtitle: "Veja quem veio por convite e quem se cadastrou sozinho. O status pode ser alterado direto aqui.",
    classes: "border-base-300/80"
  ) do %>
    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
      <div class="rounded-2xl bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Total</p>
        <p class="mt-2 text-2xl font-black"><%= @tranca_admin_teams.size %></p>
      </div>
      <div class="rounded-2xl bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Convites</p>
        <p class="mt-2 text-2xl font-black"><%= @tranca_admin_teams.count { |team| team.tranca_signup_origin == :invited } %></p>
      </div>
      <div class="rounded-2xl bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Auto cadastro</p>
        <p class="mt-2 text-2xl font-black"><%= @tranca_admin_teams.count { |team| team.tranca_signup_origin == :public_signup } %></p>
      </div>
      <div class="rounded-2xl bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Pendentes</p>
        <p class="mt-2 text-2xl font-black"><%= @tranca_admin_teams.count(&:registration_status_pendente?) %></p>
      </div>
    </div>

    <div class="mt-6 grid gap-3">
      <% @tranca_admin_teams.each do |team| %>
        <div class="rounded-3xl border border-base-300 bg-base-200 p-4">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <p class="truncate text-lg font-semibold"><%= team.name %></p>
                <% if team.tranca_signup_origin_label.present? %>
                  <span class="badge <%= team.tranca_signup_origin_badge_class %>"><%= team.tranca_signup_origin_label %></span>
                <% end %>
              </div>
              <p class="mt-1 text-sm text-base-content/60"><%= team.entity.name %></p>
              <p class="mt-1 text-xs text-base-content/50"><%= team.tranca_signup_origin_detail %></p>
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <span class="badge <%= status_badge_class(team.registration_status) %>"><%= team.registration_status.to_s.humanize %></span>
              <%= link_to "Abrir", team_path(team), class: "btn btn-outline btn-xs" %>
            </div>
          </div>

          <div class="mt-4 grid gap-3 lg:grid-cols-[1fr_auto] lg:items-end">
            <div class="grid gap-2 sm:grid-cols-2">
              <div class="rounded-2xl bg-base-100 p-3">
                <p class="text-xs uppercase tracking-[0.25em] text-base-content/40">Categoria</p>
                <p class="mt-2 text-sm font-semibold"><%= team.category.name %></p>
              </div>
              <div class="rounded-2xl bg-base-100 p-3">
                <p class="text-xs uppercase tracking-[0.25em] text-base-content/40">Origem</p>
                <p class="mt-2 text-sm font-semibold"><%= team.tranca_signup_origin_detail %></p>
              </div>
            </div>

            <div class="rounded-2xl border px-2 py-1 <%= status_surface_class(team.registration_status) %>">
              <%= form_with model: team, url: team_path(team), method: :patch, local: true, class: "flex items-center gap-2", data: { controller: "autosave-form", action: "change->autosave-form#queue turbo:submit-end->autosave-form#complete" } do |f| %>
                <%= f.select :registration_status,
                  options_for_select(Team.registration_statuses.keys.map { |status| [status.titleize, status] }, team.registration_status),
                  {},
                  class: ["select select-bordered select-sm h-8 min-h-8 w-40 bg-base-100", status_select_class(team.registration_status)] %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<section id="duplas" class="space-y-6">
  <%= surface_card(title: "Últimas duplas cadastradas", subtitle: "As três mais recentes ficam em destaque para dar confiança ao participante.") do %>
    <% if @tranca_recent_duplas.any? %>
      <div class="grid gap-3 md:grid-cols-3">
        <% @tranca_recent_duplas.each do |dupla| %>
          <% highlighted = @tranca_signed_up_dupla.present? && dupla.id == @tranca_signed_up_dupla.id %>
          <div class="rounded-3xl border <%= highlighted ? 'border-primary bg-primary/10' : 'border-base-300 bg-base-200' %> p-4">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="font-semibold"><%= dupla.name %></p>
                <p class="mt-1 text-xs text-base-content/60"><%= dupla.entity.name %></p>
              </div>
              <span class="badge <%= highlighted ? 'badge-primary' : 'badge-outline' %>"><%= dupla.registration_status.to_s.humanize %></span>
            </div>
            <p class="mt-3 text-sm text-base-content/70"><%= dupla.category.name %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= empty_state(
        title: "Nenhuma dupla cadastrada",
        description: "As duplas aparecerão aqui quando os times forem vinculados às categorias do campeonato."
      ) %>
    <% end %>
  <% end %>
</section>

<section id="partidas" class="grid gap-6 xl:grid-cols-2">
  <%= surface_card(title: "Ao vivo", subtitle: "Mesas em andamento", classes: "self-start") do %>
    <div class="space-y-4">
      <% if @tranca_live_matches.any? %>
        <% @tranca_live_matches.each do |match| %>
          <%= match_card(match, compact: true) %>
        <% end %>
      <% else %>
        <%= empty_state(
          title: "Sem mesas ao vivo",
          description: "Quando houver partidas em andamento, elas aparecerão aqui."
        ) %>
      <% end %>
    </div>
  <% end %>

  <%= surface_card(title: "Resultados recentes", subtitle: "Últimas mesas concluídas", classes: "self-start") do %>
    <div class="space-y-4">
      <% if @tranca_recent_results.any? %>
        <% @tranca_recent_results.each do |match| %>
          <%= match_card(match, compact: true) %>
        <% end %>
      <% else %>
        <%= empty_state(
          title: "Sem resultados",
          description: "Os resultados concluídos aparecerão aqui."
        ) %>
      <% end %>
    </div>
  <% end %>
</section>

<section id="mata-mata">
  <% if @tranca_knockout_rounds.any? %>
    <%= render "components/tranca_knockout_bracket", rounds: @tranca_knockout_rounds %>
  <% else %>
    <%= surface_card(title: "Chaveamento", subtitle: "Rodadas eliminatórias e vencedores de cada confronto", classes: "self-start") do %>
      <%= empty_state(
        title: "Sem chaveamento",
        description: "Quando a fase eliminatória for gerada, as rodadas aparecem aqui."
      ) %>
    <% end %>
  <% end %>
</section>

<section id="estatisticas" class="grid gap-6 xl:grid-cols-[1fr_0.9fr]">
  <%= surface_card(title: "Classificação", subtitle: "Ranking atual", classes: "self-start") do %>
    <div class="max-h-[32rem] space-y-3 overflow-y-auto pr-2 lg:max-h-[36rem]">
      <% if @tranca_standings.any? %>
        <% @tranca_standings.each do |row| %>
          <div class="flex items-center justify-between gap-4 rounded-2xl bg-base-200 px-4 py-3">
            <div class="flex items-center gap-3">
              <span class="badge badge-primary"><%= row.posicao %></span>
              <div>
                <p class="font-semibold"><%= row.dupla %></p>
                <p class="text-xs text-base-content/60"><%= row.pontos %> pts</p>
              </div>
            </div>
            <p class="text-lg font-black text-primary"><%= row.pontos %></p>
          </div>
        <% end %>
      <% else %>
        <%= empty_state(
          title: "Sem classificação",
          description: "Quando os jogos forem processados, as posições aparecerão aqui."
        ) %>
      <% end %>
    </div>
  <% end %>

  <%= surface_card(title: "Estatísticas", subtitle: "Resumo operacional da Tranca", classes: "self-start") do %>
    <div class="grid gap-3 sm:grid-cols-2">
      <div class="rounded-2xl bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Mãos</p>
        <p class="mt-2 text-2xl font-black"><%= @tranca_stats[:total_maos] %></p>
      </div>
      <div class="rounded-2xl bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Finalizadas</p>
        <p class="mt-2 text-2xl font-black"><%= @tranca_stats[:total_finalizadas] %></p>
      </div>
      <div class="rounded-2xl bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Mata-mata</p>
        <p class="mt-2 text-2xl font-black"><%= @tranca_stats[:total_mata_mata] %></p>
      </div>
      <div class="rounded-2xl bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Líder</p>
        <p class="mt-2 text-lg font-semibold"><%= @tranca_stats[:top_dupla]&.name || "Sem liderança" %></p>
        <p class="text-xs text-base-content/60"><%= @tranca_stats[:top_points] %> pts</p>
      </div>
    </div>
  <% end %>
</section>

<section id="composicao-duplas" class="grid gap-6 xl:grid-cols-2">
  <%= surface_card(title: "Próximos jogos", subtitle: "Mesas agendadas", classes: "self-start") do %>
    <div class="space-y-3">
      <% if @tranca_upcoming_matches.any? %>
        <% @tranca_upcoming_matches.each do |match| %>
          <%= match_card(match, compact: true) %>
        <% end %>
      <% else %>
        <%= empty_state(
          title: "Sem jogos agendados",
          description: "As partidas futuras aparecerão aqui."
        ) %>
      <% end %>
    </div>
  <% end %>
</section>
