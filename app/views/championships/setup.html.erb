<% content_for :title, "#{@championship.name} · Configuração | Arena" %>

<%= page_header(
  title: "Configuração do campeonato",
  subtitle: "#{@championship.name} · #{@championship.modality_label}",
  badge: "Onboarding",
  actions: [
    link_to("Visão geral", championship_path(@championship), class: "btn btn-outline"),
    (@championship.matches.exists? ? link_to("Classificação", standing_rows_path, class: "btn btn-primary") : nil)
  ].compact
) %>

<% step_labels = if @championship.tranca?
  {
    "data" => "Dados",
    "format" => "Base da Tranca",
    "registrations" => "Categorias e equipes",
    "teams" => "Duplas",
    "publish" => "Ativação"
  }
else
  {
    "data" => "Dados",
    "format" => "Formato e regras",
    "registrations" => "Inscrições",
    "teams" => "Equipes",
    "publish" => "Ativação"
  }
end %>

<%= championship_stepper(
  @championship,
  @step,
  step_labels,
  path_helper: :setup_championship_path,
  confirm_forward_navigation: @step == "format" && !@championship.tranca? && @championship.categories.none?
) %>

<% if @step == "data" %>
  <%= form_with url: championship_path(@championship), method: :patch, multipart: true, local: true, class: "space-y-6", data: { controller: "color-preview", action: "input->color-preview#update change->color-preview#update", turbo: false } do %>
    <%= hidden_field_tag :current_step, "data" %>
    <section class="mx-auto grid w-full max-w-7xl items-start gap-6 lg:grid-cols-[1.25fr_1fr]">
    <%= surface_card(title: "Etapa 1. Dados", subtitle: "Defina o calendário do campeonato. Todas as datas são opcionais e podem ser preenchidas depois.") do %>
      <div class="space-y-6">
        <div class="grid gap-6 md:grid-cols-2">
          <section class="space-y-3 rounded-2xl border border-base-300 bg-base-200/50 p-4" aria-labelledby="registration-dates-heading">
            <div>
              <h3 id="registration-dates-heading" class="font-semibold">Período de inscrições</h3>
              <p class="mt-1 text-sm text-base-content/60">Quando os times poderão se inscrever? Opcional.</p>
            </div>
            <div class="form-control gap-2">
              <%= label_tag "championship_registration_start", "Início das inscrições", class: "label-text font-medium" %>
              <%= date_field_tag "championship[registration_start]", @championship.registration_start, id: "championship_registration_start", class: "input input-bordered w-full" %>
            </div>
            <div class="form-control gap-2">
              <%= label_tag "championship_registration_end", "Fim das inscrições", class: "label-text font-medium" %>
              <%= date_field_tag "championship[registration_end]", @championship.registration_end, id: "championship_registration_end", class: "input input-bordered w-full" %>
            </div>
          </section>

          <section class="space-y-3 rounded-2xl border border-base-300 bg-base-200/50 p-4" aria-labelledby="championship-dates-heading">
            <div>
              <h3 id="championship-dates-heading" class="font-semibold">Período do campeonato</h3>
              <p class="mt-1 text-sm text-base-content/60">Quando os jogos devem acontecer? Opcional.</p>
            </div>
            <div class="form-control gap-2">
              <%= label_tag "championship_start_date", "Início do campeonato", class: "label-text font-medium" %>
              <%= date_field_tag "championship[start_date]", @championship.start_date, id: "championship_start_date", class: "input input-bordered w-full" %>
            </div>
            <div class="form-control gap-2">
              <%= label_tag "championship_end_date", "Fim do campeonato", class: "label-text font-medium" %>
              <%= date_field_tag "championship[end_date]", @championship.end_date, id: "championship_end_date", class: "input input-bordered w-full" %>
            </div>
          </section>
        </div>

        <div class="form-control gap-2">
          <%= label_tag "championship_notes", "Regulamento e observações", class: "label-text font-medium" %>
          <%= text_area_tag "championship[notes]", @championship.notes, id: "championship_notes", rows: 4, class: "textarea textarea-bordered w-full", placeholder: "Inclua regras gerais ou informações importantes para as equipes (opcional)." %>
        </div>

      </div>
    <% end %>

    <section id="championship-visual-identity" class="rounded-3xl border border-base-300 bg-base-100 p-5 shadow-sm">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold">Identidade visual</h2>
          <p class="mt-1 text-sm text-base-content/70">Logo e cores do portal público. Opcional.</p>
        </div>
        <% if championship_logo_attached?(@championship) %>
          <span class="badge badge-success">Logo enviada</span>
        <% end %>
      </div>

      <div class="mt-5 border-t border-base-300 pt-5">
        <% if championship_logo_attached?(@championship) %>
          <div class="mb-5 flex items-center gap-4 rounded-2xl bg-base-100 p-4">
            <%= championship_logo_tag(@championship, class: "h-20 w-20 rounded-2xl border border-base-300 bg-white object-contain p-2") %>
            <div class="min-w-0">
              <p class="font-semibold"><%= championship_logo_filename(@championship) %></p>
              <p class="mt-1 text-xs text-base-content/50">Escolha outro arquivo para trocar o logo.</p>
            </div>
          </div>
        <% end %>

        <div class="space-y-5">
          <div class="form-control gap-2">
            <%= label_tag "championship_logo", "Logo do campeonato", class: "label-text font-medium" %>
            <%= file_field_tag "championship[logo]", id: "championship_logo", accept: "image/png,image/jpeg,image/webp", class: "file-input file-input-bordered w-full" %>
            <p class="text-xs text-base-content/60">PNG, JPG ou WEBP. Você também pode adicionar o logo depois.</p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="form-control gap-2">
              <%= label_tag "championship_primary_color", "Cor principal", class: "label-text font-medium" %>
              <%= color_field_tag "championship[primary_color]", @championship.primary_color.presence || "#14532d", id: "championship_primary_color", class: "h-12 w-full cursor-pointer rounded-xl border border-base-300 bg-base-100 p-1", data: { color_preview_target: "primaryInput" } %>
              <p class="text-xs text-base-content/60">Use nos botões e chamadas principais.</p>
            </div>
            <div class="form-control gap-2">
              <%= label_tag "championship_secondary_color", "Cor secundária", class: "label-text font-medium" %>
              <%= color_field_tag "championship[secondary_color]", @championship.secondary_color.presence || "#f4b400", id: "championship_secondary_color", class: "h-12 w-full cursor-pointer rounded-xl border border-base-300 bg-base-100 p-1", data: { color_preview_target: "secondaryInput" } %>
              <p class="text-xs text-base-content/60">Use em destaques e detalhes.</p>
            </div>
          </div>

          <div class="rounded-2xl border border-base-300 bg-base-100 p-4" aria-live="polite">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-base-content/50">Prévia das cores escolhidas</p>
            <div class="grid gap-3 sm:grid-cols-2">
              <div class="rounded-xl border border-base-300 p-3">
                <p class="text-sm font-semibold">Principal</p>
                <div class="mt-2 h-12 rounded-lg border border-base-300" style="background-color: <%= @championship.primary_color.presence || '#14532d' %>" data-color-preview-target="primarySwatch"></div>
                <p class="mt-2 font-mono text-xs text-base-content/60" data-color-preview-target="primaryValue"><%= @championship.primary_color.presence || "#14532d" %></p>
              </div>
              <div class="rounded-xl border border-base-300 p-3">
                <p class="text-sm font-semibold">Secundária</p>
                <div class="mt-2 h-12 rounded-lg border border-base-300" style="background-color: <%= @championship.secondary_color.presence || '#f4b400' %>" data-color-preview-target="secondarySwatch"></div>
                <p class="mt-2 font-mono text-xs text-base-content/60" data-color-preview-target="secondaryValue"><%= @championship.secondary_color.presence || "#f4b400" %></p>
              </div>
            </div>
            <p class="mt-3 text-xs text-base-content/60">A prévia acompanha as cores escolhidas. Salve para aplicá-las ao portal.</p>
          </div>

        </div>
      </div>
    </section>
    </section>
    <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-3 border-t border-base-300 pt-5">
      <p class="text-sm text-base-content/60">Calendário, regulamento e identidade visual serão salvos juntos. As datas são opcionais.</p>
      <%= button_tag "Salvar e ir para Formato", type: "submit", name: "step", value: "format", class: "btn btn-primary" %>
    </div>
  <% end %>
<% elsif @step == "format" %>
  <% selected_mode = @championship.format_data["mode"].to_s %>
  <% mode_explanation = case selected_mode
  when "mata_mata"
    "Não há classificação por pontos. Cada partida elimina ou classifica o time vencedor."
  when "grupos_mata_mata"
    "A fase de grupos usa a tabela de pontos e, ao terminar, o sistema monta o mata-mata automaticamente com os classificados."
  else
    "A classificação é feita por pontos dentro de cada chave, com desempates na ordem configurada abaixo."
  end %>
  <section class="grid gap-6">
    <%= surface_card(title: "Etapa 2. Formato e regras", subtitle: "Configure o modo de disputa, pontuação e critérios de desempate.") do %>
      <%= form_with url: championship_path(@championship), method: :patch, html: { id: "championship-format-mode-form" }, class: "space-y-6", data: { current_mode: @championship.format_data["mode"], controller: "autosave-form competition-mode", action: "input->autosave-form#queue change->autosave-form#queue focusout->autosave-form#queue turbo:submit-end->autosave-form#complete" } do %>
        <%= hidden_field_tag :current_step, "format" %>
        <%= hidden_field_tag :autosave, "1", disabled: true, data: { autosave_form_target: "flag" } %>
        <div class="alert alert-info hidden shadow-sm" role="status" aria-live="polite" data-autosave-form-target="status">Salvando...</div>

        <div class="space-y-6">
          <section class="space-y-4 rounded-3xl border border-base-300 bg-base-200/70 p-5">
            <div>
              <h3 class="text-lg font-semibold">Modo de disputa</h3>
              <p class="mt-1 text-sm text-base-content/70">Escolha a estrutura que define como o campeonato será jogado.</p>
            </div>
            <div class="grid gap-3 lg:grid-cols-3">
              <% [
                ["pontuacao", "Pontuação por chaves", "Cada chave tem tabela de pontos e desempates.", "border-amber-500/20 bg-amber-500/10 text-amber-400", "M4 5H20M4 12H20M4 19H20M8 5V19M16 5V19"],
                ["mata_mata", "Mata-mata eliminatório", "Não usa pontos. Quem perde sai.", "border-rose-500/20 bg-rose-500/10 text-rose-400", "M6 4V20M6 4H12M6 20H12M18 4V20"],
                ["grupos_mata_mata", "Fase de grupos + mata-mata", "Os grupos pontuam normalmente e depois viram mata-mata.", "border-emerald-500/20 bg-emerald-500/10 text-emerald-400", "M4 6H20M4 12H20M4 18H20M8 6V18M16 6V18"]
              ].each do |mode_key, title, description, accent_classes, icon_path| %>
                <button
                  type="submit"
                  name="championship[format][mode]"
                  value="<%= mode_key %>"
                  data-mode-key="<%= mode_key %>"
                  data-competition-mode-target="optionCard"
                  data-action="click->competition-mode#chooseMode"
                  aria-pressed="<%= @championship.format_data["mode"].to_s == mode_key ? "true" : "false" %>"
                  class="flex h-full min-h-[11rem] flex-col justify-between rounded-2xl border border-base-300 bg-base-100 p-4 text-left transition hover:border-primary hover:bg-primary/10">
                    <div class="flex items-start gap-3">
                      <div class="relative shrink-0 rounded-2xl border <%= accent_classes %> p-3">
                        <span data-selected-mark class="<%= @championship.format_data["mode"].to_s == mode_key ? "" : "hidden" %> absolute -right-1 -top-1 flex h-4 w-4 items-center justify-center rounded-full bg-primary text-[9px] font-bold text-primary-content">✓</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                          <path d="<%= icon_path %>"></path>
                        </svg>
                      </div>
                      <div class="min-w-0 flex-1">
                        <p class="font-semibold leading-tight"><%= title %></p>
                        <p class="mt-1 text-sm leading-snug text-base-content/70"><%= description %></p>
                      </div>
                    </div>
                </button>
              <% end %>
            </div>
            <p class="text-xs text-base-content/60">Escolha o formato clicando em um card. O sistema ajusta a pontuação e a classificação de acordo com o modo.</p>
          </section>
        </div>
      <% end %>

      <% format_settings_url = @championship.tranca? ? championship_path(@championship) : create_categories_with_formats_championship_path(@championship) %>
      <% format_settings_method = @championship.tranca? ? :patch : :post %>
      <%= form_with url: format_settings_url, method: format_settings_method, html: { id: "championship-format-settings-form" }, class: "space-y-6", data: { current_mode: @championship.format_data["mode"], controller: "competition-mode" } do %>
        <%= hidden_field_tag :current_step, "format" %>
          <% unless @championship.tranca? %>
            <section class="space-y-4 rounded-3xl border border-primary/30 bg-base-200/70 p-5">
              <div>
                <h3 class="text-lg font-semibold">Formato por categoria</h3>
                <p class="mt-1 text-sm text-base-content/70">Cada categoria pode ter seu próprio formato e número previsto de equipes. A quantidade vinculada precisa bater antes de finalizar as inscrições; categorias sem alterações usam os valores gerais.</p>
              </div>

              <% mastercup_category_suggestions = if @championship.name.to_s.match?(/master\s*cup/i) && @championship.categories.none?
                [
                  { name: "Pré Mirim", team_count: 6, mode: "pontuacao", group_count: 2, schedule: "cross_groups", matches_per_opponent: 1, matches_per_team: 0, qualified_per_group: 1 },
                  { name: "Mirim", team_count: 6, mode: "pontuacao", group_count: 2, schedule: "cross_groups", matches_per_opponent: 1, matches_per_team: 0, qualified_per_group: 1 },
                  { name: "Infantil", team_count: 4, mode: "pontuacao", group_count: 1, schedule: "within_groups", matches_per_opponent: 1, matches_per_team: 0, qualified_per_group: 1 },
                  { name: "Juvenil", team_count: 3, mode: "melhor_campanha_final", group_count: 1, schedule: "within_groups", matches_per_opponent: 1, matches_per_team: 0, qualified_per_group: 1 }
                ]
              else
                [ { name: "", team_count: "", mode: "pontuacao", group_count: 1, schedule: "within_groups", matches_per_opponent: 1, matches_per_team: 0, qualified_per_group: 1 } ]
              end %>

              <% if @championship.categories.exists? %>
                <div class="space-y-4">
                  <% @championship.categories.order(:name).each do |category| %>
                  <% category_format = @championship.format_for(category) %>
                  <div class="grid gap-3 rounded-2xl border border-base-300 bg-base-100 p-4 md:grid-cols-2 xl:grid-cols-3">
                    <div class="flex flex-wrap items-baseline justify-between gap-2 md:col-span-2 xl:col-span-3">
                      <span class="font-semibold"><%= category.name %></span>
                      <span class="text-sm text-base-content/60"><%= pluralize(category.teams.size, "equipe vinculada", "equipes vinculadas") %></span>
                    </div>
                    <div class="form-control gap-2">
                      <%= label_tag "championship_format_categoryFormats_#{category.id}_mode", "Formato", class: "label-text font-medium" %>
                      <%= select_tag "championship[format][categoryFormats][#{category.id}][mode]", options_for_select([["Pontuação por pontos (sem mata-mata)", "pontuacao"], ["Grupos + mata-mata", "grupos_mata_mata"], ["Mata-mata", "mata_mata"], ["Melhor campanha vai direto à final", "melhor_campanha_final"]], category_format["mode"]), class: "select select-bordered w-full" %>
                    </div>
                    <div class="form-control gap-2">
                      <%= label_tag "championship_format_categoryFormats_#{category.id}_teamCount", "Equipes previstas", class: "label-text font-medium" %>
                      <%= number_field_tag "championship[format][categoryFormats][#{category.id}][teamCount]", @championship.team_count_for(category), min: 2, class: "input input-bordered w-full" %>
                      <span class="text-xs text-base-content/60">Atualmente vinculadas: <%= category.teams.size %>.</span>
                    </div>
                    <div class="form-control gap-2">
                      <%= label_tag "championship_format_categoryFormats_#{category.id}_groupCount", "Número de chaves", class: "label-text font-medium" %>
                      <%= number_field_tag "championship[format][categoryFormats][#{category.id}][groupCount]", category_format["groupCount"], min: 1, class: "input input-bordered w-full" %>
                      <span class="text-xs text-base-content/60">Ex.: 2 chaves para 6 equipes.</span>
                    </div>
                    <div class="form-control gap-2">
                      <%= label_tag "championship_format_categoryFormats_#{category.id}_schedule", "Quem enfrenta quem", class: "label-text font-medium" %>
                      <%= select_tag "championship[format][categoryFormats][#{category.id}][schedule]", options_for_select([["Dentro de cada chave", "within_groups"], ["Uma chave contra a outra", "cross_groups"]], category_format["schedule"] || "within_groups"), class: "select select-bordered w-full" %>
                      <span class="text-xs text-base-content/60">Com 1 chave, todos jogam entre si. Com 2, cada equipe enfrenta as da outra chave.</span>
                    </div>
                    <div class="form-control gap-2">
                      <%= label_tag "championship_format_categoryFormats_#{category.id}_matchesPerOpponent", "Jogos contra cada adversário", class: "label-text font-medium" %>
                      <%= number_field_tag "championship[format][categoryFormats][#{category.id}][matchesPerOpponent]", @championship.matches_per_opponent_for(category), min: 1, class: "input input-bordered w-full" %>
                    </div>
                    <div class="form-control gap-2">
                      <%= label_tag "championship_format_categoryFormats_#{category.id}_matchesPerTeam", "Limite de jogos por equipe", class: "label-text font-medium" %>
                      <%= number_field_tag "championship[format][categoryFormats][#{category.id}][matchesPerTeam]", @championship.matches_per_team_for(category), min: 0, class: "input input-bordered w-full" %>
                      <span class="text-xs text-base-content/60">0 = sem limite; todos contra todos usa todos os adversários.</span>
                    </div>
                    <% if category_format["mode"] == "grupos_mata_mata" %>
                      <div class="form-control gap-2">
                        <%= label_tag "championship_format_categoryFormats_#{category.id}_qualifiedPerGroup", "Classificados por chave", class: "label-text font-medium" %>
                        <%= number_field_tag "championship[format][categoryFormats][#{category.id}][qualifiedPerGroup]", category_format["qualifiedPerGroup"] || @championship.qualified_per_group, min: 1, class: "input input-bordered w-full" %>
                      </div>
                    <% end %>
                  </div>
                  <% end %>
                </div>
              <% end %>

              <div class="rounded-2xl border border-base-300 bg-base-100 p-5">
                <h4 class="font-semibold"><%= @championship.categories.exists? ? "Adicionar categorias" : "Crie as categorias e defina as regras" %></h4>
                <% if mastercup_category_suggestions.first[:name].present? %>
                <p class="mt-1 text-sm text-base-content/70">Estas são sugestões editáveis, não obrigatórias. Remova as que não vai usar; as categorias preenchidas serão criadas e vinculadas ao salvar.</p>
                <% else %>
                  <p class="mt-1 text-sm text-base-content/70">Adicione quantas categorias precisar. Cada uma pode ter quantidade de equipes, chaves e formato próprios. Linhas sem nome são ignoradas.</p>
                <% end %>

                <div class="mt-4 space-y-4" data-controller="category-setup" data-category-setup-next-index-value="<%= mastercup_category_suggestions.size %>">
                  <div class="space-y-4" data-category-setup-target="rows">
                    <% mastercup_category_suggestions.each_with_index do |suggestion, index| %>
                      <%= render "category_setup_fields", index: index, suggestion: suggestion %>
                    <% end %>
                  </div>

                  <template data-category-setup-target="template">
                    <%= render "category_setup_fields", index: "NEW_RECORD", suggestion: { name: "", team_count: "", mode: "pontuacao", group_count: 1, schedule: "within_groups", matches_per_opponent: 1, matches_per_team: 0, qualified_per_group: 1 } %>
                  </template>

                  <div class="flex flex-wrap justify-between gap-3">
                    <%= button_tag "Adicionar outra categoria", type: "button", class: "btn btn-outline btn-sm", data: { action: "category-setup#add" } %>
                  </div>
                </div>
              </div>
            </section>
          <% end %>

        <div class="space-y-6">
          <% category_format_overrides = @championship.format_data.fetch("categoryFormats", {}) %>
          <% all_categories_have_specific_rules = @championship.categories.any? && @championship.categories.all? do |category|
            category_rules = category_format_overrides[category.id.to_s].to_h
            %w[mode groupCount matchesPerOpponent matchesPerTeam].all? { |key| category_rules.key?(key) }
          end %>
          <% mastercup_suggestions_visible = @championship.name.to_s.match?(/master\s*cup/i) && @championship.categories.none? %>
          <% default_settings_open = !all_categories_have_specific_rules && !mastercup_suggestions_visible %>

          <details id="championship-default-format-settings" class="group rounded-3xl border border-base-300 bg-base-200/70 p-5" <%= "open" if default_settings_open %>>
            <summary class="flex list-none cursor-pointer items-center justify-between gap-3 [&::-webkit-details-marker]:hidden">
              <span>
                <span class="block text-lg font-semibold">Configuração padrão</span>
                <span class="mt-1 block text-sm text-base-content/70">Usada por categorias sem regras próprias; as regras específicas sempre prevalecem.</span>
              </span>
              <svg class="h-5 w-5 shrink-0 text-base-content/60 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </summary>
            <div class="mt-5 space-y-4">
            <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-5">
              <% unless selected_mode == "mata_mata" %>
                <div class="form-control gap-2">
                  <%= label_tag "championship_format_team_count", "Equipes na estimativa geral", class: "label-text font-medium" %>
                  <%= number_field_tag "championship[format][teamCount]", @championship.format_data["teamCount"], id: "championship_format_team_count", class: "input input-bordered w-full" %>
                  <p class="text-xs text-base-content/60">Não substitui a quantidade prevista em cada categoria.</p>
                </div>
              <% end %>

              <div data-competition-mode-target="groupCountField" class="<%= selected_mode == "mata_mata" ? "hidden" : "" %> form-control gap-2">
                <%= label_tag "championship_format_group_count", "Quantidade de chaves", class: "label-text font-medium" %>
                <%= number_field_tag "championship[format][groupCount]", @championship.format_data["groupCount"], id: "championship_format_group_count", class: "input input-bordered w-full", disabled: selected_mode == "mata_mata" %>
              </div>

              <div data-competition-mode-target="matchesPerOpponentField" class="<%= selected_mode == "mata_mata" ? "hidden" : "" %> form-control gap-2">
                <%= label_tag "championship_format_matches_per_opponent", "Jogos por confronto", class: "label-text font-medium" %>
                <%= number_field_tag "championship[format][matchesPerOpponent]", @championship.format_data["matchesPerOpponent"], id: "championship_format_matches_per_opponent", min: 1, step: 1, class: "input input-bordered w-full", disabled: selected_mode == "mata_mata" %>
                <p class="text-xs text-base-content/60">Ex.: 1 vez na fase classificatória; 2 vezes em ida e volta.</p>
                <% if @championship.format_data["categoryFormats"].present? %>
                  <p class="text-xs text-base-content/60">A estimativa geral não soma regras diferentes por categoria. Use “Equipes previstas” em cada cartão; os jogos serão montados depois de vincular os times.</p>
                <% else %>
                  <p class="text-xs text-base-content/60"><%= @championship.matches_count_explanation %></p>
                <% end %>
              </div>

              <div data-competition-mode-target="matchesPerTeamField" class="<%= selected_mode == "mata_mata" ? "hidden" : "" %> form-control gap-2">
                <%= label_tag "championship_format_matches_per_team", "Jogos por equipe", class: "label-text font-medium" %>
                <%= number_field_tag "championship[format][matchesPerTeam]", @championship.format_data["matchesPerTeam"], id: "championship_format_matches_per_team", min: 0, step: 1, class: "input input-bordered w-full", disabled: selected_mode == "mata_mata" %>
                <p class="text-xs text-base-content/60">Ex.: 4 limita cada equipe a quatro jogos na fase classificatória.</p>
                <p class="text-xs text-base-content/60">Use 0 para manter o todos contra todos completo.</p>
              </div>

              <div data-competition-mode-target="qualifiedField" class="<%= selected_mode == "grupos_mata_mata" ? "" : "hidden" %> form-control gap-2">
                <%= label_tag "championship_scoring_qualified_per_group", "Classificados por chave", class: "label-text font-medium" %>
                <%= number_field_tag "championship[scoring][qualifiedPerGroup]", @championship.scoring_data["qualifiedPerGroup"], id: "championship_scoring_qualified_per_group", class: "input input-bordered w-full", disabled: selected_mode != "grupos_mata_mata" %>
                <p class="text-xs text-base-content/60">Usado somente em fase de grupos + mata-mata. Ex.: 2 faz os dois melhores de cada chave avançarem.</p>
              </div>
            </div>
            </div>
          </details>

          <section class="space-y-4 rounded-3xl border border-base-300 bg-base-200/70 p-5">
            <div>
              <h3 class="text-lg font-semibold">Regras de pontuação</h3>
              <p class="mt-1 text-sm text-base-content/70">A pontuação pode aparecer ou não conforme o modo. Os critérios de desempate ficam compactos abaixo.</p>
            </div>

            <div data-competition-mode-target="pointsFields" class="<%= selected_mode == "mata_mata" ? "hidden" : "" %> grid gap-4 md:grid-cols-2 xl:grid-cols-4">
              <div class="form-control gap-2">
                <%= label_tag "championship_scoring_win", "Vitória", class: "label-text font-medium" %>
                <%= number_field_tag "championship[scoring][win]", @championship.scoring_data["win"], id: "championship_scoring_win", class: "input input-bordered w-full", disabled: selected_mode == "mata_mata" %>
              </div>

              <div class="form-control gap-2">
                <%= label_tag "championship_scoring_draw", "Empate", class: "label-text font-medium" %>
                <%= number_field_tag "championship[scoring][draw]", @championship.scoring_data["draw"], id: "championship_scoring_draw", class: "input input-bordered w-full", disabled: selected_mode == "mata_mata" %>
              </div>

              <div class="form-control gap-2">
                <%= label_tag "championship_scoring_loss", "Derrota", class: "label-text font-medium" %>
                <%= number_field_tag "championship[scoring][loss]", @championship.scoring_data["loss"], id: "championship_scoring_loss", class: "input input-bordered w-full", disabled: selected_mode == "mata_mata" %>
              </div>

              <div class="form-control gap-2">
                <%= label_tag "championship_scoring_wo", "W.O. da equipe ausente", class: "label-text font-medium" %>
                <%= number_field_tag "championship[scoring][wo]", @championship.scoring_data["wo"], id: "championship_scoring_wo", class: "input input-bordered w-full", disabled: selected_mode == "mata_mata" %>
              </div>

              <div class="form-control gap-2 xl:col-span-1">
                <%= label_tag "championship_scoring_woScore", "Placar do W.O.", class: "label-text font-medium" %>
                <%= number_field_tag "championship[scoring][woScore]", @championship.scoring_data["woScore"], id: "championship_scoring_woScore", class: "input input-bordered w-full", disabled: selected_mode == "mata_mata" %>
              </div>
            </div>

            <% unless @championship.tranca? %>
              <div data-competition-mode-target="tiebreakersField" class="<%= selected_mode == "mata_mata" ? "hidden" : "" %>">
                <div class="mb-3 flex items-center justify-between gap-4">
                  <h4 class="font-semibold">Critérios de desempate</h4>
                  <span class="text-sm text-base-content/60">Ordem configurável por campeonato</span>
                </div>
                <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                  <% @championship.tiebreakers.each do |key| %>
                    <label class="flex min-h-[3.25rem] items-center gap-3 rounded-2xl border border-base-300 bg-base-100 px-4 py-3">
                      <%= check_box_tag "championship[scoring][tiebreakers][]", key, true, class: "checkbox checkbox-primary" %>
                      <span class="text-sm leading-snug"><%= Championship::TIEBREAKER_OPTIONS[key] || key.humanize %></span>
                    </label>
                  <% end %>
                </div>
              </div>
            <% end %>
          </section>

          <div class="flex flex-wrap justify-end gap-3">
            <%= link_to "Voltar", setup_championship_path(@championship, step: "data"), class: "btn btn-outline" %>
            <%= button_tag "Salvar e ir para a próxima etapa", type: "submit", name: "step", value: "registrations", class: "btn btn-primary" %>
          </div>
        </div>
      <% end %>
    <% end %>

  </section>
<% elsif @step == "registrations" %>
  <% tranca_setup = @championship.tranca? %>
  <section class="grid gap-6 xl:grid-cols-[1.3fr_1fr]">
    <%= surface_card(
      title: tranca_setup ? "Configurar duplas" : "Configurar inscrições",
      subtitle: tranca_setup ? "Defina os limites e o que os técnicos podem fazer no painel da dupla." : "Defina os limites de atletas e membros da comissão técnica."
    ) do %>
      <%= form_with url: championship_path(@championship), method: :patch, class: "space-y-6", data: { controller: "autosave-form", action: "input->autosave-form#queue change->autosave-form#queue focusout->autosave-form#queue turbo:submit-end->autosave-form#complete" } do %>
        <%= hidden_field_tag :current_step, "registrations" %>
        <%= hidden_field_tag :autosave, "1", disabled: true, data: { autosave_form_target: "flag" } %>
        <div class="alert alert-info hidden shadow-sm" role="status" aria-live="polite" data-autosave-form-target="status">Salvando...</div>

        <div class="grid gap-4 md:grid-cols-2">
          <div class="form-control gap-2">
            <%= label_tag "championship_rules_registration_max_athletes_per_team", tranca_setup ? "Máximo de integrantes por dupla" : "Máximo de atletas por time", class: "label-text font-medium" %>
            <%= number_field_tag "championship[rules][registration][max_athletes_per_team]", @championship.max_athletes_per_team, id: "championship_rules_registration_max_athletes_per_team", class: "input input-bordered w-full" %>
          </div>

          <div class="form-control gap-2">
            <%= label_tag "championship_rules_registration_max_staff_members_per_team", "Máximo de membros na comissão técnica", class: "label-text font-medium" %>
            <%= number_field_tag "championship[rules][registration][max_staff_members_per_team]", @championship.max_staff_members_per_team, id: "championship_rules_registration_max_staff_members_per_team", class: "input input-bordered w-full" %>
          </div>
        </div>

        <% unless tranca_setup %>
          <% %w[allow_register allow_edit allow_remove].each do |key| %>
            <%= hidden_field_tag "championship[rules][registration][athlete_actions][#{key}]", @championship.athlete_action_enabled?(key) ? "1" : "0" %>
          <% end %>
        <% end %>

        <% if tranca_setup %>
          <div class="rounded-3xl border border-base-300 bg-base-200 p-5">
            <h3 class="text-lg font-bold">Inscrições de duplas pelo site do campeonato</h3>
            <p class="mt-1 text-sm text-base-content/70">Quer receber a inscrição de novas duplas no seu campeonato?</p>
            <div class="mt-4">
              <label class="flex items-center gap-3 rounded-2xl border border-base-300 bg-base-100 px-4 py-3">
                <%= hidden_field_tag "championship[rules][registration][team_signups][enabled]", "0" %>
                <%= check_box_tag "championship[rules][registration][team_signups][enabled]", "1", @championship.team_signup_enabled?, class: "checkbox checkbox-primary" %>
                <span>Inscrições abertas</span>
              </label>
            </div>
          </div>
        <% else %>
          <%= hidden_field_tag "championship[rules][registration][team_signups][enabled]", @championship.team_signup_enabled? ? "1" : "0" %>
        <% end %>

        <% unless tranca_setup %>
          <% Championship::REGISTRATION_FORM_FIELDS.each do |field_key, _field_label| %>
            <%= hidden_field_tag "championship[rules][registration][athlete_form][#{field_key}]", @championship.athlete_form_requirement(field_key) %>
          <% end %>

          <div class="rounded-3xl border border-base-300 bg-base-200 p-5">
            <h3 class="text-lg font-bold">Súmula impressa</h3>
            <p class="mt-1 text-sm text-base-content/70">Escolha qual informação do atleta deve aparecer na súmula impressa.</p>
            <div class="mt-4">
              <%= select_tag "championship[rules][registration][printed_summary_field]", options_for_select(Championship::PRINTED_SUMMARY_FIELDS.map { |value, label| [label, value] }, @championship.printed_summary_field), class: "select select-bordered w-full max-w-xs" %>
            </div>
          </div>
        <% end %>

        <div class="flex flex-wrap gap-3">
          <%= button_tag "Voltar", type: "submit", name: "step", value: "format", class: "btn btn-outline" %>
          <%= button_tag "Próxima etapa", type: "submit", name: "step", value: "teams", class: "btn btn-outline" %>
        </div>
      <% end %>
    <% end %>

    <div class="space-y-4">
      <%= surface_card(title: "Resumo rápido") do %>
        <div class="space-y-2 text-sm text-base-content/70">
          <p><%= tranca_setup ? "Integrantes por dupla" : "Atletas por time" %>: <strong><%= @championship.max_athletes_per_team %></strong></p>
          <p>Comissão técnica: <strong><%= @championship.max_staff_members_per_team %></strong></p>
          <% if tranca_setup %>
            <p>Dupla pode se inscrever: <strong><%= @championship.team_signup_enabled? ? "Sim" : "Não" %></strong></p>
          <% end %>
          <% unless tranca_setup %>
            <p>Súmula impressa: <strong><%= Championship::PRINTED_SUMMARY_FIELDS[@championship.printed_summary_field] || @championship.printed_summary_field.humanize %></strong></p>
          <% end %>
        </div>
      <% end %>

    </div>
  </section>
<% elsif @step == "teams" %>
  <section class="grid gap-6 xl:grid-cols-[1.15fr_0.85fr]">
    <% if @championship.tranca? %>
      <%= surface_card(
        title: "Etapa 4. Duplas",
        subtitle: "Deixe esta tela focada só no que ajuda a montar a base da Tranca.",
        actions: [
          (@recent_tranca_source_teams.present? ? button_tag(
            "Selecionar duplas",
            type: "button",
            class: "btn btn-primary btn-sm",
            onclick: "document.getElementById('invite-tranca-duplas-modal').showModal()"
          ) : nil),
          link_to("Próxima etapa", setup_championship_path(@championship, step: "publish"), class: "btn btn-outline btn-sm")
        ].compact
      ) do %>
        <% tranca_category = @tranca_onboarding_category || @championship.ensure_tranca_onboarding_category! %>
        <div class="grid gap-4 md:grid-cols-2">
          <div class="rounded-3xl border border-base-300 bg-base-200 p-4">
            <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Categoria padrão</p>
            <p class="mt-2 text-2xl font-bold"><%= tranca_category.name %></p>
            <p class="mt-1 text-sm text-base-content/70"><%= tranca_category.teams.size %> duplas vinculadas</p>
          </div>

          <div class="rounded-3xl border border-base-300 bg-base-200 p-4">
            <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Histórico recente</p>
            <% if @recent_tranca_championships.present? %>
              <div class="mt-2 flex flex-wrap gap-2">
                <% @recent_tranca_championships.each do |championship| %>
                  <span class="badge badge-outline"><%= championship.name %> · <%= championship.season %></span>
                <% end %>
              </div>
            <% else %>
              <p class="mt-2 text-sm text-base-content/70">Nenhum campeonato anterior de Tranca foi encontrado.</p>
            <% end %>
          </div>
        </div>
      <% end %>

      <%= surface_card(
        title: "Duplas vinculadas",
        subtitle: "A lista abaixo mostra o que já está pronto para a categoria padrão."
      ) do %>
        <% if @championship_categories.any? %>
          <div class="space-y-3">
            <% @championship_categories.each do |category| %>
              <div class="rounded-3xl border border-base-300 bg-base-200 p-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <div>
                    <h3 class="text-lg font-bold"><%= category.name %></h3>
                    <p class="text-sm text-base-content/70"><%= category.teams.size %> duplas · <%= category.championships.size %> campeonato<%= "s" if category.championships.size != 1 %></p>
                  </div>
                  <%= link_to "Ver categoria", category_path(category), class: "btn btn-ghost btn-sm" %>
                </div>

                <% if category.teams.any? %>
                  <div class="mt-4 space-y-2">
                    <% category.teams.each do |team| %>
                      <%= team_card(team, compact: true) %>
                    <% end %>
                  </div>
                <% else %>
                  <p class="mt-4 text-sm text-base-content/60">Nenhuma dupla vinculada ainda.</p>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <%= empty_state(
            title: "Nenhuma categoria vinculada",
            description: "Abra o modal para conectar categorias e depois vincular as duplas."
          ) %>
        <% end %>
      <% end %>
    <% else %>
      <%= surface_card(
        title: "Etapa 4. Equipes",
        subtitle: "Vincule as categorias e equipes já existentes sem abrir outros blocos desnecessários.",
        actions: [
          button_tag("Configurar categorias", type: "button", class: "btn btn-outline btn-sm", onclick: "document.getElementById('categories-modal').showModal()"),
          button_tag("Vincular equipes", type: "button", class: "btn btn-outline btn-sm", onclick: "document.getElementById('teams-modal').showModal()"),
          link_to("Próxima etapa", setup_championship_path(@championship, step: "publish"), class: "btn btn-primary btn-sm")
        ]
      ) do %>
        <div class="space-y-4">
          <div class="rounded-3xl border border-base-300 bg-base-200 p-4">
            <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Categorias vinculadas</p>
            <p class="mt-2 text-2xl font-bold"><%= @championship.categories.size %></p>
            <p class="mt-1 text-sm text-base-content/70">Uma categoria pode aparecer em vários campeonatos.</p>
          </div>

          <% @championship_categories.each do |category| %>
            <div class="rounded-3xl border border-base-300 bg-base-200 p-4">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <h3 class="text-lg font-bold"><%= category.name %></h3>
                  <p class="text-sm text-base-content/70"><%= category.teams.size %> equipes · <%= category.championships.size %> campeonato<%= "s" if category.championships.size != 1 %></p>
                </div>
                <%= link_to "Ver categoria", category_path(category), class: "btn btn-ghost btn-sm" %>
              </div>

              <div class="mt-4 space-y-3">
                <% category.teams.each do |team| %>
                  <%= team_card(team, compact: true) %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= surface_card(title: "Sorteio inicial", subtitle: "Use essa etapa só se o campeonato for mata-mata.") do %>
        <% if @championship.format_data["mode"].to_s == "mata_mata" %>
          <% initial_knockout_matches = Array(@initial_knockout_matches) %>
          <% if initial_knockout_matches.any? %>
            <p class="text-sm text-base-content/70">A primeira rodada já foi gerada.</p>
            <div class="mt-4 space-y-3">
              <% initial_knockout_matches.group_by(&:category).each do |category, matches| %>
                <div class="rounded-2xl bg-base-200 p-4">
                  <div class="flex items-center justify-between gap-3">
                    <div>
                      <p class="font-semibold"><%= category.name %></p>
                      <p class="text-xs text-base-content/60"><%= matches.size %> jogos</p>
                    </div>
                    <span class="badge badge-neutral">Rodada 1</span>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-base-content/70">Gere a primeira rodada para fechar o fluxo de setup.</p>
            <%= button_to "Sortear 1ª rodada", draw_knockout_round_championship_path(@championship), method: :post, class: "btn btn-primary mt-4" %>
          <% end %>
        <% else %>
          <p class="text-sm text-base-content/70">Esse bloco fica desativado em formatos que usam pontuação.</p>
        <% end %>
      <% end %>
    <% end %>

    <dialog id="invite-tranca-duplas-modal" class="modal">
      <div class="modal-box max-w-4xl">
        <h3 class="text-lg font-bold">Selecionar duplas para convidar</h3>
        <p class="mt-1 text-sm text-base-content/70">
          Marque as duplas ativas dos campeonatos recentes que você quer copiar para a categoria padrão deste campeonato.
        </p>

        <%= form_with url: invite_recent_tranca_duplas_championship_path(@championship), method: :post, class: "mt-6 space-y-4", data: { controller: "invite-tranca-duplas" } do %>
          <% if @recent_tranca_championships.present? %>
            <div class="space-y-4">
              <% @recent_tranca_championships.each do |source_championship| %>
                <% championship_teams = @recent_tranca_source_teams.select { |team| team.source_championship == source_championship } %>
                <% next if championship_teams.empty? %>
                <div class="rounded-3xl border border-base-300 bg-base-200 p-4" data-tranca-duplas-group>
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                      <h4 class="text-base font-semibold"><%= source_championship.name %></h4>
                      <p class="text-xs text-base-content/60"><%= source_championship.season %> · <%= championship_teams.size %> duplas</p>
                    </div>
                    <div class="flex items-center gap-2">
                      <% if championship_teams.any? %>
                        <button type="button" class="btn btn-outline btn-xs" data-action="click->invite-tranca-duplas#toggleAll">Selecionar todas</button>
                      <% end %>
                      <span class="badge badge-outline"><%= championship_teams.size %></span>
                    </div>
                  </div>

                  <div class="mt-4 grid gap-3 md:grid-cols-2">
                    <% championship_teams.each do |team| %>
                      <label class="flex items-start gap-3 rounded-2xl border border-base-300 bg-base-100 px-4 py-3">
                        <%= check_box_tag "team_ids[]", team.id, false, class: "checkbox checkbox-primary mt-1", data: { invite_tranca_duplas_target: "checkbox" } %>
                        <div class="min-w-0">
                          <p class="font-medium"><%= team.name %></p>
                          <p class="text-xs text-base-content/60"><%= team.source_category.name %> · <%= team.entity&.name || "Sem entidade" %></p>
                        </div>
                      </label>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="rounded-3xl border border-dashed border-base-300 bg-base-200 p-4 text-sm text-base-content/70">
              Nenhuma dupla recente disponível para seleção.
            </div>
          <% end %>

          <div class="flex flex-wrap justify-end gap-3 pt-2">
            <button type="button" class="btn btn-ghost" onclick="document.getElementById('invite-tranca-duplas-modal').close()">Cancelar</button>
            <%= submit_tag "Convidar selecionadas", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>

  </section>

<% elsif @step == "publish" %>
  <% team_signup_public_url = "#{request.base_url}#{new_championship_team_signup_path(@championship)}" %>
  <section class="grid gap-6 xl:grid-cols-[1.1fr_0.9fr]">
    <%= surface_card(
      title: "Etapa 5. Ativação e link público",
      subtitle: "Conclua o onboarding, copie o link público e acompanhe quantas entradas ele recebeu."
    ) do %>
      <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-3xl bg-base-200 p-4">
          <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Status</p>
          <p class="mt-2 text-lg font-semibold"><%= @championship.status.titleize %></p>
        </div>
        <div class="rounded-3xl bg-base-200 p-4">
          <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Entradas no link</p>
          <p class="mt-2 text-3xl font-black"><%= @championship.public_signup_visits_total %></p>
        </div>
        <div class="rounded-3xl bg-base-200 p-4">
          <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Inscrições</p>
          <p class="mt-2 text-lg font-semibold"><%= @championship.team_signup_open? ? "Abertas" : "Fechadas" %></p>
        </div>
      </div>

      <div class="mt-5 flex flex-wrap gap-3">
        <% if @championship.rascunho? && @championship.manageable_by?(current_user) %>
          <%= button_to "Ativar campeonato",
            finalize_onboarding_championship_path(@championship),
            method: :patch,
            class: "btn btn-primary",
            data: { turbo_confirm: "Ativar este campeonato agora?" } %>
        <% end %>
        <%= link_to "Ver campeonato", championship_path(@championship), class: "btn btn-outline" %>
      </div>

      <% if @championship.team_signup_open? %>
        <div class="mt-6 rounded-3xl border border-base-300 bg-base-200 p-4">
          <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Link público</p>
          <div class="mt-2 rounded-2xl bg-base-100 p-4 font-mono text-xs break-all">
            <%= team_signup_public_url %>
          </div>
          <div class="mt-4 flex flex-wrap gap-3">
            <button
              class="btn btn-primary btn-sm"
              type="button"
              data-controller="clipboard"
              data-action="click->clipboard#copy"
              data-clipboard-value="<%= team_signup_public_url %>">
              Copiar link
            </button>
            <%= link_to "Abrir link", new_championship_team_signup_path(@championship), target: "_blank", rel: "noreferrer", class: "btn btn-outline btn-sm" %>
          </div>
        </div>
      <% else %>
        <div class="mt-6 rounded-3xl border border-dashed border-base-300 bg-base-200 p-4 text-sm text-base-content/70">
          Abra as inscrições para exibir o link público.
        </div>
      <% end %>
    <% end %>

    <%= surface_card(
      title: "Resumo da publicação",
      subtitle: "Sinais rápidos para saber se o campeonato já pode ser divulgado."
    ) do %>
      <div class="space-y-3 text-sm text-base-content/70">
        <p>Status atual: <strong><%= @championship.status.titleize %></strong></p>
        <p>Link público: <strong><%= @championship.team_signup_open? ? "Disponível" : "Não exibido" %></strong></p>
        <p>Entradas registradas: <strong><%= @championship.public_signup_visits_total %></strong></p>
        <p>Campeonato ativo no sistema: <strong><%= @championship.publicly_visible? ? "Sim" : "Não" %></strong></p>
      </div>
    <% end %>
  </section>

<% end %>

  <dialog id="categories-modal" class="modal">
    <div class="modal-box max-w-6xl">
      <h3 class="text-lg font-bold">Vincular categorias</h3>
      <p class="mt-1 text-sm text-base-content/70">Escolha categorias já cadastradas e associe ao campeonato. Uma categoria pode ser usada em vários campeonatos ao mesmo tempo.</p>

      <div class="mt-6 grid gap-6 lg:grid-cols-2">
        <div class="space-y-3">
          <h4 class="font-semibold">Vinculadas</h4>
          <% if @championship_categories.any? %>
            <% @championship_categories.each do |category| %>
              <div class="rounded-2xl bg-base-200 p-4">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <p class="font-medium"><%= category.name %></p>
                    <p class="text-xs text-base-content/60"><%= category.gender.present? ? category.gender.titleize : "Sem gênero definido" %> · <%= category.teams.size %> equipes · <%= category.championships.size %> campeonatos</p>
                  </div>
                  <div class="flex flex-col gap-2 sm:flex-row">
                    <%= button_tag "Duplicar", type: "button", class: "btn btn-outline btn-sm", data: { duplicate_url: duplicate_category_path(category), category_name: category.name }, onclick: "window.BolaCinco.openCategoryDuplicateModal(this.dataset.duplicateUrl, this.dataset.categoryName)" %>
                    <%= button_to "Remover", detach_category_championship_path(@championship, category_id: category.id), method: :patch, class: "btn btn-outline btn-sm btn-error" %>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-base-content/60">Nenhuma categoria vinculada ainda.</p>
          <% end %>
        </div>

        <div class="space-y-3">
          <h4 class="font-semibold">Disponíveis</h4>
          <div class="rounded-2xl border border-primary/30 bg-primary/5 p-4">
            <p class="font-medium">Precisa criar uma categoria nova?</p>
            <p class="mt-1 text-xs text-base-content/60">Crie e configure o formato dela na etapa 2, sem precisar escolher uma categoria de outro campeonato.</p>
            <%= link_to "Criar categoria e definir formato", setup_championship_path(@championship, step: "format"), class: "btn btn-primary btn-sm mt-3" %>
          </div>
          <% if @available_categories_to_link.any? %>
            <% @available_categories_to_link.each do |category| %>
              <% highlighted = @highlight_category_id.present? && category.id == @highlight_category_id %>
              <div class="<%= highlighted ? 'border border-accent/40 bg-accent/10' : 'bg-base-200' %> rounded-2xl p-4">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <p class="font-medium"><%= category.name %></p>
                      <% if highlighted %>
                        <span class="badge badge-accent badge-outline badge-sm gap-1"><span aria-hidden="true">✦</span>Novo</span>
                      <% end %>
                    </div>
                    <p class="text-xs text-base-content/60"><%= category.gender.present? ? category.gender.titleize : "Sem gênero definido" %> · <%= category.teams.size %> equipes · <%= category.championships.size %> campeonatos</p>
                  </div>
                  <div class="flex flex-col gap-2 sm:flex-row">
                    <%= button_tag "Duplicar", type: "button", class: "btn btn-outline btn-sm", data: { duplicate_url: duplicate_category_path(category), category_name: category.name }, onclick: "window.BolaCinco.openCategoryDuplicateModal(this.dataset.duplicateUrl, this.dataset.categoryName)" %>
                    <%= button_to "Vincular", attach_category_championship_path(@championship), method: :patch, params: { category_id: category.id }, class: "btn btn-primary btn-sm" %>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-base-content/60">Não há mais categorias disponíveis para vincular.</p>
          <% end %>
        </div>
      </div>

      <div class="mt-6 flex justify-end">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('categories-modal').close()">Fechar</button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>

  <dialog id="duplicate-category-modal" class="modal">
    <div class="modal-box max-w-xl">
      <h3 class="text-lg font-bold">Duplicar categoria</h3>
      <p class="mt-1 text-sm text-base-content/70">
        Defina o novo nome para a cópia de <span id="duplicate-category-source" class="font-semibold">categoria</span>. A duplicata ficará disponível para vinculação, sem entrar automaticamente no campeonato.
      </p>

      <%= form_with url: "#", method: :post, html: { id: "duplicate-category-form", class: "mt-6 space-y-4" } do %>
        <%= hidden_field_tag :from_modal, "categories" %>

        <div class="form-control gap-2">
          <%= label_tag :name, "Novo nome", class: "label-text font-medium" %>
          <%= text_field_tag :name, nil, id: "duplicate-category-name", class: "input input-bordered w-full", placeholder: "Ex.: 11º TORNEIO DE TRACA E.C. PINHEIROS 2026 - cópia" %>
        </div>

        <div class="flex flex-wrap justify-end gap-3">
          <button type="button" class="btn btn-ghost" onclick="document.getElementById('duplicate-category-modal').close()">Cancelar</button>
          <%= submit_tag "Criar duplicata", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>

  <dialog id="teams-modal" class="modal">
    <div class="modal-box max-w-5xl">
      <h3 class="text-lg font-bold">Vincular equipes</h3>
      <p class="mt-1 text-sm text-base-content/70">Escolha uma equipe já cadastrada e associe a uma categoria do campeonato. Se não quiser selecionar nenhuma agora, pode fechar.</p>

      <div class="mt-6 grid gap-6 lg:grid-cols-2">
        <div class="space-y-3">
          <h4 class="font-semibold">Equipes vinculadas</h4>
          <% if @championship_categories.any? && @championship_categories.any? { |category| category.teams.any? } %>
            <% @championship_categories.each do |category| %>
              <% next if category.teams.blank? %>
              <div class="rounded-2xl bg-base-200 p-4">
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <p class="font-medium"><%= category.name %></p>
                    <p class="text-xs text-base-content/60"><%= category.teams.size %> equipes</p>
                  </div>
                </div>
                <div class="mt-3 space-y-2">
                  <% category.teams.each do |team| %>
                    <div class="flex items-center justify-between gap-3 rounded-2xl bg-base-100 px-4 py-3">
                      <div>
                        <p class="font-medium"><%= team.name %></p>
                        <p class="text-xs text-base-content/60"><%= team.entity&.name.presence || "Sem entidade" %></p>
                      </div>
                      <%= link_to "Abrir", team_path(team), class: "link link-primary" %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-base-content/60">Nenhuma equipe vinculada ainda.</p>
          <% end %>
        </div>

        <div class="space-y-3">
          <%= form_with url: attach_team_championship_path(@championship), method: :patch, class: "space-y-4" do %>
            <div class="flex items-center justify-between gap-4">
              <h4 class="font-semibold">Disponíveis para vincular</h4>
              <p class="text-xs text-base-content/60"><%= @available_teams_to_link.size %> equipes disponíveis</p>
            </div>

            <% if @available_teams_to_link.any? %>
              <div class="grid gap-3 md:grid-cols-[1fr_auto]">
                <div class="form-control gap-2">
                  <%= label_tag :category_id, "Categoria destino", class: "label-text font-medium" %>
                  <%= select_tag :category_id,
                        options_from_collection_for_select(@championship_categories, :id, :name, @championship_categories.first&.id),
                        class: "select select-bordered w-full" %>
                </div>
                <div class="flex items-end">
                  <%= submit_tag "Vincular selecionadas", class: "btn btn-primary" %>
                </div>
              </div>

              <div class="overflow-x-auto rounded-2xl bg-base-200">
                <table class="table">
                  <thead>
                    <tr>
                      <th class="w-12"></th>
                      <th>Equipe</th>
                      <th>Contexto</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @available_teams_to_link.each do |team| %>
                      <tr>
                        <td>
                          <%= check_box_tag "team_ids[]", team.id, false, id: "team_ids_#{team.id}", class: "checkbox checkbox-primary" %>
                        </td>
                        <td>
                          <%= label_tag "team_ids_#{team.id}", class: "cursor-pointer" do %>
                            <p class="font-medium"><%= team.name %></p>
                            <p class="text-xs text-base-content/60">Selecione para vincular</p>
                          <% end %>
                        </td>
                        <td class="text-sm text-base-content/70">
                          <%= [team.entity&.name, team.category&.name].compact.join(" · ").presence || "Sem contexto" %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <p class="text-sm text-base-content/60">Nenhuma equipe disponível para vincular.</p>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="mt-6 flex justify-end">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('teams-modal').close()">Fechar</button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>

  <dialog id="venues-modal" class="modal">
    <div class="modal-box max-w-4xl">
      <h3 class="text-lg font-bold">Gerenciar campos</h3>
      <p class="mt-1 text-sm text-base-content/70">Vincule campos já criados ao campeonato ou remova os vinculados.</p>

      <div class="mt-6 grid gap-6 lg:grid-cols-2">
        <div class="space-y-3">
          <h4 class="font-semibold">Vinculados</h4>
          <% if @venues.any? %>
            <% @venues.each do |venue| %>
              <div class="flex items-center justify-between rounded-2xl bg-base-200 px-4 py-3">
                <div>
                  <p class="font-medium"><%= venue.name %></p>
                  <p class="text-xs text-base-content/60"><%= venue.city.presence || "Sem cidade" %></p>
                </div>
                <%= button_to "Remover", detach_venue_path(venue), method: :patch, params: { championship_id: @championship.id }, class: "btn btn-outline btn-sm btn-error" %>
              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-base-content/60">Nenhum campo vinculado.</p>
          <% end %>
        </div>

        <div class="space-y-3">
          <h4 class="font-semibold">Disponíveis</h4>
          <% if @available_venues.any? %>
            <% @available_venues.each do |venue| %>
              <div class="flex items-center justify-between rounded-2xl bg-base-200 px-4 py-3">
                <div>
                  <p class="font-medium"><%= venue.name %></p>
                  <p class="text-xs text-base-content/60"><%= venue.city.presence || "Sem cidade" %></p>
                </div>
                <%= button_to "Vincular", attach_venue_path(venue), method: :patch, params: { championship_id: @championship.id }, class: "btn btn-outline btn-sm" %>
              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-base-content/60">Nenhum campo disponível para vincular.</p>
          <% end %>
        </div>
      </div>

      <div class="mt-6 flex justify-end">
        <button type="button" class="btn btn-ghost" onclick="console.debug('[dialog] close venues-modal'); document.getElementById('venues-modal')?.close()">Fechar</button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>

  <dialog id="referees-modal" class="modal">
    <div class="modal-box max-w-4xl">
      <h3 class="text-lg font-bold">Gerenciar árbitros</h3>
      <p class="mt-1 text-sm text-base-content/70">Vincule árbitros já cadastrados ao campeonato ou remova os vinculados.</p>

      <div class="mt-6 grid gap-6 lg:grid-cols-2">
        <div class="space-y-3">
          <h4 class="font-semibold">Vinculados</h4>
          <% if @referees.any? %>
            <% @referees.each do |referee| %>
              <div class="flex items-center justify-between rounded-2xl bg-base-200 px-4 py-3">
                <div>
                  <p class="font-medium"><%= referee.name %></p>
                  <p class="text-xs text-base-content/60"><%= referee.email.presence || "Sem contato" %></p>
                </div>
                <%= button_to "Remover", detach_referee_path(referee), method: :patch, params: { championship_id: @championship.id }, class: "btn btn-outline btn-sm btn-error" %>
              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-base-content/60">Nenhum árbitro vinculado.</p>
          <% end %>
        </div>

        <div class="space-y-3">
          <h4 class="font-semibold">Disponíveis</h4>
          <% if @available_referees.any? %>
            <% @available_referees.each do |referee| %>
              <div class="flex items-center justify-between rounded-2xl bg-base-200 px-4 py-3">
                <div>
                  <p class="font-medium"><%= referee.name %></p>
                  <p class="text-xs text-base-content/60"><%= referee.email.presence || "Sem contato" %></p>
                </div>
                <%= button_to "Vincular", attach_referee_path(referee), method: :patch, params: { championship_id: @championship.id }, class: "btn btn-outline btn-sm" %>
              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-base-content/60">Nenhum árbitro disponível para vincular.</p>
          <% end %>
        </div>
      </div>

      <div class="mt-6 flex justify-end">
        <button type="button" class="btn btn-ghost" onclick="console.debug('[dialog] close referees-modal'); document.getElementById('referees-modal')?.close()">Fechar</button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>
