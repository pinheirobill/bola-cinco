<% content_for :title, "#{@championship.name} | Rodadas | Arena" %>

<%= page_header(
  title: "#{@championship.name} · Rodadas",
  subtitle: "Estrutura das rodadas e fases da Tranca.",
  badge: @championship.status.to_s.tr("_", " ").humanize,
  actions: [
    link_to("Início", championship_path(@championship), class: "btn btn-outline"),
    link_to("Duplas", duplas_championship_path(@championship), class: "btn btn-outline"),
    link_to("Partidas", partidas_championship_path(@championship), class: "btn btn-outline"),
    link_to("Programação", programacao_championship_path(@championship), class: "btn btn-primary"),
    link_to("Classificação", classificacao_championship_path(@championship), class: "btn btn-primary")
  ]
) %>

<%= stats_grid([
  { label: "Rodadas", value: @tranca_total_rodadas, value_class: "text-2xl" },
  { label: "Fases", value: @tranca_rodadas.map(&:phase).uniq.size, value_class: "text-2xl" },
  { label: "Partidas", value: @tranca_total_partidas, value_class: "text-2xl" },
  { label: "Duplas", value: @tranca_total_duplas, value_class: "text-2xl" }
]) %>

<% if user_signed_in? && @championship.manageable_by?(current_user) %>
  <% ultima_rodada_classificatoria = @tranca_rodadas.select { |round| round.first_stage? && round.classificatoria? }.max_by(&:round_number) %>
  <% todos_jogos_agendados = ultima_rodada_classificatoria&.partidas&.any? && ultima_rodada_classificatoria.partidas.all?(&:status_agendado?) %>
  <% classificatoria_esgotada = @tranca_classificatoria_esgotada %>
  <% mata_mata_encerrado = @tranca_mata_mata_encerrado %>
  <%= surface_card(title: "Gerar rodada", subtitle: "Cria a rodada e as partidas da Tranca a partir das duplas cadastradas.") do %>
    <div class="grid gap-4 lg:grid-cols-3">
      <%= form_with url: generate_tranca_round_championship_path(@championship), method: :post, class: "rounded-3xl border border-base-300 bg-base-100 p-4 text-left hover:border-primary/40" do %>
        <%= hidden_field_tag :phase, "classificatoria" %>
        <%= hidden_field_tag :round_number, @tranca_next_round_number %>
        <%= button_tag type: :submit, disabled: classificatoria_esgotada, class: "block w-full text-left disabled:cursor-not-allowed disabled:opacity-60" do %>
          <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Classificatória</p>
          <p class="mt-2 text-lg font-semibold"><%= classificatoria_esgotada ? "Sorteio encerrado" : (todos_jogos_agendados ? "Sortear novos jogos" : "Gerar próxima rodada") %></p>
          <p class="mt-1 text-sm text-base-content/70"><%= classificatoria_esgotada ? "Não há mais confrontos diferentes: todas as duplas já jogaram entre si." : (todos_jogos_agendados ? "Todos os jogos da última rodada estão agendados. Sorteie os próximos confrontos." : "Usa a próxima numeração disponível na fase classificatória.") %></p>
        <% end %>
      <% end %>

      <div class="rounded-3xl border border-base-300 bg-base-100 p-4 text-left hover:border-primary/40">
        <button
          type="button"
          <%= "disabled" if mata_mata_encerrado %>
          class="block w-full text-left disabled:cursor-not-allowed disabled:opacity-60"
          onclick="document.getElementById('tranca-knockout-config-modal').showModal()"
        >
          <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Mata-mata</p>
          <p class="mt-2 text-lg font-semibold"><%= mata_mata_encerrado ? "Mata-mata encerrado" : "Configurar chave eliminatória" %></p>
          <p class="mt-1 text-sm text-base-content/70"><%= mata_mata_encerrado ? "A final já foi concluída." : "Abre a próxima rodada do chaveamento com os vencedores anteriores." %></p>
        </button>
      </div>

      <div class="rounded-3xl border border-base-300 bg-base-100 p-4 text-left hover:border-primary/40">
        <button
          type="button"
          <%= "disabled" if @tranca_second_stage_created || @tranca_second_stage_candidates.size < 16 %>
          class="block w-full text-left disabled:cursor-not-allowed disabled:opacity-60"
          onclick="document.getElementById('tranca-second-stage-modal').showModal()"
        >
          <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">2ª etapa</p>
          <p class="mt-2 text-lg font-semibold"><%= @tranca_second_stage_created ? "2ª etapa criada" : "Montar quatro chaves" %></p>
          <p class="mt-1 text-sm text-base-content/70">
            <% if @tranca_second_stage_created %>
              As três rodadas e os 24 jogos já foram gerados.
            <% elsif @tranca_second_stage_candidates.size < 16 %>
              São necessárias pelo menos 16 duplas para montar esta etapa.
            <% else %>
              Escolha 16 duplas e defina manualmente as posições das chaves A, B, C e D.
            <% end %>
          </p>
        </button>
      </div>
    </div>
  <% end %>

  <dialog id="tranca-second-stage-modal" class="modal">
    <div class="modal-box max-w-7xl" data-controller="second-stage-builder">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs uppercase tracking-[0.28em] text-base-content/50">Configuração da 2ª etapa</p>
          <h3 class="mt-1 text-2xl font-black">Distribuir as duplas nas chaves</h3>
          <p class="mt-1 text-sm text-base-content/70">Cada chave deve ter quatro duplas. Você pode criar novas chaves e reorganizar as duplas antes de gerar a etapa.</p>
        </div>
        <button type="button" class="btn btn-ghost btn-sm" onclick="document.getElementById('tranca-second-stage-modal').close()">Fechar</button>
      </div>

      <div class="mt-5 flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-base-200 p-3">
        <p class="text-sm text-base-content/70">Cada chave gera três rodadas e duas partidas por rodada.</p>
        <span class="badge badge-primary" data-second-stage-builder-target="counter">0 duplas selecionadas</span>
      </div>

      <%= form_with url: create_tranca_second_stage_championship_path(@championship), method: :post, class: "mt-5 space-y-5" do %>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4" data-second-stage-builder-target="groups">
          <% %w[A B C D].each_with_index do |group_key, group_index| %>
            <section class="rounded-3xl border border-base-300 bg-base-200/70 p-4">
              <div class="flex items-center justify-between gap-3">
                <h4 class="font-bold">Chave <%= group_key %></h4>
                <span class="badge badge-outline badge-sm">Mesas <%= (group_index * 2) + 1 %> e <%= (group_index * 2) + 2 %></span>
                <button type="button" class="btn btn-ghost btn-xs text-error" data-action="second-stage-builder#removeGroup">Remover</button>
              </div>

              <div class="mt-4 space-y-3">
                <% 4.times do |slot_index| %>
                  <div class="form-control">
                    <%= label_tag "groups_#{group_key}_#{slot_index}", "Posição #{slot_index + 1}", class: "label-text text-xs font-semibold uppercase tracking-wide" %>
                    <%= select_tag "groups[#{group_key}][]",
                      options_for_select(
                        [["Selecione a dupla", ""]] + @tranca_second_stage_candidates.map { |entry| tranca_candidate_option(entry) },
                        @tranca_second_stage_prefill_groups.dig(group_key, slot_index)
                      ),
                      id: "groups_#{group_key}_#{slot_index}",
                      class: "select select-bordered select-sm w-full",
                      required: true,
                      data: {
                        second_stage_builder_target: "select",
                        action: "change->second-stage-builder#updateState"
                      } %>
                  </div>
                <% end %>
              </div>
            </section>
          <% end %>
          <template>
            <section class="rounded-3xl border border-primary/40 bg-base-200/70 p-4">
              <div class="flex items-center justify-between gap-3">
                <h4 class="font-bold">Chave __GROUP_KEY__</h4>
                <button type="button" class="btn btn-ghost btn-xs text-error" data-action="second-stage-builder#removeGroup">Remover</button>
              </div>
              <div class="mt-4 space-y-3">
                <% 4.times do %>
                  <div class="form-control">
                    <label class="label-text text-xs font-semibold uppercase tracking-wide">Posição</label>
                    <select name="groups[__GROUP_KEY__][]" class="select select-bordered select-sm w-full" required data-second-stage-builder-target="select" data-action="change->second-stage-builder#updateState">
                      <option value="">Selecione a dupla</option>
                      <% @tranca_second_stage_candidates.each do |entry| %>
                        <option value="<%= entry.tranca_dupla_id %>"><%= tranca_candidate_option(entry).first %></option>
                      <% end %>
                    </select>
                  </div>
                <% end %>
              </div>
            </section>
          </template>
        </div>

        <button type="button" class="btn btn-outline" data-action="second-stage-builder#addGroup">+ Criar outra chave</button>

        <div class="rounded-2xl border border-base-300 bg-base-100 p-4 text-sm text-base-content/70">
          <p><strong>1ª rodada:</strong> 1×2 e 4×3</p>
          <p><strong>2ª rodada:</strong> 4×1 e 3×2</p>
          <p><strong>3ª rodada:</strong> 1×3 e 2×4</p>
        </div>

        <p class="hidden rounded-2xl border border-warning/30 bg-warning/10 p-3 text-sm text-warning-content" data-second-stage-builder-target="error"></p>

        <div class="modal-action">
          <button type="button" class="btn btn-ghost" onclick="document.getElementById('tranca-second-stage-modal').close()">Cancelar</button>
          <%= submit_tag "Criar 2ª etapa", class: "btn btn-primary", disabled: true, data: { second_stage_builder_target: "submitButton" } %>
        </div>
      <% end %>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button aria-label="Fechar">Fechar</button>
    </form>
  </dialog>

  <dialog id="tranca-knockout-config-modal" class="modal">
    <% knockout_stage_slots = {
      "oitavas_quartas_semi_final" => 16,
      "quartas_semi_final" => 8,
      "semi_final" => 4
    } %>
    <div class="modal-box max-w-7xl" data-controller="knockout-builder" data-knockout-builder-stage-slots-value="<%= knockout_stage_slots.to_json %>">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs uppercase tracking-[0.28em] text-base-content/50">Configuração do mata-mata</p>
          <h3 class="mt-1 text-2xl font-black">Escolher o tipo de chave</h3>
          <p class="mt-1 text-sm text-base-content/70">Primeiro definimos a estrutura da eliminatória. A próxima etapa vai completar a configuração.</p>
        </div>
        <button type="button" class="btn btn-ghost btn-sm" onclick="document.getElementById('tranca-knockout-config-modal').close()">Fechar</button>
      </div>

      <%= form_with url: generate_tranca_round_championship_path(@championship), method: :post, class: "mt-6 space-y-6" do %>
        <%= hidden_field_tag :phase, "mata_mata" %>
        <%= hidden_field_tag :round_number, @tranca_next_knockout_round_number %>

        <div data-knockout-builder-target="stepOne" class="space-y-4">
          <div class="form-control">
            <%= label_tag :knockout_stage_type, "Tipo de mata-mata", class: "label-text font-medium" %>
            <%= select_tag :knockout_stage_type,
              options_for_select([
                ["Oitavas / quartas / semi / final", "oitavas_quartas_semi_final"],
                ["Quartas / semi / final", "quartas_semi_final"],
                ["Semi / final", "semi_final"]
              ]),
              class: "select select-bordered w-full",
              required: true,
              data: {
                knockout_builder_target: "stageSelect",
                action: "change->knockout-builder#updateStage"
              } %>
            <p class="mt-2 text-sm text-base-content/60">Essa escolha define quantas duplas entram na montagem manual da chave.</p>
          </div>

          <div class="rounded-3xl border border-base-300 bg-base-200/70 p-4">
            <p class="text-sm font-semibold">Próxima etapa</p>
            <p class="mt-1 text-sm text-base-content/70">Você vai ver os classificados e escolher as duplas de cada jogo no desenho da chave.</p>
          </div>

          <div class="modal-action">
            <button type="button" class="btn btn-ghost" onclick="document.getElementById('tranca-knockout-config-modal').close()">Cancelar</button>
            <button type="button" class="btn btn-primary" data-action="click->knockout-builder#next">Continuar</button>
          </div>
        </div>

        <div data-knockout-builder-target="stepTwo" class="hidden space-y-5">
          <div class="grid gap-4 lg:grid-cols-[0.9fr_1.5fr]">
            <aside class="rounded-3xl border border-base-300 bg-base-200/70 p-4">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                  <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Etapa 2</p>
                  <h4 class="mt-1 text-lg font-bold">Classificados</h4>
                </div>
                <span class="badge badge-primary" data-knockout-builder-target="counter">0/16 duplas selecionadas</span>
              </div>

              <div class="mt-4 max-h-[30rem] space-y-2 overflow-y-auto pr-1">
                <% if @tranca_knockout_candidate_rows.any? %>
                  <% @tranca_knockout_candidate_rows.each do |entry| %>
                    <% dupla = entry.respond_to?(:tranca_dupla) ? entry.tranca_dupla : entry %>
                    <% category = entry.respond_to?(:category) ? entry.category : dupla.category %>
                    <div class="rounded-2xl border border-base-300 bg-base-100 p-3">
                      <p class="font-semibold leading-tight"><%= dupla.name %></p>
                      <p class="mt-1 text-xs text-base-content/60"><%= category.name %></p>
                      <% if entry.respond_to?(:position) %>
                        <% group_label = tranca_group_key_label(entry.group_key) || entry.group_key.presence || "geral" %>
                        <p class="mt-1 text-xs text-base-content/50">
                          <%= entry.group_key.present? ? "Chave #{group_label}" : "Classificação" %> · <%= entry.position %>º · <%= entry.points %> pts
                        </p>
                      <% end %>
                    </div>
                  <% end %>
                <% else %>
                  <p class="text-sm text-base-content/60">Nenhuma dupla disponível para montar a chave.</p>
                <% end %>
              </div>
            </aside>

            <div class="overflow-x-auto rounded-3xl border border-base-300 bg-base-200/70 p-4">
              <div class="min-w-[52rem]">
                <div class="grid grid-cols-[1fr_0.75fr_0.75fr_0.75fr] gap-4 text-xs font-semibold uppercase tracking-[0.2em] text-base-content/50">
                  <span>Entrada</span>
                  <span>Quartas</span>
                  <span>Semi</span>
                  <span>Final</span>
                </div>

                <div class="mt-4 grid grid-cols-[1fr_0.75fr_0.75fr_0.75fr] gap-4">
                  <div class="space-y-3">
                    <% 8.times do |index| %>
                      <div data-knockout-builder-target="game" class="rounded-2xl border border-base-300 bg-base-100 p-3">
                        <div class="mb-2 flex items-center justify-between gap-3">
                          <p class="text-sm font-bold">Jogo <%= index + 1 %></p>
                          <span class="badge badge-outline badge-sm">mata-mata</span>
                        </div>
                        <% 2.times do |slot_index| %>
                          <%= select_tag "selected_dupla_ids[]",
                            options_for_select([["Selecione a dupla", ""]] + @tranca_knockout_candidate_rows.map { |entry|
                              tranca_candidate_option(entry)
                            }),
                            class: "select select-bordered select-sm mb-2 w-full",
                            data: {
                              knockout_builder_target: "select",
                              action: "change->knockout-builder#updateState"
                            } %>
                        <% end %>
                      </div>
                    <% end %>
                  </div>

                  <div class="space-y-14 pt-10">
                    <% 4.times do |index| %>
                      <div class="rounded-2xl border border-dashed border-base-300 bg-base-100/70 p-3 text-sm text-base-content/60">
                        Vencedor jogos <%= (index * 2) + 1 %> e <%= (index * 2) + 2 %>
                      </div>
                    <% end %>
                  </div>

                  <div class="space-y-32 pt-24">
                    <% 2.times do |index| %>
                      <div class="rounded-2xl border border-dashed border-base-300 bg-base-100/70 p-3 text-sm text-base-content/60">
                        Vencedor quartas <%= (index * 2) + 1 %> e <%= (index * 2) + 2 %>
                      </div>
                    <% end %>
                  </div>

                  <div class="pt-52">
                    <div class="rounded-2xl border border-dashed border-primary/40 bg-primary/10 p-3 text-sm font-semibold text-primary">
                      Final
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <p class="hidden rounded-2xl border border-warning/30 bg-warning/10 p-3 text-sm text-warning-content" data-knockout-builder-target="error"></p>

          <div class="modal-action">
            <button type="button" class="btn btn-ghost" data-action="click->knockout-builder#back">Voltar</button>
            <%= submit_tag "Gerar chave eliminatória", class: "btn btn-primary", data: { knockout_builder_target: "submitButton" } %>
          </div>
        </div>
      <% end %>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button aria-label="Fechar">Fechar</button>
    </form>
  </dialog>
<% end %>

<%= surface_card(title: "Rodadas", subtitle: "As partidas podem ser organizadas por fase e número.") do %>
  <% if @tranca_rodadas.any? %>
    <div class="space-y-6">
      <% dupla_names = @tranca_duplas.index_by(&:id) %>
      <% manage_round_games = user_signed_in? && @championship.manageable_by?(current_user) %>
      <% @tranca_rodadas.each do |round| %>
        <% round_management_enabled = manage_round_games && round.first_stage? %>
        <% round_presenter = BolaCinco::TrancaProgramacaoPresenter.new(@championship, round.partidas) %>
        <% round_deletable = round.partidas.none?(&:finished?) %>
        <div class="rounded-3xl bg-base-200 p-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h3 class="text-xl font-bold"><%= round.label %></h3>
              <% bye_ids = round.partidas.flat_map { |match| Array(match.source_data["bye_ids"]) }.uniq %>
              <% if bye_ids.any? %>
                <p class="mt-2 text-sm font-medium">Folga nesta rodada: <%= bye_ids.map { |id| dupla_names[id]&.name || "Dupla ##{id}" }.join(" · ") %></p>
              <% end %>
              <p class="mt-1 text-sm text-base-content/60"><%= round.partidas.size %> partida(s) · <%= round.mesas.size %> mesa(s)</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <span class="badge badge-outline"><%= round.stage_label %></span>
              <span class="badge badge-outline"><%= round.phase_label %></span>
              <% if round.partidas.any? %>
                <%= link_to "Baixar todas as súmulas (PDF)", championship_round_summulas_path(@championship, rodada_id: round.id), class: "btn btn-outline btn-xs", data: { turbo: false } %>
                <%= link_to "Por mesa (Excel)", championship_round_games_path(@championship, rodada_id: round.id, order: :mesa), class: "btn btn-outline btn-xs", data: { turbo: false } %>
                <%= link_to "Por nome (Excel)", championship_round_games_path(@championship, rodada_id: round.id, order: :name), class: "btn btn-outline btn-xs", data: { turbo: false } %>
                <%= link_to "Programação (PDF)", programacao_championship_path(@championship, format: :pdf), class: "btn btn-outline btn-xs", data: { turbo: false } %>
              <% end %>
              <% if round_management_enabled %>
                <%= button_to "Definir mesas", generate_tranca_mesas_championship_path(@championship, rodada_id: round.id), method: :post, class: "btn btn-outline btn-xs" %>
                <% if round_deletable %>
                  <%= button_to "Excluir rodada", destroy_tranca_round_championship_path(@championship, rodada_id: round.id), method: :delete, class: "btn btn-outline btn-error btn-xs", form: { data: { turbo_confirm: "Excluir #{round.label} e todos os seus jogos?" } } %>
                <% end %>
              <% end %>
            </div>
          </div>

          <div class="mt-4 space-y-4">
            <% round_presenter.sections.each do |section| %>
              <div class="rounded-2xl border border-base-300 bg-base-100 p-3">
                <div class="flex flex-wrap items-center justify-between gap-3 border-b border-base-200 pb-3">
                  <div>
                    <p class="text-xs uppercase tracking-[0.28em] text-base-content/50">Chave <%= tranca_group_key_label(section[:label]) || section[:label] %></p>
                    <p class="mt-1 text-sm text-base-content/60"><%= section[:rows].size %> partida(s)</p>
                  </div>

                  <% if round_management_enabled && section[:key].present? %>
                    <div class="flex flex-wrap gap-2">
                      <button type="button" class="btn btn-primary btn-xs" onclick="document.getElementById('tranca-round-key-create-<%= round.id %>-<%= section[:key].parameterize %>').showModal()">
                        Criar jogo
                      </button>
                      <%= button_to "Excluir chave", destroy_tranca_key_championship_path(@championship, rodada_id: round.id, group_key: section[:key]), method: :delete, class: "btn btn-outline btn-error btn-xs", form: { data: { turbo_confirm: "Excluir a chave #{tranca_group_key_label(section[:label]) || section[:label]} e todos os seus jogos?" } } %>
                    </div>
                  <% end %>
                </div>

                <div class="mt-3 space-y-3">
                  <% section[:rows].each do |row| %>
                    <% match = row[:match] %>
                    <div class="space-y-2 rounded-2xl border border-base-300 bg-base-200/40 p-3">
                      <div class="flex flex-wrap items-center justify-between gap-3">
                        <%= match_card(match, compact: true, legacy_match: false) %>
                        <div class="flex flex-wrap items-center gap-2">
                          <%= link_to(match.finished? ? "Editar súmula" : "Abrir súmula", (match.finished? ? edit_tranca_summula_championship_path(@championship, partida_id: match.id) : import_tranca_summula_championship_path(@championship, partida_id: match.id)), class: "btn btn-outline btn-xs") %>
                          <% if match.finished? && match.classification_phase? %>
                            <%= button_to "Remover resultado", destroy_tranca_partida_championship_path(@championship, partida_id: match.id), method: :delete, class: "btn btn-outline btn-error btn-xs", form: { data: { turbo_confirm: "Remover o resultado de #{match.code} e reabrir o jogo?" } } %>
                          <% end %>
                          <% if round_management_enabled && match.status_agendado? %>
                            <%= button_to "Excluir jogo", destroy_tranca_partida_championship_path(@championship, partida_id: match.id), method: :delete, class: "btn btn-outline btn-error btn-xs", form: { data: { turbo_confirm: "Excluir #{match.code} e liberar a mesa?" } } %>
                          <% end %>
                        </div>
                      </div>

                      <% if round_management_enabled && match.status_agendado? %>
                        <div class="flex flex-wrap justify-end gap-2">
                          <button type="button" class="btn btn-primary btn-xs" onclick="document.getElementById('tranca-partida-modal-<%= match.id %>').showModal()">
                            Alterar dupla / excluir
                          </button>
                        </div>
                        <%= render "components/tranca_partida_management_modal", championship: @championship, partida: match, duplas: (@tranca_duplas_by_category[match.category_id] || []) %>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
              <% if round_management_enabled && section[:key].present? %>
                <% first_match = section[:rows].first&.dig(:match) %>
                <% if first_match.present? %>
                  <%= render "components/tranca_round_key_create_modal",
                    championship: @championship,
                    rodada: round,
                    group_key: section[:key],
                    group_label: section[:label],
                    category: first_match.category,
                    duplas: (@tranca_duplas_by_category[first_match.category_id] || []) %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <%= empty_state(
      title: "Nenhuma rodada cadastrada",
      description: "A Tranca exibirá as rodadas aqui quando os jogos forem organizados."
    ) %>
  <% end %>
<% end %>
