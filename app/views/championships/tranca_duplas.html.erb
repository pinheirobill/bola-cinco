<% content_for :title, "#{@championship.name} | Duplas | Bola Cinco" %>

<%= page_header(
  title: "#{@championship.name} · Duplas",
  subtitle: "Cadastro e composição das duplas da Tranca.",
  badge: @championship.status.to_s.tr("_", " ").humanize,
  actions: [
    link_to("Início", championship_path(@championship), class: "btn btn-outline"),
    link_to("Partidas", partidas_championship_path(@championship), class: "btn btn-outline"),
    link_to("Rodadas", rodadas_championship_path(@championship), class: "btn btn-outline"),
    link_to("Classificação", classificacao_championship_path(@championship), class: "btn btn-primary")
  ]
) %>

<%= stats_grid([
  { label: "Duplas", value: @tranca_total_duplas, value_class: "text-2xl" },
  { label: "Categorias", value: @tranca_categories.size, value_class: "text-2xl" },
  { label: "Atletas", value: @championship.athletes.count, value_class: "text-2xl" },
  { label: "Partidas", value: @tranca_total_partidas, value_class: "text-2xl" }
]) %>

<% if @championship.manageable_by?(current_user) %>
  <div class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-base-300 bg-base-100 p-5">
    <div>
      <h2 class="font-semibold">Importar duplas do Excel</h2>
      <p class="mt-1 text-sm text-base-content/70">Confira a prévia, reaproveite cadastros e inscreva as duplas como aprovadas.</p>
    </div>
    <%= link_to "Importar duplas", new_championship_dupla_import_path(@championship), class: "btn btn-primary" %>
  </div>
<% end %>

<%= surface_card(
  title: "Duplas por categoria",
  subtitle: "A Tranca reaproveita o cadastro de times como composição das duplas."
) do %>
  <% if user_signed_in? && @championship.manageable_by?(current_user) %>
    <div class="mb-6 rounded-3xl border border-base-300 bg-gradient-to-br from-base-200 via-base-200 to-base-300/40 p-5 shadow-sm">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="max-w-3xl">
          <p class="text-xs uppercase tracking-[0.3em] text-base-content/50">Cadastro rápido</p>
          <h3 class="mt-2 text-2xl font-semibold">Nova dupla</h3>
          <p class="mt-2 text-sm leading-6 text-base-content/70">
            Escolha uma entidade existente se quiser reaproveitar o cadastro.
            Se deixar em branco, criamos uma entidade nova com o nome final da dupla.
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          <div class="rounded-2xl bg-base-100 p-4">
            <p class="text-xs uppercase tracking-[0.25em] text-base-content/40">Categoria padrão</p>
            <p class="mt-2 font-semibold"><%= @tranca_default_category&.name || "Selecione" %></p>
          </div>
          <div class="rounded-2xl bg-base-100 p-4">
            <p class="text-xs uppercase tracking-[0.25em] text-base-content/40">Entidade</p>
            <p class="mt-2 font-semibold">Automática ou existente</p>
          </div>
        </div>
      </div>

      <%= form_with url: teams_path, method: :post, class: "mt-5 space-y-5", data: { controller: "tranca-dupla-form" } do |f| %>
        <%= hidden_field_tag "team[source_id]", "" %>
        <%= hidden_field_tag "team[category_id]", @tranca_default_category&.id %>

        <div class="grid gap-5 xl:grid-cols-[1.2fr_0.8fr]">
          <div class="grid gap-4 md:grid-cols-2">
            <div class="form-control gap-2">
              <%= label_tag "team[name]", "Nome da dupla", class: "label-text font-medium" %>
              <%= text_field_tag "team[name]", nil, class: "input input-bordered w-full", placeholder: "Carlos / Ana", data: { tranca_dupla_form_target: "teamName", action: "input->tranca-dupla-form#sync" } %>
              <p class="text-xs text-base-content/50">Você pode deixar em branco e usar os participantes como sugestão.</p>
            </div>

            <div class="grid gap-4 sm:grid-cols-2 md:col-span-2">
              <div class="form-control gap-2">
                <%= label_tag "team[participant_one_name]", "Participante 1", class: "label-text font-medium" %>
                <%= text_field_tag "team[participant_one_name]", nil, class: "input input-bordered w-full", placeholder: "Nome 1", data: { tranca_dupla_form_target: "participantOne", action: "input->tranca-dupla-form#sync" } %>
              </div>

              <div class="form-control gap-2">
                <%= label_tag "team[participant_two_name]", "Participante 2", class: "label-text font-medium" %>
                <%= text_field_tag "team[participant_two_name]", nil, class: "input input-bordered w-full", placeholder: "Nome 2", data: { tranca_dupla_form_target: "participantTwo", action: "input->tranca-dupla-form#sync" } %>
              </div>
            </div>

            <div class="form-control gap-2 md:col-span-2 md:max-w-sm">
              <%= label_tag "team[entity_id]", "Entidade existente", class: "label-text text-sm font-medium" %>
              <%= select_tag "team[entity_id]",
                options_from_collection_for_select(@tranca_entities, :id, :name),
                include_blank: "Criar automaticamente",
                class: "select select-bordered select-sm w-full",
                data: { tranca_dupla_form_target: "entitySelect", action: "change->tranca-dupla-form#sync" } %>
              <p class="text-xs text-base-content/50">Se não escolher uma entidade, criamos uma nova com o nome da dupla.</p>
            </div>
          </div>

          <div class="rounded-3xl border border-base-300 bg-base-100 p-4">
            <p class="text-xs uppercase tracking-[0.3em] text-base-content/50">Prévia</p>
            <div class="mt-4 space-y-3">
              <div class="rounded-2xl bg-base-200/70 p-4">
                <p class="text-xs uppercase tracking-[0.25em] text-base-content/40">Nome da dupla</p>
                <p class="mt-2 text-lg font-semibold" data-tranca-dupla-form-target="previewName">Carlos / Ana</p>
              </div>

              <div class="grid gap-3 sm:grid-cols-2">
                <div class="rounded-2xl bg-base-200/70 p-4">
                  <p class="text-xs uppercase tracking-[0.25em] text-base-content/40">Participantes</p>
                  <p class="mt-2 text-sm font-semibold text-base-content/80" data-tranca-dupla-form-target="previewParticipants">Nome 1 · Nome 2</p>
                </div>

                <div class="rounded-2xl bg-base-200/70 p-4">
                  <p class="text-xs uppercase tracking-[0.25em] text-base-content/40">Categoria</p>
                  <p class="mt-2 text-sm font-semibold text-base-content/80"><%= @tranca_default_category&.name || "Selecione" %></p>
                </div>

                <div class="rounded-2xl bg-base-200/70 p-4 sm:col-span-2">
                  <p class="text-xs uppercase tracking-[0.25em] text-base-content/40">Entidade</p>
                  <p class="mt-2 text-sm font-semibold text-base-content/80" data-tranca-dupla-form-target="previewEntity">Automática</p>
                </div>
              </div>

              <div class="rounded-2xl border border-dashed border-base-300 bg-base-200/40 p-4">
                <p class="text-sm text-base-content/70">
                  O cadastro salva a dupla como um time da Tranca, mas a escrita fica mais clara para quem está lançando agora.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <%= submit_tag "Criar dupla", class: "btn btn-primary" %>
          <%= link_to "Ver entidades", entities_path, class: "btn btn-outline" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @tranca_categories.any? %>
    <div class="space-y-6">
      <% @tranca_categories.each do |category| %>
        <% teams = @tranca_duplas_by_category.fetch(category.id, []) %>
        <div class="rounded-3xl bg-base-200 p-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h3 class="text-xl font-bold"><%= category.name %></h3>
              <p class="mt-1 text-sm text-base-content/60"><%= teams.size %> dupla(s) vinculadas</p>
            </div>
            <%= link_to "Ver categoria", category_path(category), class: "link link-primary" %>
          </div>

          <div class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
            <% teams.each do |team| %>
              <div class="rounded-2xl bg-base-100 p-4">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="font-semibold"><%= link_to team.name, team_path(team), class: "link link-primary" %></p>
                    <p class="mt-1 text-xs text-base-content/60"><%= team.entity.name %></p>
                  </div>
                  <% confirmed = team.registration_status.to_s == "aprovada" %>
                  <span class="badge <%= confirmed ? "badge-success" : "badge-warning" %>">
                    <%= confirmed ? "Confirmado" : "Pendente" %>
                  </span>
                </div>

                <div class="mt-4 space-y-2 text-sm text-base-content/70">
                  <% athlete_names = team.athletes.map(&:name) %>
                  <% if athlete_names.any? %>
                    <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Integrantes</p>
                    <p><%= athlete_names.join(" · ") %></p>
                  <% else %>
                    <p>Sem atletas vinculados ainda.</p>
                  <% end %>
                </div>
                <% if user_signed_in? && @championship.manageable_by?(current_user) %>
                  <div class="mt-4 flex flex-wrap gap-2">
                    <% legacy_team = team.legacy_team %>
                    <% if legacy_team.present? %>
                      <%= link_to "Abrir", team_path(legacy_team), class: "btn btn-outline btn-xs" %>
                      <%= button_to "Remover", team_path(legacy_team), method: :delete, class: "btn btn-ghost btn-xs", data: { turbo_confirm: "Remover esta dupla?" } %>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <%= empty_state(
      title: "Nenhuma dupla cadastrada",
      description: "As duplas aparecerão aqui quando os times forem vinculados às categorias do campeonato."
    ) %>
  <% end %>
<% end %>
