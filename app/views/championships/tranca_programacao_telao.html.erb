<% content_for :title, "#{@championship.name} | Programação - Telão | Arena" %>

<div class="fixed inset-0 flex gap-2 overflow-hidden bg-[radial-gradient(circle_at_top,_#ffffff_0%,_#ecf2f8_34%,_#cbd5e1_100%)] p-2">
  <div class="w-[clamp(60rem,9vw,13rem)] shrink-0">
    <%= render "programacao_clock_panel" %>
  </div>

  <main class="relative mx-1 min-h-0 min-w-0 flex-[1.25] overflow-hidden rounded-[1.5rem]" data-programacao-fit>
    <div class="absolute left-0 top-0 origin-top-left" data-programacao-board>
      <%= render "components/tranca_programacao_board",
        presenter: @tranca_programacao,
        fixed_canvas: true %>
    </div>
  </main>

  <div class="w-[clamp(60rem,9vw,13rem)] shrink-0">
    <%= render "programacao_clock_panel" %>
  </div>
</div>

<script>
  (() => {
    const timerNodes = Array.from(document.querySelectorAll("[data-programacao-timer]"))
    const durationInputs = Array.from(document.querySelectorAll("[data-programacao-duration]"))
    const startButtons = Array.from(document.querySelectorAll("[data-programacao-start]"))
    const stopButtons = Array.from(document.querySelectorAll("[data-programacao-stop]"))
    const resetButtons = Array.from(document.querySelectorAll("[data-programacao-reset]"))
    const statusNodes = Array.from(document.querySelectorAll("[data-programacao-status]"))
    let timerInterval = null
    let running = false
    let finished = false
    let paused = false
    let remainingMs = 0
    let endsAt = null

    const durationMs = () => {
      const minutes = Math.max(Number.parseInt(durationInputs[0]?.value, 10) || 0, 0)
      return minutes * 60 * 1000
    }

    const currentRemainingMs = () => (
      running && endsAt !== null ? Math.max(endsAt - Date.now(), 0) : remainingMs
    )

    const formatRemaining = (ms) => {
      const totalSeconds = Math.ceil(ms / 1000)
      const minutes = String(Math.floor(totalSeconds / 60)).padStart(2, "0")
      const seconds = String(totalSeconds % 60).padStart(2, "0")
      return `${minutes}:${seconds}`
    }

    const clearTimerInterval = () => {
      if (timerInterval) window.clearInterval(timerInterval)
      timerInterval = null
    }

    const syncDurationInputs = (value) => {
      durationInputs.forEach((input) => {
        input.value = value
      })
    }

    const setTextContent = (nodes, text) => {
      nodes.forEach((node) => {
        node.textContent = text
      })
    }

    const setDisabled = (nodes, disabled) => {
      nodes.forEach((node) => {
        node.disabled = disabled
      })
    }

    const syncControls = () => {
      setDisabled(durationInputs, running)
      setDisabled(startButtons, running || durationMs() === 0)
      setDisabled(stopButtons, !running)

      const statusText = running ? "Rodando" : finished ? "Finalizado" : paused ? "Pausado" : "Pronto"
      setTextContent(statusNodes, statusText)
      statusNodes.forEach((node) => {
        node.classList.toggle("text-rose-300", finished)
        node.classList.toggle("text-emerald-300", !finished)
      })
    }

    const finishTimer = () => {
      remainingMs = 0
      endsAt = null
      running = false
      finished = true
      paused = false
      clearTimerInterval()
      setTextContent(timerNodes, "00:00")
      syncControls()
    }

    const renderTimer = () => {
      remainingMs = currentRemainingMs()

      if (running && remainingMs === 0) {
        finishTimer()
        return
      }

      setTextContent(timerNodes, formatRemaining(remainingMs))
    }

    const startTimer = () => {
      if (running) return
      if (remainingMs <= 0) remainingMs = durationMs()
      if (remainingMs <= 0) return

      running = true
      finished = false
      paused = false
      endsAt = Date.now() + remainingMs
      clearTimerInterval()
      timerInterval = window.setInterval(renderTimer, 250)
      renderTimer()
      syncControls()
    }

    const stopTimer = () => {
      if (!running) return

      remainingMs = currentRemainingMs()
      endsAt = null
      running = false
      paused = remainingMs > 0
      clearTimerInterval()
      renderTimer()
      syncControls()
    }

    const resetTimer = () => {
      clearTimerInterval()
      endsAt = null
      running = false
      finished = false
      paused = false
      remainingMs = durationMs()
      renderTimer()
      syncControls()
    }

    const fit = () => {
      const viewport = document.querySelector("[data-programacao-fit]")
      const board = document.querySelector("[data-programacao-board]")
      if (!viewport || !board) return

      const width = board.offsetWidth
      const height = board.offsetHeight
      if (!width || !height) return

      const scale = Math.min(viewport.clientWidth / width, 1)
      const offsetX = Math.max((viewport.clientWidth - width * scale) / 2, 0)
      const offsetY = Math.max((viewport.clientHeight - height * scale) / 2, 0)

      board.style.transformOrigin = "top left"
      board.style.transform = `translate(${offsetX}px, ${offsetY}px) scale(${scale})`
    }

    durationInputs.forEach((durationInput) => {
      durationInput.addEventListener("input", () => {
        if (running) return
        finished = false
        paused = false
        syncDurationInputs(durationInput.value)
        remainingMs = durationMs()
        renderTimer()
        syncControls()
      })
    })

    startButtons.forEach((button) => button.addEventListener("click", startTimer))
    stopButtons.forEach((button) => button.addEventListener("click", stopTimer))
    resetButtons.forEach((button) => button.addEventListener("click", resetTimer))

    document.addEventListener("turbo:before-cache", () => {
      remainingMs = currentRemainingMs()
      running = false
      endsAt = null
      clearTimerInterval()
    })
    window.addEventListener("resize", fit)

    syncDurationInputs(durationInputs[0]?.value || "45")
    remainingMs = durationMs()
    fit()
    renderTimer()
    syncControls()
  })()
</script>
