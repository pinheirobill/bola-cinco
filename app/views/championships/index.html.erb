<% content_for :title, "Campeonatos | Bola Cinco" %>

<%= page_header(
  title: "Campeonatos",
  subtitle: "Visão geral dos campeonatos públicos e acessíveis.",
  badge: "Visão",
  actions: [
    (current_championship.present? ? link_to("Onboarding do campeonato", setup_championship_path(current_championship), class: "btn btn-primary") : nil)
  ].compact
) %>

<%= stats_grid([
  { label: "Campeonatos", value: @championships.size, value_class: "text-2xl" },
  { label: "Temporadas", value: @championships.map(&:season).compact.uniq.size, value_class: "text-2xl" }
], columns: "md:grid-cols-2") %>

<%= surface_card do %>
  <% if @championships.any? %>
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Nome</th>
            <th>Temporada</th>
            <th>Status</th>
            <th>Categorias</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @championships.each do |championship| %>
            <tr>
              <td class="font-medium"><%= championship.name %></td>
              <td><%= championship.season %></td>
              <td><%= status_badge(championship.status) %></td>
              <td><%= championship.categories.size %></td>
              <td>
                <div class="flex flex-wrap gap-2">
                  <%= link_to "Visão geral", championship_path(championship), class: "link link-primary" %>
                  <% if user_signed_in? && championship.manageable_by?(current_user) %>
                    <%= link_to "Configurar", setup_championship_path(championship), class: "link link-primary" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= empty_state(
      title: "Nenhum campeonato encontrado",
      description: "Os campeonatos públicos e acessíveis aparecerão aqui."
    ) %>
  <% end %>
<% end %>
