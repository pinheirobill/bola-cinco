<% content_for :title, "#{@championship.name} | Programação | Arena" %>

<%= page_header(
  title: "#{@championship.name} · Programação",
  subtitle: "Tela de programação no mesmo layout do PDF.",
  badge: @championship.status.to_s.tr("_", " ").humanize,
  actions: [
    link_to("Início", championship_path(@championship), class: "btn btn-outline"),
    link_to("Rodadas", rodadas_championship_path(@championship), class: "btn btn-outline"),
    link_to("Classificação", classificacao_championship_path(@championship), class: "btn btn-outline"),
    link_to("Telão", programacao_telao_championship_path(@championship), class: "btn btn-primary", data: { turbo: false }),
    link_to("Baixar PDF", programacao_championship_path(@championship, format: :pdf), class: "btn btn-outline", data: { turbo: false })
  ]
) %>

<%= surface_card(
  title: "Programação de jogos",
  subtitle: "A tela usa a mesma estrutura visual do PDF de referência."
) do %>
  <% manage_programacao_keys = user_signed_in? && @championship.manageable_by?(current_user) %>
  <%= render "components/tranca_programacao_board",
    presenter: @tranca_programacao,
    key_delete_path: (manage_programacao_keys ? ->(group_key) { destroy_tranca_programacao_key_championship_path(@championship, group_key: group_key) } : nil) %>
<% end %>
