<% content_for :title, "#{@championship.name} | Programação | Arena" %>

<% current_stage = @programacao_stage.presence || "all" %>

<%= page_header(
  title: "#{@championship.name} · Programação",
  subtitle: "Tela de programação no mesmo layout do PDF.",
  badge: @championship.status.to_s.tr("_", " ").humanize,
  actions: [
    link_to("Início", championship_path(@championship), class: "btn btn-outline"),
    link_to("Rodadas", rodadas_championship_path(@championship), class: "btn btn-outline"),
    link_to("Classificação", classificacao_championship_path(@championship), class: "btn btn-outline"),
    link_to("Telão", programacao_telao_championship_path(@championship, stage: current_stage), class: "btn btn-primary", data: { turbo: false }, target: "_blank", rel: "noopener noreferrer"),
    link_to("Baixar PDF", programacao_championship_path(@championship, format: :pdf, stage: current_stage), class: "btn btn-outline", data: { turbo: false })
  ]
) %>

<%= surface_card(
  title: "Programação de jogos",
  subtitle: "A tela usa a mesma estrutura visual do PDF de referência."
) do %>
  <div class="mb-4 flex flex-wrap items-center gap-2">
    <span class="mr-2 text-sm font-semibold text-base-content/70">Exibir:</span>
    <%= link_to "Todas as etapas", programacao_championship_path(@championship, stage: "all"), class: "btn btn-sm #{current_stage == 'all' ? 'btn-primary' : 'btn-outline'}", data: { turbo: false } %>
    <%= link_to "Etapa 1", programacao_championship_path(@championship, stage: 1), class: "btn btn-sm #{current_stage == '1' ? 'btn-primary' : 'btn-outline'}", data: { turbo: false } %>
    <%= link_to "Etapa 2", programacao_championship_path(@championship, stage: 2), class: "btn btn-sm #{current_stage == '2' ? 'btn-primary' : 'btn-outline'}", data: { turbo: false } %>
    <span class="ml-2 text-sm text-base-content/60">Selecionado: <%= @tranca_programacao.stage_label %></span>
  </div>

  <%= render "components/tranca_programacao_board", presenter: @tranca_programacao %>
<% end %>
