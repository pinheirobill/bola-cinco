<% content_for :title, "#{@championship.name} | Programação | Arena" %>

<%= page_header(
  title: "#{@championship.name} · Programação",
  subtitle: "Tela de programação no mesmo layout do PDF.",
  badge: @championship.status.to_s.tr("_", " ").humanize,
  actions: [
    link_to("Início", championship_path(@championship), class: "btn btn-outline"),
    link_to("Rodadas", rodadas_championship_path(@championship), class: "btn btn-outline"),
    link_to("Classificação", classificacao_championship_path(@championship), class: "btn btn-outline"),
    link_to("Telão", programacao_telao_championship_path(@championship), class: "btn btn-primary", data: { turbo: false }, target: "_blank", rel: "noopener noreferrer"),
    link_to("Baixar PDF", programacao_championship_path(@championship, format: :pdf), class: "btn btn-outline", data: { turbo: false })
  ]
) %>

<%= surface_card(
  title: "Programação de jogos",
  subtitle: "A tela usa a mesma estrutura visual do PDF de referência."
) do %>
  <div class="mb-4 flex flex-wrap items-center gap-2" data-programacao-stage-toggle>
    <span class="mr-2 text-sm font-semibold text-base-content/70">Exibir:</span>
    <button type="button" class="btn btn-sm btn-primary" data-stage="all">Todas as etapas</button>
    <button type="button" class="btn btn-sm" data-stage="1">Etapa 1</button>
    <button type="button" class="btn btn-sm" data-stage="2">Etapa 2</button>
  </div>

  <%= render "components/tranca_programacao_board", presenter: @tranca_programacao %>
<% end %>

<script>
  (() => {
    const toggle = document.querySelector("[data-programacao-stage-toggle]")
    const board = toggle?.nextElementSibling
    if (!toggle || !board) return

    const buttons = Array.from(toggle.querySelectorAll("[data-stage]"))
    const sections = Array.from(board.querySelectorAll("section"))

    const render = (stage) => {
      sections.forEach((section) => {
        const text = section.textContent || ""
        const visible = stage === "all" || text.includes(`Etapa ${stage}`)
        section.classList.toggle("hidden", !visible)
      })

      buttons.forEach((button) => {
        button.classList.toggle("btn-primary", button.dataset.stage === stage)
      })
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => render(button.dataset.stage))
    })

    render("all")
  })()
</script>
