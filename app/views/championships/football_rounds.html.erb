<% content_for :title, "#{@championship.name} | Rodadas | Arena" %>

<%= page_header(
  title: "#{@championship.name} · Rodadas",
  subtitle: "Partidas organizadas por fase e rodada.",
  badge: @championship.status.to_s.tr("_", " ").humanize
) %>
<%= render "championships/football_navigation", championship: @championship, current: "rodadas" %>

<%= stats_grid([
  { label: "Rodadas", value: @football_rounds.size, value_class: "text-2xl" },
  { label: "Partidas", value: @football_matches.size, value_class: "text-2xl" }
], columns: "md:grid-cols-2") %>

<% if @football_rounds.any? %>
  <div class="mt-6 space-y-6">
    <% @football_rounds.each do |(phase, round), matches| %>
      <%= surface_card(title: round == "sem_rodada" ? phase : "#{phase} · Rodada #{round}", subtitle: "#{matches.size} partida(s)") do %>
        <div class="grid gap-3 xl:grid-cols-2">
          <% matches.each do |match| %>
            <%= match_card(match, compact: true, legacy_match: false) %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%= empty_state(title: "Nenhuma rodada cadastrada", description: "As rodadas aparecerão aqui quando as partidas forem organizadas.") %>
<% end %>
