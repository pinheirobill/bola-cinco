<% content_for :title, "#{@championship.name} | Classificação | Arena" %>

<%= page_header(
  title: "#{@championship.name} · Classificação",
  subtitle: "Tabela consolidada das duplas da Tranca.",
  badge: @championship.status.to_s.tr("_", " ").humanize,
  actions: [
    link_to("Início", championship_path(@championship), class: "btn btn-outline"),
    link_to("Duplas", duplas_championship_path(@championship), class: "btn btn-outline"),
    link_to("Partidas", partidas_championship_path(@championship), class: "btn btn-outline"),
    link_to("Rodadas", rodadas_championship_path(@championship), class: "btn btn-primary"),
    link_to("Programação", programacao_championship_path(@championship), class: "btn btn-outline"),
    link_to("Baixar classificação (PDF)", classificacao_championship_path(@championship, format: :pdf), class: "btn btn-outline", data: { turbo: false }),
    link_to("Programação (PDF)", programacao_championship_path(@championship, format: :pdf), class: "btn btn-outline", data: { turbo: false }),
    link_to("Jogos por mesa (Excel)", championship_tranca_games_path(@championship, order: :mesa), class: "btn btn-outline", data: { turbo: false }),
    link_to("Jogos por nome (Excel)", championship_tranca_games_path(@championship, order: :name), class: "btn btn-outline", data: { turbo: false })
  ]
) %>

<%= render "championships/championship_logo_banner",
  championship: @championship,
  label: "Logo do campeonato",
  subtitle: "Essa arte também aparece nos PDFs baixados e nas telas públicas da Tranca." %>

<%= stats_grid([
  { label: "Grupos", value: @tranca_standing_groups.size, value_class: "text-2xl" },
  { label: "Linhas", value: @tranca_total_classificados, value_class: "text-2xl" },
  { label: "Partidas", value: @tranca_total_partidas, value_class: "text-2xl" },
  { label: "Duplas", value: @tranca_total_duplas, value_class: "text-2xl" }
]) %>

<% manage_classification = user_signed_in? && @championship.manageable_by?(current_user) %>

<div data-controller="classification-navigation">
<%= surface_card(
  title: "Tabela da Tranca",
  subtitle: "Classificação consolidada por categoria.",
  actions: [
    (manage_classification ? button_to(
      "Atualizar pontuação",
      rebuild_tranca_classificacao_championship_path(@championship),
      method: :patch,
      class: "btn btn-primary btn-sm",
      form: { data: { turbo_confirm: "Atualizar a pontuação agora? Isso vai manter as chaves atuais e só refazer os pontos e posições." } }
    ) : nil)
  ].compact
) do %>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div class="join">
      <button type="button" class="btn btn-sm join-item btn-primary" data-stage="1" data-classification-navigation-target="stageButton" data-action="classification-navigation#showStage">Etapa 1</button>
      <button type="button" class="btn btn-sm join-item" data-stage="2" data-classification-navigation-target="stageButton" data-action="classification-navigation#showStage">Etapa 2</button>
    </div>
    <div class="join">
      <button type="button" class="btn btn-sm join-item" data-classification-navigation-target="previous" data-action="classification-navigation#previous" aria-label="Chave anterior">←</button>
      <span class="btn btn-sm join-item pointer-events-none" data-classification-navigation-target="counter">1 de 1 chaves</span>
      <button type="button" class="btn btn-sm join-item" data-classification-navigation-target="next" data-action="classification-navigation#next" aria-label="Próxima chave">→</button>
    </div>
  </div>
  <div class="space-y-6">
    <% if @tranca_standing_groups.any? %>
      <% classification_position = 0 %>
      <% @tranca_standing_groups.each do |group| %>
        <% category_duplas = @tranca_duplas_by_category[group.category.id] || [] %>
        <div data-classification-navigation-target="group" data-stage="<%= group.rows.first&.stage_number || 1 %>" class="<%= "hidden" if group.rows.first&.stage_number.to_i == 2 %>">
          <div class="mb-3 flex items-center justify-between gap-3">
            <div>
              <h3 class="text-xl font-bold"><%= group.category.name %></h3>
              <% if group.group_key.present? %>
                <p class="mt-1 text-xs uppercase tracking-[0.25em] text-base-content/50"><%= tranca_group_key_label(group.group_key) || group.group_key %></p>
              <% end %>
            </div>
            <div class="flex items-center gap-2">
              <span class="badge badge-outline"><%= group.rows.size %> linhas</span>
              <% if manage_classification && group.group_key.present? %>
                <%= button_to "Excluir chave", destroy_tranca_programacao_key_championship_path(@championship, group_key: group.group_key), method: :delete, class: "btn btn-outline btn-error btn-xs", form: { data: { turbo_confirm: "Excluir a chave #{tranca_group_key_label(group.group_key) || group.group_key} e todas as suas partidas?" } } %>
                <button type="button" class="btn btn-outline btn-xs" onclick="document.getElementById('tranca-classificacao-group-<%= group.category.id %>-<%= group.group_key.parameterize %>').showModal()">
                  Gerenciar chave
                </button>
              <% end %>
            </div>
          </div>

          <div class="overflow-x-auto">
            <%= standing_table(group.category, group.rows, group_key: group.group_key, position_offset: classification_position, tranca: true, show_header: false) %>
          </div>

          <% if manage_classification && group.group_key.present? %>
            <dialog id="tranca-classificacao-group-<%= group.category.id %>-<%= group.group_key.parameterize %>" class="modal">
              <div class="modal-box max-w-3xl">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h2 class="text-2xl font-bold">Gerenciar chave <%= tranca_group_key_label(group.group_key) || group.group_key %></h2>
                    <p class="mt-1 text-sm text-base-content/70"><%= group.category.name %></p>
                  </div>
                  <button type="button" class="btn btn-ghost btn-sm" onclick="document.getElementById('tranca-classificacao-group-<%= group.category.id %>-<%= group.group_key.parameterize %>').close()">Fechar</button>
                </div>

                <div class="mt-6 space-y-6">
                  <% available_duplas = category_duplas.reject { |dupla| group.rows.any? { |row| row.tranca_dupla_id == dupla.id } } %>

                  <div class="border-b border-base-300 pb-5">
                    <%= form_with url: append_tranca_classificacao_row_from_existing_dupla_championship_path(@championship), method: :post, class: "space-y-4" do %>
                      <%= hidden_field_tag :category_id, group.category.id %>
                      <%= hidden_field_tag :group_key, group.group_key %>
                      <p class="text-sm font-semibold">Adicionar linha na chave</p>
                      <div class="grid gap-4 md:grid-cols-2">
                        <div class="form-control">
                          <%= label_tag "tranca_classificacao_row_tranca_dupla_id", "Dupla cadastrada", class: "label-text font-medium" %>
                          <%= select_tag "tranca_classificacao_row[tranca_dupla_id]",
                            options_from_collection_for_select(available_duplas, :id, :name),
                            class: "select select-bordered w-full",
                            required: true,
                            prompt: "Selecione uma dupla" %>
                        </div>

                        <div class="rounded-2xl bg-base-200 p-4 text-sm text-base-content/70">
                          A nova linha entra no fim da chave e mantém as demais posições.
                        </div>
                      </div>

                      <div class="modal-action">
                        <button type="button" class="btn btn-ghost" onclick="document.getElementById('tranca-classificacao-group-<%= group.category.id %>-<%= group.group_key.parameterize %>').close()">Cancelar</button>
                        <%= button_tag "Adicionar linha", type: :submit, class: "btn btn-primary" %>
                      </div>
                    <% end %>
                  </div>

                  <%= form_with url: update_tranca_classificacao_row_championship_path(@championship), method: :patch, class: "space-y-4" do %>
                    <p class="text-sm font-semibold">Substituir dupla da linha</p>
                    <div class="grid gap-4 md:grid-cols-2">
                      <div class="form-control">
                        <%= label_tag nil, "Linha da chave", class: "label-text font-medium" %>
                        <%= select_tag :row_id, options_from_collection_for_select(group.rows, :id, :dupla_nome), class: "select select-bordered w-full", required: true %>
                      </div>

                      <div class="form-control">
                        <%= label_tag "tranca_classificacao_row_tranca_dupla_id", "Dupla cadastrada", class: "label-text font-medium" %>
                        <%= select_tag "tranca_classificacao_row[tranca_dupla_id]",
                          options_from_collection_for_select(category_duplas, :id, :name),
                          class: "select select-bordered w-full",
                          required: true %>
                      </div>
                    </div>

                    <div class="modal-action">
                      <button type="button" class="btn btn-ghost" onclick="document.getElementById('tranca-classificacao-group-<%= group.category.id %>-<%= group.group_key.parameterize %>').close()">Cancelar</button>
                      <%= button_tag "Trocar dupla", type: :submit, class: "btn btn-primary" %>
                    </div>
                  <% end %>

                  <div class="border-t border-base-300 pt-5">
                    <%= form_with url: destroy_tranca_classificacao_row_championship_path(@championship), method: :delete, class: "space-y-4" do %>
                      <p class="text-sm font-semibold">Remover linha da chave</p>
                      <div class="grid gap-4 md:grid-cols-2">
                        <div class="form-control">
                          <%= label_tag nil, "Linha da chave", class: "label-text font-medium" %>
                          <%= select_tag :row_id, options_from_collection_for_select(group.rows, :id, :dupla_nome), class: "select select-bordered w-full", required: true %>
                        </div>

                        <div class="rounded-2xl bg-base-200 p-4 text-sm text-base-content/70">
                          Remove a dupla selecionada e puxa as posições abaixo para cima.
                        </div>
                      </div>

                      <div class="modal-action">
                        <button type="button" class="btn btn-ghost" onclick="document.getElementById('tranca-classificacao-group-<%= group.category.id %>-<%= group.group_key.parameterize %>').close()">Cancelar</button>
                        <%= button_tag "Remover linha", type: :submit, class: "btn btn-outline btn-error" %>
                      </div>
                    <% end %>
                  </div>

                  <% if @recent_tranca_source_teams.present? %>
                    <div class="border-t border-base-300 pt-5">
                      <div class="mb-3 flex items-center justify-between gap-3">
                        <div>
                          <p class="text-sm font-semibold">Duplas recentes</p>
                          <p class="mt-1 text-xs text-base-content/60">Mostra o status da inscrição para escolher a que entra no lugar.</p>
                        </div>
                        <span class="badge badge-outline"><%= @recent_tranca_source_teams.size %></span>
                      </div>

                      <div class="grid gap-3 md:grid-cols-2">
                        <% @recent_tranca_source_teams.each do |team| %>
                          <div class="rounded-2xl border border-base-300 bg-base-100 p-4">
                            <%= form_with url: replace_tranca_classificacao_row_from_recent_team_championship_path(@championship), method: :patch, class: "space-y-3" do %>
                              <%= hidden_field_tag :team_id, team.id %>
                              <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                  <p class="font-semibold"><%= team.name %></p>
                                  <p class="mt-1 text-xs text-base-content/60"><%= team.source_championship.name %> · <%= team.source_category.name %></p>
                                </div>
                                <div class="flex flex-col items-end gap-2">
                                  <%= status_badge(team.registration_status) %>
                                  <% if team.athletes.blank? %>
                                    <span class="badge badge-outline">Vazia</span>
                                  <% end %>
                                </div>
                              </div>

                              <p class="text-xs text-base-content/60"><%= team.entity&.name || "Sem entidade" %></p>

                              <div class="grid gap-2">
                                <%= label_tag nil, "Linha da chave", class: "label-text text-xs font-medium" %>
                                <%= select_tag :row_id, options_from_collection_for_select(group.rows, :id, :dupla_nome), class: "select select-bordered select-sm w-full", required: true %>
                              </div>

                              <div class="flex flex-wrap justify-end gap-2">
                                <%= button_tag "Usar nesta chave", type: :submit, class: "btn btn-primary btn-xs", data: { turbo_confirm: "Convidar #{team.name} e usar como substituta da chave #{tranca_group_key_label(group.group_key) || group.group_key}?" } %>
                              </div>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>

                </div>
              </div>
              <form method="dialog" class="modal-backdrop"><button>Fechar</button></form>
            </dialog>
          <% end %>
        </div>
        <% classification_position += group.rows.size %>
      <% end %>
    <% else %>
      <%= empty_state(
        title: "Sem classificação consolidada",
        description: "Quando os resultados forem processados, a tabela vai aparecer aqui."
      ) %>
    <% end %>
  </div>
<% end %>
</div>

<% if user_signed_in? && @championship.manageable_by?(current_user) && @tranca_knockout_qualified_rows.any? && !@tranca_knockout_selection_done %>
  <%= surface_card(title: "Montar mata-mata", subtitle: "Escolha a estrutura da chave e a regra de classificação antes de gerar o primeiro confronto eliminatório.") do %>
    <button type="button" class="btn btn-primary" onclick="document.getElementById('tranca-knockout-selection-modal').showModal()">
      Configurar mata-mata
    </button>
  <% end %>

  <dialog id="tranca-knockout-selection-modal" class="modal">
    <div class="modal-box max-w-5xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold">Configurar mata-mata</h2>
          <p class="mt-1 text-sm text-base-content/70">Primeiro escolhemos o tamanho da chave. Depois definimos quantas duplas avançam por chave e quais entram por pontuação.</p>
        </div>
        <button type="button" class="btn btn-ghost btn-sm" onclick="document.getElementById('tranca-knockout-selection-modal').close()">Fechar</button>
      </div>

      <%= form_with url: select_tranca_knockout_duplas_championship_path(@championship), method: :post, class: "mt-6 space-y-6" do %>
        <div class="grid gap-4 md:grid-cols-2">
          <div class="form-control">
            <%= label_tag :knockout_stage_type, "Tipo de chave", class: "label-text font-medium" %>
            <%= select_tag :knockout_stage_type,
              options_for_select(@tranca_knockout_stage_type_options, @tranca_knockout_stage_type),
              class: "select select-bordered w-full",
              data: { knockout_stage_type: true } %>
            <p class="mt-2 text-sm text-base-content/60">Define se o mata-mata começa nas oitavas, quartas ou semifinais.</p>
          </div>

          <div class="form-control">
            <%= label_tag :qualified_per_group, "Classificados por chave", class: "label-text font-medium" %>
            <%= number_field_tag :qualified_per_group, @tranca_knockout_qualified_per_group, min: 1, step: 1, class: "input input-bordered w-full", data: { qualified_per_group: true } %>
            <p class="mt-2 text-sm text-base-content/60">1, 2, 3, 4, 5... Se faltar vaga, o sistema completa com as melhores pontuadas restantes.</p>
          </div>
        </div>

        <div class="rounded-2xl border border-base-300 bg-base-100 p-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Prévia</p>
              <p class="mt-1 text-sm text-base-content/70" data-knockout-preview-summary>
                <%= @tranca_knockout_preview[:direct_rows].size %> classificados diretos + <%= @tranca_knockout_preview[:backup_rows].size %> duplas por pontuação para fechar <%= @tranca_knockout_preview[:target_slots] %> vagas.
              </p>
            </div>
            <span class="badge badge-outline" data-knockout-preview-slots><%= @tranca_knockout_preview[:target_slots] %> vagas</span>
          </div>

          <div class="mt-4 grid gap-4 lg:grid-cols-2">
            <section>
              <div class="mb-3 flex items-center justify-between gap-3">
                <h3 class="text-lg font-semibold">Classificados diretos</h3>
                <span class="badge badge-success" data-knockout-direct-count><%= @tranca_knockout_preview[:direct_rows].size %></span>
              </div>
              <div class="grid gap-2 md:grid-cols-2" data-knockout-direct-list>
                <% @tranca_knockout_preview[:direct_rows].each do |row| %>
                  <div class="rounded-xl border border-success/30 bg-success/10 p-3">
                    <p class="text-xs uppercase tracking-[0.2em] text-base-content/50"><%= row.group_key.presence || "Classificação geral" %> · <%= row.position %>º</p>
                    <p class="mt-1 font-semibold"><%= row.tranca_dupla.name %></p>
                    <p class="text-xs text-base-content/60"><%= row.points %> pts · <%= row.goal_diff %> SG</p>
                  </div>
                <% end %>
              </div>
            </section>

            <section>
              <div class="mb-3 flex items-center justify-between gap-3">
                <h3 class="text-lg font-semibold">Melhores pontuadas para completar</h3>
                <span class="badge badge-primary" data-knockout-backup-count><%= @tranca_knockout_preview[:backup_rows].size %></span>
              </div>
              <div class="grid gap-2 md:grid-cols-2" data-knockout-backup-list>
                <% @tranca_knockout_preview[:backup_rows].each do |row| %>
                  <div class="rounded-xl border border-primary/20 bg-primary/10 p-3">
                    <p class="text-xs uppercase tracking-[0.2em] text-base-content/50"><%= row.group_key.presence || "Classificação geral" %> · <%= row.position %>º</p>
                    <p class="mt-1 font-semibold"><%= row.tranca_dupla.name %></p>
                    <p class="text-xs text-base-content/60"><%= row.points %> pts · <%= row.goal_diff %> SG</p>
                  </div>
                <% end %>
              </div>
            </section>
          </div>

          <p class="mt-4 text-sm text-base-content/60">
            Se a soma dos classificados diretos não fechar as vagas do tipo escolhido, a lista acima mostra exatamente quem entra por pontuação.
          </p>
        </div>

        <div class="modal-action">
          <button type="button" class="btn btn-ghost" onclick="document.getElementById('tranca-knockout-selection-modal').close()">Cancelar</button>
          <%= submit_tag "Gerar mata-mata", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
    <form method="dialog" class="modal-backdrop"><button>Fechar</button></form>
  </dialog>

  <% knockout_preview_groups = @tranca_standing_groups.map do |group|
       {
         category: group.category.name,
         group_key: group.group_key.to_s,
         rows: group.rows.map do |row|
           {
             id: row.id,
             name: row.tranca_dupla.name,
             position: row.position.to_i,
             points: row.points.to_i,
             goal_diff: row.goal_diff.to_i,
             goals_for: row.goals_for.to_i
           }
         end
       }
     end %>

  <script>
    (() => {
      const modal = document.getElementById("tranca-knockout-selection-modal")
      if (!modal) return

      const groups = <%= raw json_escape(knockout_preview_groups.to_json) %>
      const stageTypeInput = modal.querySelector("[data-knockout-stage-type]")
      const qualifiedPerGroupInput = modal.querySelector("[data-qualified-per-group]")
      const summary = modal.querySelector("[data-knockout-preview-summary]")
      const slotsBadge = modal.querySelector("[data-knockout-preview-slots]")
      const directCount = modal.querySelector("[data-knockout-direct-count]")
      const backupCount = modal.querySelector("[data-knockout-backup-count]")
      const directList = modal.querySelector("[data-knockout-direct-list]")
      const backupList = modal.querySelector("[data-knockout-backup-list]")

      const stageSlots = {
        oitavas_quartas_semi_final: 16,
        quartas_semi_final: 8,
        semi_final: 4,
        final: 2
      }

      const rowCard = (row, variant) => {
        const borderClass = variant === "direct" ? "border-success/30 bg-success/10" : "border-primary/20 bg-primary/10"
        return `
          <div class="rounded-xl border ${borderClass} p-3">
            <p class="text-xs uppercase tracking-[0.2em] text-base-content/50">${row.group_key || "Classificação geral"} · ${row.position}º</p>
            <p class="mt-1 font-semibold">${row.name}</p>
            <p class="text-xs text-base-content/60">${row.points} pts · ${row.goal_diff} SG</p>
          </div>
        `
      }

      const buildPreview = () => {
        const stageType = stageTypeInput?.value || "oitavas_quartas_semi_final"
        const slots = stageSlots[stageType] || 16
        const qualifiedPerGroup = Math.max(1, parseInt(qualifiedPerGroupInput?.value, 10) || 1)

        const directRows = []
        groups.forEach((group) => {
          const orderedRows = [...group.rows].sort((left, right) => {
            if (left.position !== right.position) return left.position - right.position
            if (left.points !== right.points) return right.points - left.points
            if (left.goal_diff !== right.goal_diff) return right.goal_diff - left.goal_diff
            if (left.goals_for !== right.goals_for) return right.goals_for - left.goals_for
            return left.name.localeCompare(right.name)
          })
          orderedRows.slice(0, qualifiedPerGroup).forEach((row) => directRows.push({ ...row, group_key: group.group_key }))
        })

        const directIds = new Set(directRows.map((row) => row.id))
        const backupRows = groups.flatMap((group) =>
          group.rows.map((row) => ({ ...row, group_key: group.group_key, category: group.category }))
        ).filter((row) => !directIds.has(row.id)).sort((left, right) => {
          if (left.points !== right.points) return right.points - left.points
          if (left.goal_diff !== right.goal_diff) return right.goal_diff - left.goal_diff
          if (left.goals_for !== right.goals_for) return right.goals_for - left.goals_for
          if (left.position !== right.position) return left.position - right.position
          if (left.group_key !== right.group_key) return left.group_key.localeCompare(right.group_key)
          return left.name.localeCompare(right.name)
        }).slice(0, Math.max(slots - directRows.length, 0))

        summary.textContent = `${directRows.length} classificados diretos + ${backupRows.length} duplas por pontuação para fechar ${slots} vagas.`
        slotsBadge.textContent = `${slots} vagas`
        directCount.textContent = directRows.length
        backupCount.textContent = backupRows.length
        directList.innerHTML = directRows.map((row) => rowCard(row, "direct")).join("")
        backupList.innerHTML = backupRows.map((row) => rowCard(row, "backup")).join("")
      }

      stageTypeInput?.addEventListener("change", buildPreview)
      qualifiedPerGroupInput?.addEventListener("input", buildPreview)
      buildPreview()
    })()
  </script>
<% end %>

<% if @tranca_knockout_rounds.any? %>
  <%= render "components/tranca_knockout_bracket", rounds: @tranca_knockout_rounds %>
<% end %>
