<% content_for :title, "#{@championship.name} | Equipes | Arena" %>

<%= page_header(
  title: "#{@championship.name} · Equipes",
  subtitle: "Equipes inscritas e categorias deste campeonato.",
  badge: @championship.status.to_s.tr("_", " ").humanize
) %>
<%= render "championships/football_navigation", championship: @championship, current: "equipes" %>

<%= stats_grid([
  { label: "Equipes", value: @football_teams.size, value_class: "text-2xl" },
  { label: "Categorias", value: @football_categories.size, value_class: "text-2xl" },
  { label: "Atletas", value: @football_teams.sum { |team| team.athletes.size }, value_class: "text-2xl" },
  { label: "Partidas", value: @championship.matches.count, value_class: "text-2xl" }
]) %>

<% @football_categories.each do |category| %>
  <% category_actions = if @championship.manageable_by?(current_user)
    [
      link_to("Importar Excel", new_championship_team_import_path(@championship, category_id: category.id, return_to_championship_teams: "1"), class: "btn btn-outline btn-sm"),
      button_tag("Adicionar manualmente", type: "button", class: "btn btn-primary btn-sm", onclick: "document.getElementById('manual-team-dialog-#{category.id}').showModal()")
    ]
  else
    []
  end %>
  <%= surface_card(title: category.name, subtitle: "#{category.teams.size} equipe(s)", classes: "mt-6", id: "category-#{category.id}", actions: category_actions) do %>
    <% if category.teams.any? %>
      <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
        <% category.teams.sort_by { |team| team.name.to_s.downcase }.each do |team| %>
          <%= team_card(team, compact: true) %>
        <% end %>
      </div>
    <% else %>
      <%= empty_state(title: "Nenhuma equipe nesta categoria", description: "As equipes inscritas aparecerão aqui.") %>
    <% end %>
  <% end %>

  <% if category_actions.any? %>
    <dialog id="manual-team-dialog-<%= category.id %>" class="modal">
      <div class="modal-box">
        <h2 class="text-xl font-bold">Adicionar equipe · <%= category.name %></h2>
        <p class="mt-2 text-sm text-base-content/70">Cadastre a equipe diretamente nesta categoria. Você poderá importar os atletas depois.</p>
        <%= form_with url: create_football_team_championship_path(@championship), scope: :team, class: "mt-5 space-y-4" do |form| %>
          <%= form.hidden_field :category_id, value: category.id %>
          <div class="form-control gap-2">
            <%= form.label :name, "Nome da equipe", for: "manual-team-name-#{category.id}", class: "label-text font-medium" %>
            <%= form.text_field :name, id: "manual-team-name-#{category.id}", class: "input input-bordered w-full", required: true, maxlength: 255, autofocus: true %>
          </div>
          <div class="form-control gap-2">
            <%= form.label :short_name, "Nome curto", for: "manual-team-short-name-#{category.id}", class: "label-text font-medium" %>
            <%= form.text_field :short_name, id: "manual-team-short-name-#{category.id}", class: "input input-bordered w-full", maxlength: 40, placeholder: "Opcional" %>
          </div>
          <div class="flex flex-wrap justify-end gap-3">
            <button type="button" class="btn btn-ghost" onclick="document.getElementById('manual-team-dialog-<%= category.id %>').close()">Cancelar</button>
            <%= form.submit "Adicionar equipe", class: "btn btn-primary" %>
          </div>
        <% end %>
        <form method="dialog" class="modal-backdrop"><button>fechar</button></form>
      </div>
    </dialog>
  <% end %>
<% end %>
