<% content_for :title, "Equipes | Arena" %>

<%= page_header(
  title: "Equipes",
  subtitle: "Lista das equipes cadastradas no sistema.",
  badge: "Cadastro"
) %>

<%= stats_grid([
  { label: "Equipes", value: @teams.size, value_class: "text-2xl" },
  { label: "Categorias", value: @teams.map(&:category_id).compact.uniq.size, value_class: "text-2xl" }
], columns: "md:grid-cols-2") %>

<%= surface_card do %>
  <% if @teams.any? %>
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Equipe</th>
            <th>Entidade</th>
            <th>Categoria</th>
            <th>Atletas</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @teams.each do |team| %>
            <tr>
              <td>
                <div class="flex items-center gap-3">
                  <% if team.shield.attached? %>
                    <%= image_tag team.shield, alt: "Escudo de #{team.name}", class: "h-10 w-10 rounded-lg border border-base-300 bg-white object-contain p-1" %>
                  <% end %>
                  <span class="font-medium"><%= team.name %></span>
                </div>
              </td>
              <td><%= team.entity.name %></td>
              <td><%= team.category.name %></td>
              <td><%= team.athletes.size %></td>
              <td><%= link_to "Ver ficha", team_path(team), class: "link link-primary" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= empty_state(
      title: "Nenhuma equipe cadastrada",
      description: "As equipes aparecem aqui quando forem importadas ou criadas."
    ) %>
  <% end %>
<% end %>
