<% content_for :title, "Equipes | Bola Cinco" %>

<div class="card border border-base-300 bg-base-100 shadow-sm">
  <div class="card-body">
    <h1 class="text-3xl font-black">Equipes</h1>
    <div class="overflow-x-auto">
      <table class="table">
        <thead><tr><th>Equipe</th><th>Entidade</th><th>Categoria</th><th>Atletas</th><th></th></tr></thead>
        <tbody>
          <% @teams.each do |team| %>
            <tr>
              <td class="font-medium"><%= team.name %></td>
              <td><%= team.entity.name %></td>
              <td><%= team.category.name %></td>
              <td><%= team.athletes.size %></td>
              <td><%= link_to "Ver ficha", team_path(team), class: "link link-primary" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
