<% content_for :title, "#{@team.name} | Arena" %>

<%= page_header(
  title: @team.name,
  subtitle: "#{@team.entity.name} · #{@team.category.name}",
  badge: "Equipe",
  actions: [
    (@team.manageable_by?(current_user) ? link_to("Editar equipe", edit_team_path(@team), class: "btn btn-outline") : nil),
    (current_user&.admin? && @team.registration_status_pendente? ? button_to("Confirmar inscrição", confirm_registration_team_path(@team), method: :patch, class: "btn btn-primary", data: { turbo_confirm: "Confirmar a inscrição desta equipe?" }) : nil),
    (current_user&.admin? && @team.registration_status_pendente? ? button_to("Rejeitar inscrição", reject_registration_team_path(@team), method: :patch, class: "btn btn-outline btn-error", data: { turbo_confirm: "Rejeitar a inscrição desta equipe?" }) : nil)
  ].compact
) %>

<%= stats_grid([
  { label: "Inscrição", value: @team.registration_status.titleize, value_class: "text-2xl" },
  { label: "Financeiro", value: @team.finance_status.titleize, value_class: "text-2xl" },
  { label: "Atletas", value: @team.athletes.count, value_class: "text-2xl" }
], columns: "md:grid-cols-3") %>

<%= surface_card(
  title: "Campeonatos inscritos",
  subtitle: "Campeonatos que compartilham esta categoria da equipe."
) do %>
  <% if @team_championships.any? %>
    <div class="flex flex-wrap gap-3">
      <% @team_championships.each do |championship| %>
        <%= link_to championship_path(championship), class: "rounded-2xl border border-base-300 bg-base-200 px-4 py-3 transition hover:border-primary hover:bg-base-100" do %>
          <p class="font-semibold"><%= championship.name %></p>
          <p class="text-xs text-base-content/60"><%= championship.season %></p>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%= empty_state(
      title: "Nenhum campeonato vinculado",
      description: "Esta equipe ainda não aparece em um campeonato compartilhado pela categoria."
    ) %>
  <% end %>
<% end %>

<% if current_user&.admin? %>
  <%= surface_card(
    title: "Status da inscrição",
    subtitle: "Altere o status manualmente quando precisar corrigir a decisão anterior."
  ) do %>
    <%= form_with model: @team, url: team_path(@team), method: :patch, local: true, class: "grid gap-4 md:grid-cols-[minmax(0,1fr)_auto] md:items-end" do |f| %>
      <div>
        <label class="label">
          <span class="label-text font-medium">Status atual</span>
        </label>
        <%= f.select :registration_status,
          options_for_select(Team.registration_statuses.keys.map { |status| [status.titleize, status] }, @team.registration_status),
          {},
          class: "select select-bordered w-full" %>
        <p class="mt-2 text-sm text-base-content/60">
          Atual: <span class="font-semibold text-base-content"><%= @team.registration_status.titleize %></span>
        </p>
      </div>

      <div>
        <%= f.submit "Salvar status", class: "btn btn-primary w-full md:w-auto" %>
      </div>
    <% end %>
  <% end %>
<% end %>

<section class="grid gap-6 xl:grid-cols-2">
  <% can_manage_athletes = @team.manageable_by?(current_user) %>
  <%= surface_card(
    title: "Atletas",
    actions: [
      (can_manage_athletes ? button_tag("Vincular atleta", type: "button", class: "btn btn-outline btn-sm", onclick: "document.getElementById('team-athletes-modal').showModal()") : nil)
    ].compact
  ) do %>
    <div class="space-y-3">
      <% if @team_athletes.any? %>
        <% @team_athletes.each do |link| %>
          <% athlete = link.athlete %>
          <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-base-300 bg-base-200 p-4">
            <%= link_to athlete_path(athlete), class: "min-w-0 flex-1 rounded-xl transition hover:text-primary" do %>
              <p class="truncate text-lg font-bold"><%= athlete.name %></p>
              <p class="text-sm text-base-content/70">
                Nº <%= athlete.shirt_number.presence || "-" %> · <%= athlete.position.presence || "-" %> · <%= athlete.team&.name || "-" %>
              </p>
              <p class="truncate text-xs text-base-content/50">
                Vinculado em: <%= athlete.linked_teams.map(&:name).join(" · ") %>
              </p>
            <% end %>
            <% if can_manage_athletes %>
              <%= link_to "Remover", team_team_athlete_path(@team, link), data: { turbo_method: :delete, turbo_confirm: "Remover atleta da equipe?" }, class: "btn btn-outline btn-error btn-sm" %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <%= empty_state(
          title: "Nenhum atleta vinculado",
          description: "Os atletas desta equipe aparecerão aqui quando forem cadastrados."
        ) %>
      <% end %>
    </div>
  <% end %>

  <%= surface_card(title: "Jogos") do %>
    <div class="space-y-3">
      <% matches = (@team.home_matches + @team.away_matches).sort_by { |match| [match.scheduled_on || Date.new(9999), match.id] } %>
      <% if matches.any? %>
        <% matches.each do |match| %>
          <%= match_card(match, compact: true) %>
        <% end %>
        <% @tranca_matches.each do |partida| %>
          <%= render "components/tranca_partida_card", championship: partida.championship, partida: partida %>
        <% end %>
      <% elsif @tranca_matches.any? %>
        <% @tranca_matches.each do |partida| %>
          <%= render "components/tranca_partida_card", championship: partida.championship, partida: partida %>
        <% end %>
      <% else %>
        <%= empty_state(
          title: "Nenhum jogo encontrado",
          description: "Quando a equipe tiver partidas, elas aparecerão aqui."
        ) %>
      <% end %>
    </div>
  <% end %>
</section>

<% if can_manage_athletes %>
  <dialog id="team-athletes-modal" class="modal">
    <div class="modal-box max-w-5xl" data-controller="athlete-picker">
      <h3 class="text-2xl font-bold">Vincular atleta à equipe</h3>
      <p class="mt-2 text-sm text-base-content/70">
        Selecione um ou mais atletas cadastrados no sistema. Use a busca e o filtro por equipe atual para montar o time inteiro de uma vez.
      </p>

      <%= form_with(url: team_team_athletes_path(@team), scope: :team_athlete, class: "mt-6 space-y-4") do |f| %>
        <div class="grid gap-3 lg:grid-cols-[1fr_18rem_auto_auto] lg:items-end">
          <div>
            <label class="label">
              <span class="label-text font-medium">Buscar atleta</span>
            </label>
            <input
              type="search"
              placeholder="Nome, apelido, camisa, posição, time..."
              class="input input-bordered w-full"
              data-athlete-picker-target="search"
              data-action="input->athlete-picker#filter"
            >
          </div>

          <div>
            <label class="label">
              <span class="label-text font-medium">Equipe atual</span>
            </label>
            <select
              class="select select-bordered w-full"
              data-athlete-picker-target="teamFilter"
              data-action="change->athlete-picker#filter"
            >
              <option value="">Todas as equipes</option>
              <%= options_from_collection_for_select(@available_teams, :id, :picker_label) %>
            </select>
          </div>

          <div class="rounded-2xl bg-base-200 px-4 py-3 text-sm text-base-content/70">
            <p class="font-semibold text-base-content">Visíveis</p>
            <p class="mt-1 text-2xl font-black" data-athlete-picker-target="visibleCount"><%= @available_athletes.size %></p>
          </div>

          <div class="rounded-2xl bg-base-200 px-4 py-3 text-sm text-base-content/70">
            <p class="font-semibold text-base-content">Selecionados</p>
            <p class="mt-1 text-2xl font-black" data-athlete-picker-target="selectedCount">0</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-3">
          <button type="button" class="btn btn-outline btn-sm" data-action="athlete-picker#selectVisible">Selecionar todos os visíveis</button>
          <button type="button" class="btn btn-ghost btn-sm" data-action="athlete-picker#clearSelection">Limpar seleção</button>
        </div>

        <div class="max-h-[32rem] overflow-y-auto rounded-3xl border border-base-300 bg-base-100 p-3">
          <% if @available_athletes.any? %>
            <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
              <% @available_athletes.each do |athlete| %>
                <% linked_to_team = @team_athlete_ids.include?(athlete.id) %>
                <% athlete_team_ids = ([athlete.team_id] + athlete.linked_teams.map(&:id)).compact.uniq %>
                <label
                  class="group cursor-pointer rounded-2xl border border-base-300 bg-base-200 p-4 transition hover:border-primary hover:bg-base-100 <%= linked_to_team ? 'cursor-not-allowed' : '' %>"
                  data-athlete-picker-target="item"
                  data-search-index="<%= athlete.search_index %>"
                  data-team-id="<%= athlete.team_id %>"
                  data-team-ids="<%= athlete_team_ids.join(' ') %>"
                >
                  <%= check_box_tag "team_athlete[athlete_ids][]", athlete.id, false, class: "sr-only", disabled: linked_to_team, data: { action: "change->athlete-picker#refresh" } %>
                  <div class="rounded-2xl border border-transparent p-1 transition">
                    <div class="flex items-start gap-3">
                    <div class="avatar shrink-0">
                      <div class="h-14 w-14 rounded-full border border-base-300 bg-base-100">
                        <% if athlete.display_photo_url.present? %>
                          <%= image_tag athlete.display_photo_url, class: "h-full w-full object-cover" %>
                        <% else %>
                          <div class="flex h-full w-full items-center justify-center text-sm font-black text-base-content/70">
                            <%= athlete.initials %>
                          </div>
                        <% end %>
                      </div>
                    </div>

                      <div class="min-w-0 flex-1">
                        <div class="flex items-start justify-between gap-3">
                          <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-2">
                              <p class="truncate text-base font-bold"><%= athlete.name %></p>
                              <span class="badge badge-success badge-outline opacity-0 transition" data-athlete-picker-selected-mark>Selecionado</span>
                            <% if linked_to_team %>
                              <span class="badge badge-neutral badge-outline">Já está na equipe</span>
                            <% end %>
                          </div>
                          <p class="mt-1 text-xs uppercase tracking-[0.3em] text-base-content/50">Apelido / nome curto</p>
                          <p class="truncate text-sm font-semibold text-base-content/75"><%= athlete.quick_label %></p>
                          </div>
                          <div class="flex shrink-0 flex-col items-end gap-2">
                            <span class="badge badge-primary badge-outline">Camisa <%= athlete.shirt_number.presence || "-" %></span>
                            <span class="badge badge-neutral"><%= athlete.position.presence || "Sem posição" %></span>
                          </div>
                        </div>

                        <div class="mt-3 grid gap-2 text-xs text-base-content/65 sm:grid-cols-2">
                          <div class="rounded-xl bg-base-100 px-3 py-2">
                            <span class="block uppercase tracking-[0.25em] text-base-content/40">Equipe atual</span>
                            <span class="mt-1 block truncate font-semibold text-base-content"><%= athlete.team.picker_label %></span>
                          </div>
                          <div class="rounded-xl bg-base-100 px-3 py-2">
                            <span class="block uppercase tracking-[0.25em] text-base-content/40">Documento</span>
                            <span class="mt-1 block truncate font-semibold text-base-content"><%= athlete.preferred_document.presence || "Sem documento" %></span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </label>
              <% end %>
            </div>
          <% else %>
            <div class="rounded-2xl border border-dashed border-base-300 p-6 text-sm text-base-content/70">
              Não há atletas cadastrados disponíveis para vincular.
            </div>
          <% end %>
        </div>

        <div class="flex flex-wrap gap-3">
          <%= f.submit "Vincular selecionados", class: "btn btn-primary" %>
          <button type="button" class="btn btn-ghost" onclick="document.getElementById('team-athletes-modal').close()">Fechar</button>
        </div>
      <% end %>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>
<% end %>
