<% content_for :title, "Categorias | Bola Cinco" %>

<%= page_header(
  title: "Categorias",
  subtitle: "Agrupamentos do campeonato com acesso rápido para equipes e contexto financeiro.",
  badge: "Cadastro"
) %>

<%= stats_grid([
  { label: "Categorias", value: @categories.size, value_class: "text-2xl" },
  { label: "Campeonatos", value: @categories.flat_map(&:championships).map(&:id).uniq.size, value_class: "text-2xl" }
], columns: "md:grid-cols-2") %>

<%= surface_card do %>
  <% if @categories.any? %>
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Nome</th>
            <th>Campeonatos</th>
            <th>Equipes</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @categories.each do |category| %>
            <tr>
              <td class="font-medium"><%= category.name %></td>
              <td><%= category.championships.map(&:name).presence&.join(" · ") || category.championship_name || "-" %></td>
              <td><%= category.teams.size %></td>
              <td>
                <div class="flex items-center justify-end gap-2">
                  <%= link_to "Ver", category_path(category), class: "link link-primary" %>
                  <% if current_user&.admin? && current_championship.present? %>
                    <%= button_to "Duplicar como nova", duplicate_category_path(category), method: :post, class: "btn btn-outline btn-xs", data: { turbo_confirm: "Criar uma cópia disponível para vinculação?" } %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= empty_state(
      title: "Nenhuma categoria encontrada",
      description: "As categorias aparecem aqui quando o campeonato é importado ou configurado."
    ) %>
  <% end %>
<% end %>
