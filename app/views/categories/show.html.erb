<% content_for :title, "#{@category.name} | Bola Cinco" %>

<% title_editor = nil %>
<% if current_user&.admin? %>
  <% title_editor = capture do %>
    <%= form_with model: @category, url: category_path(@category), method: :patch, class: "space-y-3", data: { controller: "autosave-form", action: "input->autosave-form#queue change->autosave-form#queue focusout->autosave-form#queue turbo:submit-end->autosave-form#complete" } do %>
      <%= hidden_field_tag :autosave, "1", disabled: true, data: { autosave_form_target: "flag" } %>
      <div class="alert alert-info hidden shadow-sm" role="status" aria-live="polite" data-autosave-form-target="status">Salvando nome da categoria...</div>

      <div class="rounded-2xl border border-dashed border-base-300 bg-base-200/70 p-4">
        <div class="flex flex-wrap items-center gap-2 text-sm text-base-content/70">
          <span class="badge badge-info badge-outline badge-sm">Título editável</span>
          <span>Altere o nome abaixo. A mudança vale para todas as telas da categoria.</span>
        </div>

        <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-end">
          <div class="form-control flex-1 gap-2">
            <%= label_tag "category_name", "Nome da categoria", class: "label-text font-medium" %>
            <%= text_field_tag "category[name]", @category.name, id: "category_name", class: "input input-bordered w-full", placeholder: "Ex.: 11º TORNEIO DE TRACA E.C. PINHEIROS 2026" %>
          </div>

          <%= submit_tag "Salvar nome", class: "btn btn-primary sm:self-start" %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>

<%= page_header(
  title: @category.name,
  subtitle: @category.championships.map(&:name).presence&.join(" · ") || @category.championship_name || "Categoria compartilhada",
  badge: "#{@category.teams.size} equipes",
  actions: [
    (current_user&.admin? && current_championship.present? ? button_to("Duplicar como nova", duplicate_category_path(@category), method: :post, class: "btn btn-primary", data: { turbo_confirm: "Criar uma cópia disponível para vinculação?" }) : nil)
  ],
  title_editor: title_editor
) %>

<%= stats_grid([
  { label: "Equipe(s)", value: @category.teams.size, value_class: "text-2xl" },
  { label: "Campeonatos", value: @category.championships.size, value_class: "text-lg" }
], columns: "md:grid-cols-2") %>

<%= surface_card do %>
  <% if @category.teams.any? %>
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Equipe</th>
            <th>Entidade</th>
            <th>Inscrição</th>
            <th>Financeiro</th>
          </tr>
        </thead>
        <tbody>
          <% @category.teams.each do |team| %>
            <tr>
              <td><%= link_to team.name, team_path(team), class: "link link-primary" %></td>
              <td><%= team.entity.name %></td>
              <td><%= status_badge(team.registration_status) %></td>
              <td><%= status_badge(team.finance_status) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= empty_state(
      title: "Nenhuma equipe nesta categoria",
      description: "Quando a categoria receber equipes, elas vão aparecer nesta tabela."
    ) %>
  <% end %>
<% end %>
