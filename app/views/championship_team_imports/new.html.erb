<% import_title = @target_team ? "Importar atletas" : "Importar equipes e atletas" %>
<% content_for :title, "#{@championship.name} | #{import_title} | Arena" %>

<%= page_header(
  title: import_title,
  subtitle: @target_team ? "#{@championship.name} · #{@category.name} · #{@target_team.name}" : @championship.name,
  actions: [
    (@target_team ? link_to("Voltar à equipe", team_path(@target_team), class: "btn btn-outline") : nil),
    (!@target_team && @return_to_category && @category ? link_to("Voltar à categoria", category_path(@category), class: "btn btn-outline") : nil),
    (!@target_team && @return_to_championship_teams ? link_to("Voltar às equipes", equipes_championship_path(@championship, anchor: "category-#{@category&.id}"), class: "btn btn-outline") : nil),
    (!@target_team && !@return_to_category && !@return_to_championship_teams ? link_to("Voltar ao campeonato", championship_path(@championship), class: "btn btn-outline") : nil)
  ].compact
) %>

<section class="grid gap-6 xl:grid-cols-[1.05fr_0.95fr]">
  <%= surface_card(title: "1. Formato da planilha", subtitle: @target_team ? "Uma linha por atleta desta equipe." : "Uma linha por atleta. Linhas com o mesmo nome de equipe ficam juntas.") do %>
    <p class="text-base-content/70">
      Inclua a coluna obrigatória <strong>nome</strong><%= " e equipe" unless @target_team %>. Os demais dados são opcionais: <strong>numero</strong>, <strong>RG</strong>, <strong>CPF</strong>, <strong>D.Nascimento</strong>, <strong>email</strong>, <strong>celular</strong>, <strong>certidão de nascimento</strong>, <strong>posição</strong>, <strong>passaporte</strong>, <strong>título de eleitor</strong>, <strong>gênero</strong> e <strong>documento</strong>.
    </p>
    <div class="mt-4 rounded-2xl bg-base-200 p-4 text-sm text-base-content/70">
      <p><strong>Formato:</strong> envie um arquivo .xlsx de até 5 MB. Se houver RG, o sistema reaproveita o cadastro existente<%= @target_team ? " nesta equipe" : "" %>. Campos preenchidos não são sobrescritos.</p>
    </div>
  <% end %>

  <%= surface_card(title: "2. Importar planilha", subtitle: @target_team ? "Os atletas serão adicionados a #{@target_team.name}." : "A importação cria as equipes e os atletas de forma automática.") do %>
    <%= form_with url: championship_team_import_path(@championship), scope: :team_import, multipart: true, data: { turbo: false }, class: "space-y-5" do |form| %>
      <%= form.hidden_field :return_to_category, value: @return_to_category ? "1" : "0" %>
      <%= form.hidden_field :return_to_championship_teams, value: @return_to_championship_teams ? "1" : "0" %>
      <% if @target_team %>
        <%= form.hidden_field :team_id, value: @target_team.id %>
        <%= form.hidden_field :category_id, value: @category.id %>
        <div class="rounded-2xl border border-base-300 bg-base-200 p-4 text-sm">
          <p class="font-semibold"><%= @target_team.name %></p>
          <p class="text-base-content/65"><%= @category.name %></p>
        </div>
      <% else %>
      <div class="form-control gap-2">
        <%= form.label :category_id, "Categoria do campeonato", class: "label-text font-medium" %>
        <%= form.select :category_id,
              options_from_collection_for_select(@categories, :id, :name, @category&.id),
              { include_blank: @categories.any? ? "Selecione" : "Nenhuma categoria criada" },
              class: "select select-bordered w-full",
              required: true,
              disabled: @categories.blank? %>
      </div>
      <% end %>

      <div class="form-control gap-2">
        <%= form.label :file, "Planilha de atletas (.xlsx)", class: "label-text font-medium" %>
        <%= form.file_field :file, accept: ".xlsx", required: @categories.any?, class: "file-input file-input-bordered w-full", disabled: @categories.blank? %>
        <p class="text-sm text-base-content/60"><%= @target_team ? "Cada linha será cadastrada nesta equipe. As outras colunas opcionais podem ser omitidas." : "A coluna equipe define em qual equipe cada atleta será cadastrado. As outras colunas opcionais podem ser omitidas." %></p>
      </div>

      <% if @categories.any? %>
        <%= form.submit "Importar planilha", class: "btn btn-primary" %>
      <% else %>
        <div class="rounded-2xl bg-base-200 p-4 text-sm text-base-content/70">
          Nenhuma categoria foi criada ainda. Crie ao menos uma categoria para liberar o upload.
        </div>
        <%= link_to "Configurar campeonato", setup_championship_path(@championship), class: "btn btn-outline" %>
      <% end %>
    <% end %>
  <% end %>
</section>
