<% content_for :title, "#{@championship.name} | Importar equipes | Arena" %>

<%= page_header(
  title: "Importar equipes",
  subtitle: @championship.name,
  actions: [link_to("Voltar ao campeonato", championship_path(@championship), class: "btn btn-outline")]
) %>

<section class="grid gap-6 xl:grid-cols-[1.05fr_0.95fr]">
  <%= surface_card(title: "1. Formato da planilha", subtitle: "Use o modelo do Excel da equipe para importar várias equipes de uma vez.") do %>
    <p class="text-base-content/70">
      A planilha precisa ter as colunas <strong>equipe</strong>, <strong>numero</strong>, <strong>nome</strong>, <strong>RG</strong>, <strong>CPF</strong> e <strong>D.Nascimento</strong>.
      Cada linha vira um atleta. Linhas com o mesmo nome de equipe entram no mesmo time.
    </p>
    <div class="mt-4 rounded-2xl bg-base-200 p-4 text-sm text-base-content/70">
      <p><strong>Regra de vínculo:</strong> se houver RG, o atleta já cadastrado é reaproveitado. Se só houver nome, um novo atleta é criado.</p>
    </div>
  <% end %>

  <%= surface_card(title: "2. Enviar planilha", subtitle: "A importação cria as equipes e os atletas de forma automática.") do %>
    <%= form_with url: championship_team_import_path(@championship), scope: :team_import, multipart: true, data: { turbo: false }, class: "space-y-5" do |form| %>
      <div class="form-control gap-2">
        <%= form.label :category_id, "Categoria do campeonato", class: "label-text font-medium" %>
        <%= form.select :category_id,
              options_from_collection_for_select(@categories, :id, :name, @category&.id),
              { include_blank: @categories.any? ? "Selecione" : "Nenhuma categoria criada" },
              class: "select select-bordered w-full",
              required: true,
              disabled: @categories.blank? %>
      </div>

      <div class="form-control gap-2">
        <%= form.label :file, "Planilha de equipes (.xlsx)", class: "label-text font-medium" %>
        <%= form.file_field :file, accept: ".xlsx", required: @categories.any?, class: "file-input file-input-bordered w-full", disabled: @categories.blank? %>
        <p class="text-sm text-base-content/60">Use a aba "Atletas" e mantenha os cabeçalhos do modelo do Excel.</p>
      </div>

      <% if @categories.any? %>
        <%= form.submit "Importar planilha", class: "btn btn-primary" %>
      <% else %>
        <div class="rounded-2xl bg-base-200 p-4 text-sm text-base-content/70">
          Nenhuma categoria foi criada ainda. Crie ao menos uma categoria para liberar o upload.
        </div>
        <%= link_to "Configurar campeonato", setup_championship_path(@championship), class: "btn btn-outline" %>
      <% end %>
    <% end %>
  <% end %>
</section>
