<% content_for :title, "#{@entity.name} | Bola Cinco" %>

<%= page_header(
  title: @entity.name,
  subtitle: @entity.city.presence || "Cidade não informada",
  badge: "Entidades"
) %>

<%= stats_grid([
  { label: "Equipes", value: @entity.teams.size, value_class: "text-2xl" }
], columns: "md:grid-cols-1") %>

<%= surface_card(title: "Equipes vinculadas") do %>
  <div class="space-y-3">
    <% if @entity.teams.any? %>
      <% @entity.teams.each do |team| %>
        <%= team_card(team, compact: true) %>
      <% end %>
    <% else %>
      <%= empty_state(
        title: "Nenhuma equipe vinculada",
        description: "Quando a entidade tiver equipes associadas, elas aparecerão aqui."
      ) %>
    <% end %>
  </div>
<% end %>
