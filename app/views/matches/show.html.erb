<% content_for :title, "#{@match.code} | Arena" %>
<% can_manage_match = @match.championship.manageable_by?(current_user) %>

<%= page_header(
  title: @match.code,
  subtitle: "#{@match.category.name} · #{[@match.team_a&.name, @match.team_b&.name].compact.join(' x ')}",
  badge: "Jogos",
  actions: [
    link_to("Voltar à programação", programacao_championship_path(@match.championship), class: "btn btn-outline"),
    (can_manage_match ? link_to("Editar súmula", edit_match_path(@match), class: "btn btn-outline") : nil),
    (can_manage_match ? button_tag("Importar súmula", type: "button", class: "btn btn-primary", onclick: "document.getElementById('match-summula-import-modal').showModal()") : nil),
    link_to("Classificação", standing_rows_path, class: "btn btn-primary")
  ].compact
) %>

<% if can_manage_match %>
<dialog id="match-summula-import-modal" class="modal">
  <div class="modal-box max-w-2xl">
    <h3 class="text-2xl font-bold">Importar súmula</h3>
    <p class="mt-2 text-sm text-base-content/70">
      Envie o PDF da súmula para comparar o que foi detectado com o jogo atual e confirmar equipe e atletas antes de salvar.
    </p>

    <%= form_with url: import_summula_match_path(@match), method: :post, multipart: true, class: "mt-6 space-y-4", data: { turbo: false } do %>
      <div class="form-control gap-2">
        <label class="label-text font-medium" for="match_summula_import_pdf">PDF ou foto da súmula</label>
        <input id="match_summula_import_pdf" type="file" name="match_summula_import[pdf]" accept="application/pdf,image/*,.pdf,.jpg,.jpeg,.png" class="file-input file-input-bordered w-full" required>
      </div>

      <div class="rounded-2xl border border-dashed border-base-300 bg-base-200 p-4 text-sm text-base-content/70">
        Se vier PDF com texto extraível, o sistema tenta sugerir times e jogadores. Se for foto ou a leitura falhar, a tela seguinte abre no modo manual com o <strong>de/para</strong> para conferência.
      </div>

      <div class="modal-action">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('match-summula-import-modal').close()">Cancelar</button>
        <button type="submit" class="btn btn-primary">Enviar PDF</button>
      </div>
    <% end %>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>
<% end %>

<div class="mb-6 rounded-3xl border border-base-300 bg-base-100 p-5 shadow-sm md:p-7">
  <p class="mb-4 text-center text-xs font-semibold uppercase tracking-[0.3em] text-base-content/50">
    <%= @match.status_finalizado? || @match.status_wo? ? "Placar final" : "Placar" %>
  </p>
  <div class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-3 md:gap-8">
    <p class="truncate text-right text-lg font-black md:text-2xl"><%= @match.team_a_label.presence || "Equipe A" %></p>
    <div class="flex items-center gap-2 md:gap-4" aria-label="Placar <%= @match.score_a || '-' %> a <%= @match.score_b || '-' %>">
      <span class="text-4xl font-black tabular-nums tracking-tight md:text-6xl"><%= @match.score_a || "–" %></span>
      <span class="text-xl font-bold text-base-content/45 md:text-3xl">×</span>
      <span class="text-4xl font-black tabular-nums tracking-tight md:text-6xl"><%= @match.score_b || "–" %></span>
    </div>
    <p class="truncate text-left text-lg font-black md:text-2xl"><%= @match.team_b_label.presence || "Equipe B" %></p>
  </div>
</div>

<%= stats_grid([
  { label: "Status", value: @match.status.titleize, value_class: "text-2xl" },
  { label: "Campeonato", value: @match.championship.name, value_class: "text-lg" }
], columns: "md:grid-cols-2") %>

<section id="cabecalho" class="grid gap-6 xl:grid-cols-[1.15fr_0.85fr]">
  <%= surface_card(
    title: "Cabeçalho da súmula",
    subtitle: "Os dados centrais do jogo seguem em destaque, como na folha impressa."
  ) do %>
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-3xl border border-base-300 bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Competição</p>
        <p class="mt-2 text-lg font-semibold"><%= @match.championship.name %></p>
      </div>
      <div class="rounded-3xl border border-base-300 bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Categoria</p>
        <p class="mt-2 text-lg font-semibold"><%= @match.category.name %></p>
      </div>
      <div class="rounded-3xl border border-base-300 bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Ginásio / Campo</p>
        <p class="mt-2 text-lg font-semibold"><%= @match.venue_name || "-" %></p>
      </div>
      <div class="rounded-3xl border border-base-300 bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Data e hora</p>
        <p class="mt-2 text-lg font-semibold">
          <%= [@match.scheduled_on&.strftime("%d/%m/%Y"), @match.scheduled_time].compact.join(" · ").presence || "-" %>
        </p>
      </div>
      <div class="rounded-3xl border border-base-300 bg-base-200 p-4 md:col-span-2">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Partida</p>
        <p class="mt-2 text-2xl font-black tracking-tight">
          <%= [@match.team_a&.name, @match.team_b&.name].compact.join(" x ") %>
        </p>
      </div>
    </div>
  <% end %>

  <%= surface_card(
    title: "Resumo técnico",
    subtitle: "Status da súmula, árbitro e controles rápidos."
  ) do %>
    <div class="space-y-3 text-sm">
      <div class="rounded-2xl bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Relatório</p>
        <p class="mt-2 font-semibold"><%= @match_report.status.titleize %></p>
      </div>
      <div class="rounded-2xl bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Árbitro</p>
        <p class="mt-2 font-semibold"><%= @match_report.referee&.name || "-" %></p>
      </div>
      <div class="rounded-2xl bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Súmula</p>
        <p class="mt-2 font-semibold"><%= @match_report.sheet_url.presence || "-" %></p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="rounded-2xl bg-base-200 p-4">
          <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Enviado</p>
          <p class="mt-2 font-semibold"><%= @match_report.submitted_at.present? ? l(@match_report.submitted_at, format: :short) : "-" %></p>
        </div>
        <div class="rounded-2xl bg-base-200 p-4">
          <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Aprovado</p>
          <p class="mt-2 font-semibold"><%= @match_report.approved_at.present? ? l(@match_report.approved_at, format: :short) : "-" %></p>
        </div>
      </div>
    </div>
  <% end %>
</section>

<section id="escalacoes" class="grid gap-6 xl:grid-cols-2">
  <%= surface_card(title: @match.team_a_label.presence || "Equipe A") do %>
    <% if @team_a_athletes.any? %>
      <div class="overflow-hidden rounded-3xl border border-base-300">
        <table class="table">
          <thead class="bg-base-200">
            <tr>
              <th>Nº</th>
              <th>Atleta</th>
              <th>Posição</th>
            </tr>
          </thead>
          <tbody>
            <% @team_a_athletes.each do |athlete| %>
              <tr>
                <td class="font-semibold"><%= athlete.shirt_number.presence || "-" %></td>
                <td>
                  <div class="font-medium"><%= athlete.name %></div>
                  <div class="text-xs text-base-content/50"><%= athlete.registration_label.strftime("%d/%m/%Y %H:%M") %></div>
                  <% events = Array(@athlete_events[athlete.id]) %>
                  <% goals = events.select(&:kind_gol?) %>
                  <% yellow_cards = events.count(&:kind_cartao_amarelo?) %>
                  <% red_cards = events.count(&:kind_cartao_vermelho?) %>
                  <% if goals.any? || yellow_cards.positive? || red_cards.positive? %>
                    <div class="mt-2 flex flex-wrap gap-1" aria-label="Eventos de <%= athlete.name %>">
                      <% if goals.any? %>
                        <span class="badge badge-success badge-sm" title="Gols marcados">
                          ⚽ <%= goals.size %><%= " · #{goals.filter_map { |event| event.minute.presence }.join(', ')}′" if goals.any? { |event| event.minute.present? } %>
                        </span>
                      <% end %>
                      <% if yellow_cards.positive? %>
                        <span class="badge badge-warning badge-sm" title="Cartões amarelos">🟨 <%= yellow_cards %></span>
                      <% end %>
                      <% if red_cards.positive? %>
                        <span class="badge badge-error badge-sm" title="Cartões vermelhos">🟥 <%= red_cards %></span>
                      <% end %>
                    </div>
                  <% end %>
                </td>
                <td><%= athlete.position.presence || "-" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state(
        title: "Sem atletas na equipe A",
        description: "A escalação aparecerá aqui quando os atletas forem associados ao time."
      ) %>
    <% end %>
  <% end %>

  <%= surface_card(title: @match.team_b_label.presence || "Equipe B") do %>
    <% if @team_b_athletes.any? %>
      <div class="overflow-hidden rounded-3xl border border-base-300">
        <table class="table">
          <thead class="bg-base-200">
            <tr>
              <th>Nº</th>
              <th>Atleta</th>
              <th>Posição</th>
            </tr>
          </thead>
          <tbody>
            <% @team_b_athletes.each do |athlete| %>
              <tr>
                <td class="font-semibold"><%= athlete.shirt_number.presence || "-" %></td>
                <td>
                  <div class="font-medium"><%= athlete.name %></div>
                  <div class="text-xs text-base-content/50"><%= athlete.registration_label.strftime("%d/%m/%Y %H:%M") %></div>
                  <% events = Array(@athlete_events[athlete.id]) %>
                  <% goals = events.select(&:kind_gol?) %>
                  <% yellow_cards = events.count(&:kind_cartao_amarelo?) %>
                  <% red_cards = events.count(&:kind_cartao_vermelho?) %>
                  <% if goals.any? || yellow_cards.positive? || red_cards.positive? %>
                    <div class="mt-2 flex flex-wrap gap-1" aria-label="Eventos de <%= athlete.name %>">
                      <% if goals.any? %>
                        <span class="badge badge-success badge-sm" title="Gols marcados">
                          ⚽ <%= goals.size %><%= " · #{goals.filter_map { |event| event.minute.presence }.join(', ')}′" if goals.any? { |event| event.minute.present? } %>
                        </span>
                      <% end %>
                      <% if yellow_cards.positive? %>
                        <span class="badge badge-warning badge-sm" title="Cartões amarelos">🟨 <%= yellow_cards %></span>
                      <% end %>
                      <% if red_cards.positive? %>
                        <span class="badge badge-error badge-sm" title="Cartões vermelhos">🟥 <%= red_cards %></span>
                      <% end %>
                    </div>
                  <% end %>
                </td>
                <td><%= athlete.position.presence || "-" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state(
        title: "Sem atletas na equipe B",
        description: "A escalação aparecerá aqui quando os atletas forem associados ao time."
      ) %>
    <% end %>
  <% end %>
</section>
<section class="grid gap-6 xl:grid-cols-2">
    <%= surface_card(
      title: "Melhores momentos",
    subtitle: "Vídeos do jogo, com suporte a links externos e arquivos de vídeo.",
    actions: [tag.span("#{@match.highlight_video_urls.size} vídeo(s)", class: "badge badge-outline")]
  ) do %>
    <% if @match.highlight_video_urls.present? %>
      <div class="grid gap-4 lg:grid-cols-2">
        <% @match.highlight_video_urls.each_with_index do |url, index| %>
          <div class="rounded-3xl border border-base-300 bg-base-200 p-4">
            <div class="mb-3 flex items-center justify-between gap-3">
              <div>
                <p class="font-semibold">Momento <%= index + 1 %></p>
                <p class="text-xs text-base-content/50 break-all"><%= url %></p>
              </div>
            </div>

            <%= video_frame_for(url) %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="alert alert-info mt-2">
        <span>Sem vídeos cadastrados para este jogo ainda.</span>
      </div>
    <% end %>
  <% end %>
</section>
