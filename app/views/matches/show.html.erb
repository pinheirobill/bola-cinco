<% content_for :title, "#{@match.code} | Bola Cinco" %>

<section class="card border border-base-300 bg-base-100 shadow-sm">
  <div class="card-body gap-4">
    <div>
      <div class="badge badge-outline">Jogos</div>
      <h1 class="mt-3 text-3xl font-black"><%= @match.code %></h1>
      <p class="text-sm text-base-content/70"><%= @match.category.name %> · <%= [@match.team_a&.name, @match.team_b&.name].compact.join(" x ") %></p>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      <div class="rounded-2xl bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Placar</p>
        <p class="mt-2 text-3xl font-black"><%= @match.score_a || "-" %> x <%= @match.score_b || "-" %></p>
      </div>
      <div class="rounded-2xl bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Status</p>
        <p class="mt-2"><%= status_badge(@match.status) %></p>
      </div>
      <div class="rounded-2xl bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Campeonato</p>
        <p class="mt-2 text-lg font-semibold"><%= @match.championship.name %></p>
      </div>
    </div>
  </div>
</section>

<section class="grid gap-6 xl:grid-cols-[1.2fr_1fr]">
  <div class="card border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body">
      <div class="flex items-center justify-between gap-4">
        <div>
          <h2 class="card-title text-2xl">Melhores momentos</h2>
          <p class="text-sm text-base-content/70">Vídeos do jogo, com suporte a links externos e arquivos de vídeo.</p>
        </div>
        <span class="badge badge-outline"><%= @match.highlight_video_urls.size %> vídeo(s)</span>
      </div>

      <% if @match.highlight_video_urls.present? %>
        <div class="grid gap-4 lg:grid-cols-2">
          <% @match.highlight_video_urls.each_with_index do |url, index| %>
            <div class="rounded-3xl border border-base-300 bg-base-200 p-4">
              <div class="mb-3 flex items-center justify-between gap-3">
                <div>
                  <p class="font-semibold">Momento <%= index + 1 %></p>
                  <p class="text-xs text-base-content/50 break-all"><%= url %></p>
                </div>
              </div>

              <%= video_frame_for(url) %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="alert alert-info mt-2">
          <span>Sem vídeos cadastrados para este jogo ainda.</span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="space-y-6">
    <div class="card border border-base-300 bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title text-2xl">Informações de jogo</h2>
        <div class="grid gap-3">
          <div class="rounded-2xl bg-base-200 p-4">
            <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Data</p>
            <p class="mt-2 font-semibold"><%= @match.scheduled_on&.strftime("%d/%m/%Y") || "-" %></p>
          </div>
          <div class="rounded-2xl bg-base-200 p-4">
            <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Hora</p>
            <p class="mt-2 font-semibold"><%= @match.scheduled_time.presence || "-" %></p>
          </div>
          <div class="rounded-2xl bg-base-200 p-4">
            <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Local</p>
            <p class="mt-2 font-semibold"><%= @match.venue.presence || "-" %></p>
          </div>
          <div class="rounded-2xl bg-base-200 p-4">
            <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Fase</p>
            <p class="mt-2 font-semibold"><%= @match.phase.tr("_", " ").humanize %></p>
          </div>
        </div>
      </div>
    </div>

    <div class="card border border-base-300 bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title text-2xl">Detalhes técnicos</h2>
        <div class="space-y-2 text-sm text-base-content/70">
          <p><strong>Decisão:</strong> <%= @match.decision.present? ? @match.decision.tr("_", " ").humanize : "-" %></p>
          <p><strong>W.O.:</strong> <%= @match.wo.presence || "-" %></p>
          <p><strong>Pênaltis:</strong> <%= [@match.penalties_a, @match.penalties_b].compact.join(" x ").presence || "-" %></p>
          <p><strong>Vencedor:</strong> <%= @match.winner&.name || "-" %></p>
        </div>
      </div>
    </div>
  </div>
</section>
