<%= surface_card(
  title: "Resumo instantâneo",
  subtitle: "Totais atuais dos lançamentos desta partida.",
  id: "match-event-summary"
) do %>
  <% goals = match_events.count(&:kind_gol?) %>
  <% yellow_cards = match_events.count(&:kind_cartao_amarelo?) %>
  <% red_cards = match_events.count(&:kind_cartao_vermelho?) %>
  <% substitutions = match_events.count(&:kind_substituicao?) %>
  <% total = match_events.size %>

  <div class="grid gap-3 grid-cols-2 md:grid-cols-5">
    <div class="rounded-2xl bg-base-200 px-4 py-3">
      <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Total</p>
      <p class="mt-1 text-2xl font-black"><%= total %></p>
    </div>
    <div class="rounded-2xl bg-base-200 px-4 py-3">
      <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Gols</p>
      <p class="mt-1 text-2xl font-black"><%= goals %></p>
    </div>
    <div class="rounded-2xl bg-warning/10 px-4 py-3">
      <p class="text-xs uppercase tracking-[0.25em] text-warning-content/60">Amarelos</p>
      <p class="mt-1 text-2xl font-black text-warning"><%= yellow_cards %></p>
    </div>
    <div class="rounded-2xl bg-error/10 px-4 py-3">
      <p class="text-xs uppercase tracking-[0.25em] text-error-content/60">Vermelhos</p>
      <p class="mt-1 text-2xl font-black text-error"><%= red_cards %></p>
    </div>
    <div class="rounded-2xl bg-base-200 px-4 py-3">
      <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Substituições</p>
      <p class="mt-1 text-2xl font-black"><%= substitutions %></p>
    </div>
  </div>
<% end %>
