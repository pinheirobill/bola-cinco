<div id="match-auto-goals" class="rounded-3xl border border-base-300 bg-base-200 p-4">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Gols automáticos</p>
      <p class="mt-2 text-sm text-base-content/70">
        Digite o minuto de cada gol. Ao salvar, o sistema cria os eventos de gol sem atleta e depois você pode completar o jogador.
      </p>
      <p class="mt-2 text-xs text-base-content/50">
        Para aumentar ou reduzir a quantidade de gols, altere os campos <strong>Placar equipe A</strong> e <strong>Placar equipe B</strong> acima.
      </p>
    </div>
    <div class="rounded-2xl bg-base-100 px-4 py-3 text-right">
      <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Total de gols</p>
      <p class="mt-1 text-3xl font-black" data-match-goal-times-target="totalCount"><%= match.score_a.to_i + match.score_b.to_i %></p>
    </div>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div class="rounded-3xl bg-base-100 p-4">
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class="font-semibold"><%= match.team_a&.name || "Equipe A" %></p>
          <p class="text-xs text-base-content/50">Minuto e tipo de cada gol</p>
        </div>
        <span class="badge badge-primary" data-match-goal-times-target="teamACount"><%= match.score_a.to_i %></span>
      </div>
      <div class="mt-4 space-y-3" data-match-goal-times-target="teamAFields">
        <% if match.score_a.to_i.positive? %>
          <% match.score_a.to_i.times do |index| %>
            <% minute = auto_goal_minutes_a[index] %>
            <% penalty = auto_goal_penalties_a[index] %>
            <div class="rounded-2xl border border-base-300 bg-base-200 p-4 shadow-sm" data-goal-row="true">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <p class="text-sm font-semibold text-base-content/80">Gol <%= index + 1 %></p>
                  <p class="text-xs text-base-content/50">Adicione o minuto e marque se foi de pênalti.</p>
                </div>
                <label class="inline-flex items-center gap-2 rounded-full border border-base-300 bg-base-100 px-3 py-2 text-xs font-semibold">
                  <%= hidden_field_tag "match[goal_penalties_a][#{index}]", "0" %>
                  <%= check_box_tag "match[goal_penalties_a][#{index}]", "1", penalty, class: "checkbox checkbox-primary checkbox-sm", data: { goal_penalty_input: true, action: "change->match-goal-times#refresh" } %>
                  Pênalti
                </label>
              </div>
              <div class="mt-4 grid gap-3 sm:grid-cols-[5.5rem_minmax(0,1fr)] sm:items-center">
                <div class="rounded-xl bg-base-100 px-3 py-3 text-sm font-semibold text-base-content/70">Minuto <%= index + 1 %></div>
                <%= text_field_tag "match[goal_minutes_a][]", minute, class: "input input-bordered w-full", placeholder: "05", maxlength: 2, inputmode: "numeric", data: { goal_minute_input: true, action: "input->match-goal-times#refresh" } %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="rounded-2xl border border-dashed border-base-300 bg-base-100 px-4 py-3 text-sm text-base-content/60">
            Sem gols informados para <%= match.team_a&.name || "Equipe A" %>.
          </div>
        <% end %>
      </div>
    </div>

    <div class="rounded-3xl bg-base-100 p-4">
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class="font-semibold"><%= match.team_b&.name || "Equipe B" %></p>
          <p class="text-xs text-base-content/50">Minuto e tipo de cada gol</p>
        </div>
        <span class="badge badge-primary" data-match-goal-times-target="teamBCount"><%= match.score_b.to_i %></span>
      </div>
      <div class="mt-4 space-y-3" data-match-goal-times-target="teamBFields">
        <% if match.score_b.to_i.positive? %>
          <% match.score_b.to_i.times do |index| %>
            <% minute = auto_goal_minutes_b[index] %>
            <% penalty = auto_goal_penalties_b[index] %>
            <div class="rounded-2xl border border-base-300 bg-base-200 p-4 shadow-sm" data-goal-row="true">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <p class="text-sm font-semibold text-base-content/80">Gol <%= index + 1 %></p>
                  <p class="text-xs text-base-content/50">Adicione o minuto e marque se foi de pênalti.</p>
                </div>
                <label class="inline-flex items-center gap-2 rounded-full border border-base-300 bg-base-100 px-3 py-2 text-xs font-semibold">
                  <%= hidden_field_tag "match[goal_penalties_b][#{index}]", "0" %>
                  <%= check_box_tag "match[goal_penalties_b][#{index}]", "1", penalty, class: "checkbox checkbox-primary checkbox-sm", data: { goal_penalty_input: true, action: "change->match-goal-times#refresh" } %>
                  Pênalti
                </label>
              </div>
              <div class="mt-4 grid gap-3 sm:grid-cols-[5.5rem_minmax(0,1fr)] sm:items-center">
                <div class="rounded-xl bg-base-100 px-3 py-3 text-sm font-semibold text-base-content/70">Minuto <%= index + 1 %></div>
                <%= text_field_tag "match[goal_minutes_b][]", minute, class: "input input-bordered w-full", placeholder: "05", maxlength: 2, inputmode: "numeric", data: { goal_minute_input: true, action: "input->match-goal-times#refresh" } %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="rounded-2xl border border-dashed border-base-300 bg-base-100 px-4 py-3 text-sm text-base-content/60">
            Sem gols informados para <%= match.team_b&.name || "Equipe B" %>.
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
