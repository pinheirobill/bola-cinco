<% team_actions = team.present? ? [
  button_tag(
    "Atletas",
    type: "button",
    class: "btn btn-outline btn-sm",
    data: {
      controller: "match-participation-launcher",
      action: "click->match-participation-launcher#open",
      match_participation_launcher_dialog_id_value: "match-participation-modal",
      match_participation_launcher_team_id_value: team.id
    }
  )
] : [] %>

<% card_body = capture do %>
  <% athlete_ids = Array(athletes).map(&:id) %>

  <div class="flex flex-wrap items-start justify-between gap-4 border-b border-base-300 pb-4">
    <div>
      <p class="text-xl font-bold"><%= title %></p>
      <p class="text-sm text-base-content/60"><%= team&.name || "Sem equipe" %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% team_actions.each do |action| %>
        <%= action %>
      <% end %>
    </div>
  </div>

  <% if athletes.any? %>
    <div class="mt-4 overflow-hidden rounded-3xl border border-base-300">
      <table class="table">
        <thead class="bg-base-200">
          <tr>
            <th>Jogador</th>
            <th>Nº</th>
            <th>Posição</th>
            <th>Presença</th>
            <th class="text-right">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% athletes.each do |athlete| %>
            <% participation = participations_by_athlete[athlete.id] %>
            <% status = participation.present? ? match_participation_status_badge(participation.status) : nil %>
            <tr>
              <td>
                <div class="font-medium"><%= athlete.name %></div>
                <div class="text-xs text-base-content/50"><%= athlete.registration_label.strftime("%d/%m/%Y %H:%M") %></div>
              </td>
              <td class="font-semibold"><%= athlete.shirt_number.presence || "-" %></td>
              <td><%= athlete.position.presence || "-" %></td>
              <td>
                <% if status.present? %>
                  <span class="badge <%= status[:badge] %> badge-sm"><%= status[:label] %></span>
                <% else %>
                  <span class="text-sm text-base-content/40">Sem vínculo</span>
                <% end %>
              </td>
              <td>
                <div class="flex flex-wrap justify-end gap-2">
                  <%= button_to "Confirmar",
                    match_match_participations_path(match),
                    method: :post,
                    params: {
                      return_to: edit_match_path(match),
                      match_participation: {
                        team_id: team&.id,
                        athlete_id: athlete.id,
                        status: "confirmado"
                      }
                    },
                    form_class: "inline-flex",
                    class: "btn btn-success btn-xs" %>
                  <%= button_to "Ausente",
                    match_match_participations_path(match),
                    method: :post,
                    params: {
                      return_to: edit_match_path(match),
                      match_participation: {
                        team_id: team&.id,
                        athlete_id: athlete.id,
                        status: "ausente"
                      }
                    },
                    form_class: "inline-flex",
                    class: "btn btn-error btn-outline btn-xs" %>
                  <% if participation.present? %>
                    <%= button_to "Remover",
                      match_participation_path(participation),
                      method: :delete,
                      params: { return_to: edit_match_path(match) },
                      form_class: "inline-flex",
                      data: { turbo_confirm: "Remover participação?" },
                      class: "btn btn-ghost btn-error btn-xs" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="mt-4">
      <%= empty_state(
        title: "Sem atletas",
        description: "A participação aparece quando a equipe tiver atletas vinculados."
      ) %>
    </div>
  <% end %>

  <% guest_participations = Array(participations).reject { |participation| participation.athlete_id.present? && athlete_ids.include?(participation.athlete_id) } %>
  <% if guest_participations.any? %>
    <div class="mt-4 rounded-3xl border border-base-300">
      <div class="border-b border-base-300 bg-base-200 px-4 py-3">
        <p class="font-semibold">Convidados e substitutos</p>
      </div>
      <div class="divide-y divide-base-300">
        <% guest_participations.each do |participation| %>
          <% status = match_participation_status_badge(participation.status) %>
          <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
            <div>
              <p class="font-medium"><%= participation.athlete_name %></p>
              <p class="text-xs text-base-content/50">
                <%= [participation.shirt_number.presence, participation.position.presence].compact.join(" · ").presence || "Sem dados complementares" %>
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <span class="badge <%= status[:badge] %> badge-sm"><%= status[:label] %></span>
              <%= button_to "Confirmar",
                match_participation_path(participation),
                method: :patch,
                params: {
                  return_to: edit_match_path(match),
                  match_participation: { status: "confirmado" }
                },
                form_class: "inline-flex",
                class: "btn btn-success btn-xs" %>
              <%= button_to "Ausente",
                match_participation_path(participation),
                method: :patch,
                params: {
                  return_to: edit_match_path(match),
                  match_participation: { status: "ausente" }
                },
                form_class: "inline-flex",
                class: "btn btn-error btn-outline btn-xs" %>
              <%= button_to "Remover",
                match_participation_path(participation),
                method: :delete,
                params: { return_to: edit_match_path(match) },
                form_class: "inline-flex",
                data: { turbo_confirm: "Remover participação?" },
                class: "btn btn-ghost btn-error btn-xs" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>

<% if local_assigns.fetch(:wrap, true) %>
  <%= surface_card(title: title, subtitle: team&.name || "Sem equipe", actions: team_actions) do %>
    <%= card_body %>
  <% end %>
<% else %>
  <%= card_body %>
<% end %>
