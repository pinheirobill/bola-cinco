<section id="match-score-card" class="rounded-3xl border border-base-300 bg-base-100 p-6 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <div class="badge badge-outline">Editor da súmula</div>
      <h2 class="mt-3 text-3xl font-black tracking-tight"><%= match.code %></h2>
      <p class="mt-2 text-sm text-base-content/70">
        Ajuste os dados centrais do jogo com o mesmo formato da súmula impressa.
      </p>
    </div>
    <div class="rounded-3xl border border-base-300 bg-base-200 p-4 min-w-48">
      <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Placar atual</p>
      <p class="mt-2 text-3xl font-black"><%= match.score_a || "-" %> x <%= match.score_b || "-" %></p>
      <p class="mt-3 text-xs uppercase tracking-[0.25em] text-base-content/50">Vencedor</p>
      <p class="mt-1 text-sm font-semibold"><%= match.winner_label %></p>
    </div>
  </div>
</section>
