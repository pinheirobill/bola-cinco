<% content_for :title, "Editar súmula | Bola Cinco" %>

<%= page_header(
  title: "Editar súmula",
  subtitle: "#{@match.code} · #{@match.category.name}",
  badge: "Jogos"
) %>

<section class="rounded-3xl border border-base-300 bg-base-100 p-6 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <div class="badge badge-outline">Editor da súmula</div>
      <h2 class="mt-3 text-3xl font-black tracking-tight"><%= @match.code %></h2>
      <p class="mt-2 text-sm text-base-content/70">
        Ajuste os dados centrais do jogo com o mesmo formato da súmula impressa.
      </p>
    </div>
    <div class="rounded-3xl border border-base-300 bg-base-200 p-4 min-w-48">
      <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Placar atual</p>
      <p class="mt-2 text-3xl font-black"><%= @match.score_a || "-" %> x <%= @match.score_b || "-" %></p>
      <p class="mt-3 text-xs uppercase tracking-[0.25em] text-base-content/50">Vencedor</p>
      <p class="mt-1 text-sm font-semibold"><%= @match.winner_label %></p>
    </div>
  </div>
</section>

<%= form_with(model: @match, url: match_path(@match), method: :patch, class: "space-y-6", data: { controller: "autosave-form", action: "input->autosave-form#queue change->autosave-form#queue focusout->autosave-form#queue turbo:submit-end->autosave-form#complete" }) do |f| %>
  <%= hidden_field_tag :autosave, "1", disabled: true, data: { autosave_form_target: "flag" } %>
  <div class="alert alert-info hidden shadow-sm" role="status" aria-live="polite" data-autosave-form-target="status">Salvando...</div>
  <section class="grid gap-6 xl:grid-cols-[1fr_1.05fr] xl:items-start">
    <div class="rounded-3xl border border-base-300 bg-base-100 p-6 shadow-sm self-start" data-controller="match-goal-times" data-match-goal-times-team-a-name-value="<%= @match.team_a&.name || 'Equipe A' %>" data-match-goal-times-team-b-name-value="<%= @match.team_b&.name || 'Equipe B' %>">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h3 class="text-2xl font-bold">Cabeçalho da súmula</h3>
          <p class="mt-2 text-sm text-base-content/70">Os dados principais ficam distribuídos como no documento impresso e salvam automaticamente ao sair do campo.</p>
        </div>
      </div>

      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <div class="form-control gap-2">
          <%= f.label :code, "Código", class: "label-text font-medium" %>
          <%= f.text_field :code, class: "input input-bordered w-full" %>
        </div>
        <div class="form-control gap-2">
          <%= f.label :phase, "Fase", class: "label-text font-medium" %>
          <%= f.text_field :phase, class: "input input-bordered w-full" %>
        </div>
        <div class="form-control gap-2">
          <%= f.label :category_id, "Categoria", class: "label-text font-medium" %>
          <%= f.select :category_id, options_from_collection_for_select(@match.championship.categories.order(:name), :id, :name, @match.category_id), {}, class: "select select-bordered w-full" %>
        </div>
        <div class="form-control gap-2">
          <%= f.label :venue_id, "Ginásio", class: "label-text font-medium" %>
          <%= f.select :venue_id, options_from_collection_for_select(@available_venues, :id, :name, @match.venue_id), { include_blank: "Sem local" }, class: "select select-bordered w-full" %>
        </div>
        <div class="form-control gap-2">
          <%= f.label :scheduled_on, "Data", class: "label-text font-medium" %>
          <%= f.date_field :scheduled_on, class: "input input-bordered w-full" %>
        </div>
        <div class="form-control gap-2">
          <%= f.label :scheduled_time, "Hora", class: "label-text font-medium" %>
          <%= f.time_field :scheduled_time, value: match_scheduled_time_value(@match.scheduled_time), step: 300, class: "input input-bordered w-full" %>
        </div>
        <div class="form-control gap-2">
          <%= f.label :status, "Status", class: "label-text font-medium" %>
          <%= f.select :status, Match.statuses.keys.map { |value| [value.humanize, value] }, {}, class: "select select-bordered w-full" %>
        </div>
        <div class="form-control gap-2">
          <%= f.label :decision, "Decisão", class: "label-text font-medium" %>
          <%= f.select :decision, Match.decisions.keys.map { |value| [value.humanize, value] }, { include_blank: "Normal" }, class: "select select-bordered w-full" %>
        </div>
      </div>
    </div>

    <div class="rounded-3xl border border-base-300 bg-base-100 p-6 shadow-sm self-start">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h3 class="text-2xl font-bold">Resumo técnico</h3>
          <p class="mt-2 text-sm text-base-content/70">Grupo, rodada, W.O. e placar da partida.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <%= link_to "Voltar", match_path(@match), class: "btn btn-outline" %>
          <%= link_to "Classificação", standing_rows_path, class: "btn btn-primary" %>
        </div>
      </div>

      <div class="mt-6 space-y-6">
        <div class="grid gap-4 md:grid-cols-3">
          <div class="form-control gap-2">
            <%= f.label :group_key, "Grupo", class: "label-text font-medium" %>
            <%= f.text_field :group_key, class: "input input-bordered w-full", placeholder: "Grupo A" %>
          </div>
          <div class="form-control gap-2">
            <%= f.label :round_number, "Rodada", class: "label-text font-medium" %>
            <%= f.number_field :round_number, class: "input input-bordered w-full" %>
          </div>
          <div class="form-control gap-2">
            <%= f.label :wo, "W.O.", class: "label-text font-medium" %>
            <%= f.select :wo,
                         options_from_collection_for_select(@available_teams, :name, :name, @match.wo),
                         { include_blank: "Nenhum" },
                         class: "select select-bordered w-full" %>
          </div>
        </div>

        <div class="rounded-3xl border border-base-300 bg-base-200 p-4">
          <div class="grid gap-4 md:grid-cols-2">
          <div class="form-control gap-2">
            <%= f.label :team_a_id, "Equipe A", class: "label-text font-medium" %>
            <%= f.select :team_a_id, options_from_collection_for_select(@available_teams, :id, :name, @match.team_a_id), { include_blank: "Equipe A" }, class: "select select-bordered w-full" %>
          </div>
          <div class="form-control gap-2">
            <%= f.label :team_b_id, "Equipe B", class: "label-text font-medium" %>
            <%= f.select :team_b_id, options_from_collection_for_select(@available_teams, :id, :name, @match.team_b_id), { include_blank: "Equipe B" }, class: "select select-bordered w-full" %>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="form-control gap-2">
              <%= f.label :score_a, "Placar equipe A", class: "label-text font-medium" %>
              <%= f.number_field :score_a, class: "input input-bordered w-full", data: { match_goal_times_target: "scoreA", action: "input->match-goal-times#refresh change->match-goal-times#refresh" } %>
            </div>
            <div class="form-control gap-2">
              <%= f.label :score_b, "Placar equipe B", class: "label-text font-medium" %>
              <%= f.number_field :score_b, class: "input input-bordered w-full", data: { match_goal_times_target: "scoreB", action: "input->match-goal-times#refresh change->match-goal-times#refresh" } %>
            </div>
          </div>
        </div>

        <div class="rounded-3xl border border-base-300 bg-base-200 p-4">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Gols automáticos</p>
              <p class="mt-2 text-sm text-base-content/70">
                Digite o minuto de cada gol. Ao salvar, o sistema cria os eventos de gol sem atleta e depois você pode completar o jogador.
              </p>
            </div>
            <div class="rounded-2xl bg-base-100 px-4 py-3 text-right">
              <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Total de gols</p>
              <p class="mt-1 text-3xl font-black" data-match-goal-times-target="totalCount"><%= @match.score_a.to_i + @match.score_b.to_i %></p>
            </div>
          </div>

          <div class="mt-4 grid gap-4 lg:grid-cols-2">
            <div class="rounded-3xl bg-base-100 p-4">
              <div class="flex items-center justify-between gap-3">
                <div>
                  <p class="font-semibold"><%= @match.team_a&.name || "Equipe A" %></p>
                  <p class="text-xs text-base-content/50">Minuto e tipo de cada gol</p>
                </div>
                <span class="badge badge-primary" data-match-goal-times-target="teamACount"><%= @match.score_a.to_i %></span>
              </div>
              <div class="mt-4 space-y-3" data-match-goal-times-target="teamAFields">
                <% if @match.score_a.to_i.positive? %>
                  <% @match.score_a.to_i.times do |index| %>
                    <% minute = @auto_goal_minutes_a[index] %>
                    <% penalty = @auto_goal_penalties_a[index] %>
                    <div class="rounded-2xl border border-base-300 bg-base-200 p-4 shadow-sm" data-goal-row="true">
                      <div class="flex flex-wrap items-start justify-between gap-3">
                        <div>
                          <p class="text-sm font-semibold text-base-content/80">Gol <%= index + 1 %></p>
                          <p class="text-xs text-base-content/50">Adicione o minuto e marque se foi de pênalti.</p>
                        </div>
                        <label class="inline-flex items-center gap-2 rounded-full border border-base-300 bg-base-100 px-3 py-2 text-xs font-semibold">
                        <%= hidden_field_tag "match[goal_penalties_a][#{index}]", "0" %>
                          <%= check_box_tag "match[goal_penalties_a][#{index}]", "1", penalty, class: "checkbox checkbox-primary checkbox-sm", data: { goal_penalty_input: true, action: "change->match-goal-times#refresh" } %>
                          Pênalti
                        </label>
                      </div>
                      <div class="mt-4 grid gap-3 sm:grid-cols-[5.5rem_minmax(0,1fr)] sm:items-center">
                        <div class="rounded-xl bg-base-100 px-3 py-3 text-sm font-semibold text-base-content/70">Minuto <%= index + 1 %></div>
                        <%= text_field_tag "match[goal_minutes_a][]", minute, class: "input input-bordered w-full", placeholder: "05", maxlength: 2, inputmode: "numeric", data: { goal_minute_input: true, action: "input->match-goal-times#refresh" } %>
                      </div>
                    </div>
                  <% end %>
                <% else %>
                  <div class="rounded-2xl border border-dashed border-base-300 bg-base-100 px-4 py-3 text-sm text-base-content/60">
                    Sem gols informados para <%= @match.team_a&.name || "Equipe A" %>.
                  </div>
                <% end %>
              </div>
            </div>

            <div class="rounded-3xl bg-base-100 p-4">
              <div class="flex items-center justify-between gap-3">
                <div>
                  <p class="font-semibold"><%= @match.team_b&.name || "Equipe B" %></p>
                  <p class="text-xs text-base-content/50">Minuto e tipo de cada gol</p>
                </div>
                <span class="badge badge-primary" data-match-goal-times-target="teamBCount"><%= @match.score_b.to_i %></span>
              </div>
              <div class="mt-4 space-y-3" data-match-goal-times-target="teamBFields">
                <% if @match.score_b.to_i.positive? %>
                  <% @match.score_b.to_i.times do |index| %>
                    <% minute = @auto_goal_minutes_b[index] %>
                    <% penalty = @auto_goal_penalties_b[index] %>
                    <div class="rounded-2xl border border-base-300 bg-base-200 p-4 shadow-sm" data-goal-row="true">
                      <div class="flex flex-wrap items-start justify-between gap-3">
                        <div>
                          <p class="text-sm font-semibold text-base-content/80">Gol <%= index + 1 %></p>
                          <p class="text-xs text-base-content/50">Adicione o minuto e marque se foi de pênalti.</p>
                        </div>
                        <label class="inline-flex items-center gap-2 rounded-full border border-base-300 bg-base-100 px-3 py-2 text-xs font-semibold">
                        <%= hidden_field_tag "match[goal_penalties_b][#{index}]", "0" %>
                          <%= check_box_tag "match[goal_penalties_b][#{index}]", "1", penalty, class: "checkbox checkbox-primary checkbox-sm", data: { goal_penalty_input: true, action: "change->match-goal-times#refresh" } %>
                          Pênalti
                        </label>
                      </div>
                      <div class="mt-4 grid gap-3 sm:grid-cols-[5.5rem_minmax(0,1fr)] sm:items-center">
                        <div class="rounded-xl bg-base-100 px-3 py-3 text-sm font-semibold text-base-content/70">Minuto <%= index + 1 %></div>
                        <%= text_field_tag "match[goal_minutes_b][]", minute, class: "input input-bordered w-full", placeholder: "05", maxlength: 2, inputmode: "numeric", data: { goal_minute_input: true, action: "input->match-goal-times#refresh" } %>
                      </div>
                    </div>
                  <% end %>
                <% else %>
                  <div class="rounded-2xl border border-dashed border-base-300 bg-base-100 px-4 py-3 text-sm text-base-content/60">
                    Sem gols informados para <%= @match.team_b&.name || "Equipe B" %>.
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="rounded-3xl border border-base-300 bg-base-100 p-6 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h3 class="text-2xl font-bold">Árbitro e súmula</h3>
        <p class="mt-2 text-sm text-base-content/70">Selecione o árbitro. O relatório fica em rascunho e salva automaticamente a última alteração.</p>
      </div>
    </div>

    <div class="mt-6 space-y-4">
      <div class="form-control gap-2">
        <%= label_tag "match_report_referee_id", "Árbitro", class: "label-text font-medium" %>
        <%= select_tag "match_report[referee_id]", options_from_collection_for_select(@available_referees, :id, :name, @match_report.referee_id), include_blank: "Selecione", class: "select select-bordered w-full" %>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="rounded-2xl bg-base-200 p-4">
          <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Status</p>
          <p class="mt-2 font-semibold"><%= @match_report.status.titleize %></p>
        </div>
        <div class="rounded-2xl bg-base-200 p-4">
          <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Última gravação</p>
          <p class="mt-2 font-semibold"><%= @match_report.submitted_at.present? ? l(@match_report.submitted_at, format: :short) : "-" %></p>
        </div>
        <div class="rounded-2xl bg-base-200 p-4 sm:col-span-2">
          <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Aprovação</p>
          <p class="mt-2 font-semibold"><%= @match_report.approved_at.present? ? l(@match_report.approved_at, format: :short) : "Aguardando aprovação" %></p>
        </div>
      </div>
      <div class="flex flex-wrap gap-3">
        <%= link_to "Cancelar", match_path(@match), class: "btn btn-outline" %>
      </div>
    </div>
  </section>
<% end %>

<section class="grid gap-6 xl:grid-cols-2">
  <%= surface_card(title: "Escalação A", subtitle: @match.team_a&.name || "-") do %>
    <% if @team_a_athletes.any? %>
      <div class="overflow-hidden rounded-3xl border border-base-300">
        <table class="table">
          <thead class="bg-base-200">
            <tr>
              <th>Nº</th>
              <th>Jogador</th>
              <th>Posição</th>
            </tr>
          </thead>
          <tbody>
            <% @team_a_athletes.each do |athlete| %>
              <tr>
                <td><%= athlete.shirt_number.presence || "-" %></td>
                <td><%= athlete.name %></td>
                <td><%= athlete.position.presence || "-" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state(title: "Sem atletas", description: "A escalação aparece quando a equipe tiver atletas cadastrados.") %>
    <% end %>
  <% end %>

  <%= surface_card(title: "Escalação B", subtitle: @match.team_b&.name || "-") do %>
    <% if @team_b_athletes.any? %>
      <div class="overflow-hidden rounded-3xl border border-base-300">
        <table class="table">
          <thead class="bg-base-200">
            <tr>
              <th>Nº</th>
              <th>Jogador</th>
              <th>Posição</th>
            </tr>
          </thead>
          <tbody>
            <% @team_b_athletes.each do |athlete| %>
              <tr>
                <td><%= athlete.shirt_number.presence || "-" %></td>
                <td><%= athlete.name %></td>
                <td><%= athlete.position.presence || "-" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state(title: "Sem atletas", description: "A escalação aparece quando a equipe tiver atletas cadastrados.") %>
    <% end %>
  <% end %>
</section>

<section class="rounded-3xl border border-base-300 bg-base-100 p-6 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h3 class="text-2xl font-bold">Participação do jogo</h3>
      <p class="mt-2 text-sm text-base-content/70">
        Marque quem realmente participou do jogo. Esse vínculo é separado da equipe e pode incluir atleta convidado.
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <button type="button" class="btn btn-outline btn-sm" onclick="document.getElementById('match-participation-modal').showModal()">Adicionar participação</button>
    </div>
  </div>

  <div class="mt-6 grid gap-6 xl:grid-cols-2">
    <%= render "participation_roster_table",
      title: "Equipe A",
      match: @match,
      team: @match.team_a,
      athletes: @team_a_athletes,
      participations: @team_a_participations,
      participations_by_athlete: @team_a_participations_by_athlete %>
    <%= render "participation_roster_table",
      title: "Equipe B",
      match: @match,
      team: @match.team_b,
      athletes: @team_b_athletes,
      participations: @team_b_participations,
      participations_by_athlete: @team_b_participations_by_athlete %>
  </div>
</section>

<dialog id="match-participation-modal" class="modal">
  <div class="modal-box max-w-5xl" data-controller="athlete-picker">
    <h3 class="text-2xl font-bold">Adicionar participação</h3>
    <p class="mt-2 text-sm text-base-content/70">
      Selecione um ou mais atletas que realmente participaram do jogo. Ao escolher a equipe, o time inteiro já vem selecionado.
    </p>

    <%= form_with(model: @match_participation, url: match_match_participations_path(@match), class: "mt-6 space-y-4") do |f| %>
      <%= hidden_field_tag :return_to, edit_match_path(@match) %>

      <div class="form-control gap-2">
        <%= f.label :team_id, "Equipe", class: "label-text font-medium" %>
        <%= f.select :team_id,
                     options_from_collection_for_select(@available_teams, :id, :name, @match_participation.team_id),
                     { include_blank: "Selecione" },
                     class: "select select-bordered w-full",
                     data: {
                       athlete_picker_target: "teamFilter",
                       action: "change->athlete-picker#syncTeamSelection"
                     } %>
      </div>

      <div class="grid gap-3 lg:grid-cols-[1fr_18rem_auto_auto] lg:items-end">
        <div>
          <label class="label">
            <span class="label-text font-medium">Buscar atleta</span>
          </label>
          <input
            type="search"
            placeholder="Nome, apelido, camisa, posição, equipe..."
            class="input input-bordered w-full"
            data-athlete-picker-target="search"
            data-action="input->athlete-picker#filter"
          >
        </div>

        <div class="hidden rounded-2xl border border-dashed border-warning/40 bg-warning/10 px-4 py-3 text-sm text-base-content/75 lg:col-span-4" data-athlete-picker-target="fallbackMessage">
          Nenhum atleta ficou vinculado a essa equipe. A lista abaixo mostra todos os atletas ativos do sistema.
        </div>

        <div class="rounded-2xl bg-base-200 px-4 py-3 text-sm text-base-content/70">
          <p class="font-semibold text-base-content">Visíveis</p>
          <p class="mt-1 text-2xl font-black" data-athlete-picker-target="visibleCount"><%= @available_participation_athletes.size %></p>
        </div>

        <div class="rounded-2xl bg-base-200 px-4 py-3 text-sm text-base-content/70">
          <p class="font-semibold text-base-content">Selecionados</p>
          <p class="mt-1 text-2xl font-black" data-athlete-picker-target="selectedCount">0</p>
        </div>
      </div>

      <div class="flex flex-wrap gap-3">
        <button type="button" class="btn btn-outline btn-sm" data-action="athlete-picker#selectVisible">Selecionar visíveis</button>
        <button type="button" class="btn btn-ghost btn-sm" data-action="athlete-picker#clearSelection">Limpar seleção</button>
      </div>

      <div class="max-h-[32rem] overflow-y-auto rounded-3xl border border-base-300 bg-base-100 p-3">
        <% if @available_participation_athletes.any? %>
          <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
            <% @available_participation_athletes.each do |athlete| %>
              <% athlete_team_ids = ([athlete.team_id] + athlete.linked_teams.map(&:id)).compact.uniq %>
              <label
                class="group cursor-pointer rounded-2xl border border-base-300 bg-base-200 p-4 transition hover:border-primary hover:bg-base-100"
                data-athlete-picker-target="item"
                data-search-index="<%= athlete.search_index %>"
                data-team-id="<%= athlete.team_id %>"
                data-team-ids="<%= athlete_team_ids.join(' ') %>"
              >
                <%= check_box_tag "match_participation[athlete_ids][]", athlete.id, false, class: "sr-only", data: { action: "change->athlete-picker#refresh" } %>
                <div class="rounded-2xl border border-transparent p-1 transition">
                  <div class="flex items-start gap-3">
                    <div class="avatar shrink-0">
                      <div class="h-14 w-14 rounded-full border border-base-300 bg-base-100">
                        <% if athlete.display_photo_url.present? %>
                          <%= image_tag athlete.display_photo_url, class: "h-full w-full object-cover" %>
                        <% else %>
                          <div class="flex h-full w-full items-center justify-center text-sm font-black text-base-content/70">
                            <%= athlete.initials %>
                          </div>
                        <% end %>
                      </div>
                    </div>

                    <div class="min-w-0 flex-1">
                      <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                          <div class="flex flex-wrap items-center gap-2">
                            <p class="truncate text-base font-bold"><%= athlete.name %></p>
                            <span class="badge badge-success badge-outline opacity-0 transition" data-athlete-picker-selected-mark>Selecionado</span>
                          </div>
                          <p class="mt-1 text-xs uppercase tracking-[0.3em] text-base-content/50">Apelido / nome curto</p>
                          <p class="truncate text-sm font-semibold text-base-content/75"><%= athlete.quick_label %></p>
                        </div>
                        <div class="flex shrink-0 flex-col items-end gap-2">
                          <span class="badge badge-primary badge-outline">Camisa <%= athlete.shirt_number.presence || "-" %></span>
                          <span class="badge badge-neutral"><%= athlete.position.presence || "Sem posição" %></span>
                        </div>
                      </div>

                      <div class="mt-3 grid gap-2 text-xs text-base-content/65 sm:grid-cols-2">
                        <div class="rounded-xl bg-base-100 px-3 py-2">
                          <span class="block uppercase tracking-[0.25em] text-base-content/40">Equipe atual</span>
                          <span class="mt-1 block truncate font-semibold text-base-content"><%= athlete.team.picker_label %></span>
                        </div>
                        <div class="rounded-xl bg-base-100 px-3 py-2">
                          <span class="block uppercase tracking-[0.25em] text-base-content/40">Documento</span>
                          <span class="mt-1 block truncate font-semibold text-base-content"><%= athlete.preferred_document.presence || "Sem documento" %></span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </label>
            <% end %>
          </div>
        <% else %>
          <div class="rounded-2xl border border-dashed border-base-300 p-6 text-sm text-base-content/70">
            Não há atletas cadastrados disponíveis para vincular nesta partida.
          </div>
        <% end %>
      </div>

      <div class="flex flex-wrap gap-3">
        <%= f.submit "Salvar participação", class: "btn btn-primary" %>
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('match-participation-modal').close()">Fechar</button>
      </div>
    <% end %>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<section class="rounded-3xl border border-base-300 bg-base-100 p-6 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h3 class="text-2xl font-bold">Eventos da súmula</h3>
      <p class="mt-2 text-sm text-base-content/70">
        Adicione os lances aqui e veja a folha organizada por atleta, no formato da súmula impressa.
      </p>
    </div>
    <div class="rounded-2xl bg-base-200 px-4 py-3 text-sm text-base-content/70">
      <p class="font-semibold text-base-content">Fluxo de jogo</p>
      <p class="mt-1">Os eventos registrados aqui alimentam o histórico da partida e as suspensões automáticas.</p>
    </div>
  </div>

  <%= form_with(url: match_match_events_path(@match), scope: :match_event, class: "mt-6 space-y-4") do |f| %>
    <div class="grid gap-4 xl:grid-cols-6">
      <%= f.select :kind, MatchEvent.kinds.keys.map { |value| [value.humanize, value] }, {}, class: "select select-bordered w-full" %>
      <%= f.select :team_id, options_from_collection_for_select(@available_teams, :id, :name, @match_event.team_id), { include_blank: "Equipe" }, class: "select select-bordered w-full" %>
      <%= f.select :athlete_id, options_from_collection_for_select(@available_athletes, :id, :match_roster_label, @match_event.athlete_id), { include_blank: "Atleta" }, class: "select select-bordered w-full" %>
      <%= f.number_field :minute, class: "input input-bordered w-full", placeholder: "Minuto" %>
      <%= f.text_field :period, class: "input input-bordered w-full", placeholder: "Período" %>
      <label class="flex items-center gap-2 rounded-2xl border border-base-300 bg-base-200 px-4 py-3 text-sm font-medium">
        <%= check_box_tag "match_event[source_data][penalty]", "1", false, class: "checkbox checkbox-primary checkbox-sm" %>
        Pênalti
      </label>
    </div>
    <%= f.text_area :notes, class: "textarea textarea-bordered w-full", rows: 3, placeholder: "Observações do evento" %>
    <div class="flex flex-wrap items-center gap-3">
      <%= f.submit "Registrar evento", class: "btn btn-primary" %>
      <span class="text-sm text-base-content/60">O preenchimento vai direto para a folha da súmula.</span>
    </div>
  <% end %>

  <div class="mt-6 grid gap-6 xl:grid-cols-2">
    <%= render "event_sheet_table",
      title: "Equipe A",
      team: @match.team_a,
      athletes: @team_a_athletes,
      match_events: @match_events %>
    <%= render "event_sheet_table",
      title: "Equipe B",
      team: @match.team_b,
      athletes: @team_b_athletes,
      match_events: @match_events %>
  </div>
</section>
