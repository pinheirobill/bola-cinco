<% content_for :title, "Editar súmula | Bola Cinco" %>
<% content_for :head do %>
  <script>
    window.BolaCinco ||= {}
    window.BolaCinco.openMatchParticipationModal = function(dialogId, teamId) {
      const dialog = document.getElementById(dialogId)
      if (!dialog) return

      const search = dialog.querySelector('input[type="search"][data-athlete-picker-target="search"]')
      if (search) {
        search.value = ""
      }

      const teamFilters = dialog.querySelectorAll('select[name="match_participation[team_id]"], input[name="match_participation[team_id]"]')
      teamFilters.forEach((teamFilter) => {
        teamFilter.value = teamId || ""
        teamFilter.dispatchEvent(new Event("change", { bubbles: true }))
      })

      if (typeof dialog.showModal === "function") {
        if (!dialog.open) {
          dialog.showModal()
        }
        return
      }

      dialog.setAttribute("open", "")
    }
  </script>
<% end %>

<%= form_with(model: @match, url: match_path(@match), method: :patch, class: "space-y-6", data: { controller: "autosave-form", action: "input->autosave-form#queue change->autosave-form#queue focusout->autosave-form#queue turbo:submit-end->autosave-form#complete" }) do |f| %>
  <%= hidden_field_tag :autosave, "1", disabled: true, data: { autosave_form_target: "flag" } %>
  <div class="alert alert-info hidden shadow-sm" role="status" aria-live="polite" data-autosave-form-target="status">Salvando...</div>
  <section class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] xl:items-start">
    <div class="rounded-3xl border border-base-300 bg-base-100 p-6 shadow-sm self-start">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h3 class="text-2xl font-bold">Resumo técnico</h3>
          <p class="mt-2 text-sm text-base-content/70">Grupo, rodada e W.O. da partida.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <%= link_to "Voltar", match_path(@match), class: "btn btn-outline" %>
          <%= link_to "Classificação", standing_rows_path, class: "btn btn-primary" %>
        </div>
      </div>

      <div class="mt-6 space-y-6">
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          <div class="form-control gap-2">
            <%= f.label :group_key, "Grupo", class: "label-text font-medium" %>
            <%= f.text_field :group_key, class: "input input-bordered w-full", placeholder: "Grupo A" %>
          </div>
          <div class="form-control gap-2">
            <%= f.label :round_number, "Rodada", class: "label-text font-medium" %>
            <%= f.number_field :round_number, class: "input input-bordered w-full" %>
          </div>
          <div class="form-control gap-2">
            <%= f.label :wo, "W.O.", class: "label-text font-medium" %>
            <%= f.select :wo,
                         options_from_collection_for_select(@available_teams, :name, :name, @match.wo),
                         { include_blank: "Nenhum" },
                         class: "select select-bordered w-full" %>
          </div>
          <div class="form-control gap-2 xl:col-span-2">
            <%= f.label :winner_id, "Vencedor manual", class: "label-text font-medium" %>
            <%= f.select :winner_id,
                         options_from_collection_for_select(@available_teams, :id, :name, @match.winner_id),
                         { include_blank: "Auto" },
                         class: "select select-bordered w-full" %>
          </div>
        </div>
      </div>
    </div>

    <div class="rounded-3xl border border-base-300 bg-base-100 p-6 shadow-sm self-start">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h3 class="text-2xl font-bold">Árbitro e súmula</h3>
          <p class="mt-2 text-sm text-base-content/70">Selecione o árbitro. O relatório fica em rascunho e salva automaticamente a última alteração.</p>
        </div>
      </div>

      <div class="mt-6 space-y-4">
        <div class="form-control gap-2">
          <%= label_tag "match_report_referee_id", "Árbitro", class: "label-text font-medium" %>
          <%= select_tag "match_report[referee_id]", options_from_collection_for_select(@available_referees, :id, :name, @match_report.referee_id), include_blank: "Selecione", class: "select select-bordered w-full" %>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          <div class="rounded-2xl bg-base-200 p-4">
            <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Status</p>
            <p class="mt-2 font-semibold"><%= @match_report.status.titleize %></p>
          </div>
          <div class="rounded-2xl bg-base-200 p-4">
            <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Última gravação</p>
            <p class="mt-2 font-semibold"><%= @match_report.submitted_at.present? ? l(@match_report.submitted_at, format: :short) : "-" %></p>
          </div>
          <div class="rounded-2xl bg-base-200 p-4 sm:col-span-2">
            <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Aprovação</p>
            <p class="mt-2 font-semibold"><%= @match_report.approved_at.present? ? l(@match_report.approved_at, format: :short) : "Aguardando aprovação" %></p>
          </div>
        </div>
        <div class="flex flex-wrap gap-3">
          <%= link_to "Cancelar", match_path(@match), class: "btn btn-outline" %>
        </div>
      </div>
    </div>

  </section>

  <section class="rounded-3xl border border-base-300 bg-base-100 p-4 shadow-sm xl:p-5">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h3 class="text-2xl font-bold">Cabeçalho da súmula</h3>
        <p class="mt-2 text-sm text-base-content/70">Os dados principais ficam distribuídos como no documento impresso e salvam automaticamente ao sair do campo.</p>
      </div>
    </div>

    <div class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
      <div class="form-control gap-2">
        <%= f.label :code, "Código", class: "label-text font-medium" %>
        <%= f.text_field :code, class: "input input-bordered w-full" %>
      </div>
      <div class="form-control gap-2">
        <%= f.label :phase, "Fase", class: "label-text font-medium" %>
        <%= f.text_field :phase, class: "input input-bordered w-full" %>
      </div>
      <div class="form-control gap-2">
        <%= f.label :category_id, "Categoria", class: "label-text font-medium" %>
        <%= f.select :category_id, options_from_collection_for_select(@match.championship.categories.order(:name), :id, :name, @match.category_id), {}, class: "select select-bordered w-full" %>
      </div>
      <div class="form-control gap-2">
        <%= f.label :venue_id, "Ginásio", class: "label-text font-medium" %>
        <%= f.select :venue_id, options_from_collection_for_select(@available_venues, :id, :name, @match.venue_id), { include_blank: "Sem local" }, class: "select select-bordered w-full" %>
      </div>
      <div class="form-control gap-2">
        <%= f.label :scheduled_on, "Data", class: "label-text font-medium" %>
        <%= f.date_field :scheduled_on, class: "input input-bordered w-full" %>
      </div>
      <div class="form-control gap-2">
        <%= f.label :scheduled_time, "Hora", class: "label-text font-medium" %>
        <%= f.time_field :scheduled_time, value: match_scheduled_time_value(@match.scheduled_time), step: 300, class: "input input-bordered w-full" %>
      </div>
      <div class="form-control gap-2 xl:col-span-2">
        <%= f.label :status, "Status", class: "label-text font-medium" %>
        <%= f.select :status, Match.statuses.keys.map { |value| [value.humanize, value] }, {}, class: "select select-bordered w-full" %>
      </div>
      <div class="form-control gap-2 xl:col-span-2">
        <%= f.label :decision, "Decisão", class: "label-text font-medium" %>
        <%= f.select :decision, Match.decisions.keys.map { |value| [value.humanize, value] }, { include_blank: "Normal" }, class: "select select-bordered w-full" %>
      </div>
    </div>
  </section>

  <section class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="space-y-6">
      <%= render "matches/event_sheet_editor",
        f: f,
        match: @match,
        team_a_athletes: @team_a_athletes,
        team_b_athletes: @team_b_athletes,
        team_a_participations: @team_a_participations,
        team_b_participations: @team_b_participations,
        team_a_participations_by_athlete: @team_a_participations_by_athlete,
        team_b_participations_by_athlete: @team_b_participations_by_athlete %>
    </div>

    <div class="space-y-6 self-start">
      <%= render "matches/event_summary", match: @match, match_events: @match_events %>
    </div>
  </section>

<% end %>

<dialog id="match-participation-modal" class="modal">
  <div class="modal-box max-w-5xl" data-controller="athlete-picker">
    <h3 class="text-2xl font-bold">Adicionar participação</h3>
    <p class="mt-2 text-sm text-base-content/70">
      Selecione um ou mais atletas que realmente participaram do jogo. A equipe só define o vínculo da participação, mas a busca usa todos os atletas cadastrados do sistema.
    </p>

    <%= form_with(model: @match_participation, url: match_match_participations_path(@match), class: "mt-6 space-y-4") do |f| %>
      <%= hidden_field_tag :return_to, edit_match_path(@match) %>

      <div class="form-control gap-2">
        <%= f.label :team_id, "Equipe", class: "label-text font-medium" %>
        <%= hidden_field_tag "match_participation[team_id]",
                             @match_participation.team_id,
                             data: {
                               athlete_picker_target: "teamFilter",
                               action: "change->athlete-picker#syncTeamSelection"
                             } %>
        <%= f.select :team_id,
                     options_from_collection_for_select(@available_teams, :id, :name, @match_participation.team_id),
                     { include_blank: "Selecione" },
                     class: "select select-bordered w-full",
                     disabled: true %>
      </div>

      <div class="grid gap-3 lg:grid-cols-[1fr_18rem_auto_auto] lg:items-end">
        <div>
          <label class="label">
            <span class="label-text font-medium">Buscar atleta</span>
          </label>
          <input
            type="search"
            placeholder="Nome, apelido, camisa, posição, equipe..."
            class="input input-bordered w-full"
            data-athlete-picker-target="search"
            data-action="input->athlete-picker#filter"
          >
        </div>

        <div class="rounded-2xl border border-dashed border-base-300 bg-base-200 px-4 py-3 text-sm text-base-content/75 lg:col-span-4">
          A lista abaixo mostra todos os atletas cadastrados do sistema. Use a equipe apenas para gravar o vínculo correto na súmula.
        </div>

        <div class="rounded-2xl bg-base-200 px-4 py-3 text-sm text-base-content/70">
          <p class="font-semibold text-base-content">Visíveis</p>
          <p class="mt-1 text-2xl font-black" data-athlete-picker-target="visibleCount"><%= @available_participation_athletes.size %></p>
        </div>

        <div class="rounded-2xl bg-base-200 px-4 py-3 text-sm text-base-content/70">
          <p class="font-semibold text-base-content">Selecionados</p>
          <p class="mt-1 text-2xl font-black" data-athlete-picker-target="selectedCount">0</p>
        </div>
      </div>

      <div class="flex flex-wrap gap-3">
        <button type="button" class="btn btn-outline btn-sm" data-action="athlete-picker#selectVisible">Selecionar visíveis</button>
        <button type="button" class="btn btn-ghost btn-sm" data-action="athlete-picker#clearSelection">Limpar seleção</button>
      </div>

      <div class="max-h-[32rem] overflow-y-auto rounded-3xl border border-base-300 bg-base-100 p-3">
        <% if @available_participation_athletes.any? %>
          <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
            <% @available_participation_athletes.each do |athlete| %>
              <% athlete_team_ids = ([athlete.team_id] + athlete.linked_teams.map(&:id)).compact.uniq %>
              <label
                class="group cursor-pointer rounded-2xl border border-base-300 bg-base-200 p-4 transition hover:border-primary hover:bg-base-100"
                data-athlete-picker-target="item"
                data-search-index="<%= athlete.search_index %>"
                data-team-id="<%= athlete.team_id %>"
                data-team-ids="<%= athlete_team_ids.join(' ') %>"
              >
                <%= check_box_tag "match_participation[athlete_ids][]", athlete.id, false, class: "sr-only", data: { action: "change->athlete-picker#refresh" } %>
                <div class="rounded-2xl border border-transparent p-1 transition">
                  <div class="flex items-start gap-3">
                    <div class="avatar shrink-0">
                      <div class="h-14 w-14 rounded-full border border-base-300 bg-base-100">
                        <% if athlete.display_photo_url.present? %>
                          <%= image_tag athlete.display_photo_url, class: "h-full w-full object-cover" %>
                        <% else %>
                          <div class="flex h-full w-full items-center justify-center text-sm font-black text-base-content/70">
                            <%= athlete.initials %>
                          </div>
                        <% end %>
                      </div>
                    </div>

                    <div class="min-w-0 flex-1">
                      <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                          <div class="flex flex-wrap items-center gap-2">
                            <p class="truncate text-base font-bold"><%= athlete.name %></p>
                            <span class="badge badge-success badge-outline opacity-0 transition" data-athlete-picker-selected-mark>Selecionado</span>
                          </div>
                          <p class="mt-1 text-xs uppercase tracking-[0.3em] text-base-content/50">Apelido / nome curto</p>
                          <p class="truncate text-sm font-semibold text-base-content/75"><%= athlete.quick_label %></p>
                        </div>
                        <div class="flex shrink-0 flex-col items-end gap-2">
                          <span class="badge badge-primary badge-outline">Camisa <%= athlete.shirt_number.presence || "-" %></span>
                          <span class="badge badge-neutral"><%= athlete.position.presence || "Sem posição" %></span>
                        </div>
                      </div>

                      <div class="mt-3 grid gap-2 text-xs text-base-content/65 sm:grid-cols-2">
                        <div class="rounded-xl bg-base-100 px-3 py-2">
                          <span class="block uppercase tracking-[0.25em] text-base-content/40">Equipe atual</span>
                          <span class="mt-1 block truncate font-semibold text-base-content"><%= athlete.team.picker_label %></span>
                        </div>
                        <div class="rounded-xl bg-base-100 px-3 py-2">
                          <span class="block uppercase tracking-[0.25em] text-base-content/40">Documento</span>
                          <span class="mt-1 block truncate font-semibold text-base-content"><%= athlete.preferred_document.presence || "Sem documento" %></span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </label>
            <% end %>
          </div>
        <% else %>
          <div class="rounded-2xl border border-dashed border-base-300 p-6 text-sm text-base-content/70">
            Não há atletas cadastrados disponíveis para vincular nesta partida.
          </div>
        <% end %>
      </div>

      <div class="flex flex-wrap gap-3">
        <%= f.submit "Salvar participação", class: "btn btn-primary" %>
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('match-participation-modal').close()">Fechar</button>
      </div>
    <% end %>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>
