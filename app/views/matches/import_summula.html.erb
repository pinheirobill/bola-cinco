<% content_for :title, "Importar súmula | Arena" %>

<%= page_header(
  title: "Importar súmula",
  subtitle: "#{@match.code} · #{@match.category.name}",
  badge: "Jogos",
  actions: [
    link_to("Voltar ao jogo", match_path(@match), class: "btn btn-outline"),
    link_to("Editar súmula", edit_match_path(@match), class: "btn btn-outline")
  ]
) %>

<% header = @import_preview[:header] || {} %>
<% left_rows = Array(@import_preview.dig(:sides, :left)) %>
<% right_rows = Array(@import_preview.dig(:sides, :right)) %>
<% extracted_lines_count = Array(@import_preview[:extracted_lines]).size %>

<section class="grid gap-6 xl:grid-cols-[1.1fr_0.9fr]">
  <%= surface_card(
    title: "Prévia detectada",
    subtitle: "O sistema leu o PDF e separou os dados principais para conferência."
  ) do %>
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-3xl border border-base-300 bg-base-200 p-4 md:col-span-2">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Arquivo enviado</p>
        <p class="mt-2 text-lg font-semibold"><%= @import_preview[:file_name] %></p>
        <% if @import_preview_file_data_url.present? %>
          <div class="mt-4 overflow-hidden rounded-2xl border border-base-300 bg-base-100">
            <%= image_tag @import_preview_file_data_url, class: "max-h-[28rem] w-full object-contain" %>
          </div>
        <% end %>
      </div>
      <div class="grid gap-3 sm:grid-cols-3 md:col-span-2">
        <div class="rounded-2xl border border-base-300 bg-base-200 p-4">
          <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Linhas lidas</p>
          <p class="mt-2 text-2xl font-black"><%= extracted_lines_count %></p>
        </div>
        <div class="rounded-2xl border border-base-300 bg-base-200 p-4">
          <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Atletas equipe A</p>
          <p class="mt-2 text-2xl font-black"><%= left_rows.size %></p>
        </div>
        <div class="rounded-2xl border border-base-300 bg-base-200 p-4">
          <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Atletas equipe B</p>
          <p class="mt-2 text-2xl font-black"><%= right_rows.size %></p>
        </div>
      </div>
      <div class="rounded-3xl border border-base-300 bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Equipe da esquerda</p>
        <p class="mt-2 text-lg font-semibold"><%= header[:left_team_name].presence || "-" %></p>
      </div>
      <div class="rounded-3xl border border-base-300 bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Equipe da direita</p>
        <p class="mt-2 text-lg font-semibold"><%= header[:right_team_name].presence || "-" %></p>
      </div>
      <div class="rounded-3xl border border-base-300 bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Placar detectado</p>
        <p class="mt-2 text-3xl font-black"><%= header[:score_left].presence || "-" %> x <%= header[:score_right].presence || "-" %></p>
      </div>
      <div class="rounded-3xl border border-base-300 bg-base-200 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Data / local</p>
        <p class="mt-2 text-sm font-semibold">
          <%= [header[:date], header[:venue]].compact.join(" · ").presence || "-" %>
        </p>
      </div>
      <div class="rounded-3xl border border-base-300 bg-base-200 p-4 md:col-span-2">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Observações</p>
        <% if @import_preview[:warnings].present? %>
          <ul class="mt-3 space-y-2 text-sm text-base-content/75">
            <% @import_preview[:warnings].each do |warning| %>
              <li class="rounded-2xl border border-warning/30 bg-warning/10 px-3 py-2"><%= warning %></li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-2 text-sm text-base-content/70">Nenhuma divergência crítica encontrada.</p>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= surface_card(
    title: "Conferência",
    subtitle: "Ajuste o que o PDF sugeriu antes de confirmar a importação."
  ) do %>
    <%= form_with url: import_summula_match_path(@match), method: :post, class: "space-y-4" do %>
      <%= hidden_field_tag "match_summula_import[confirm]", "1" %>
      <%= hidden_field_tag "match_summula_import[token]", @import_token %>

      <div class="grid gap-4 md:grid-cols-2">
        <div class="form-control gap-2">
          <label class="label-text font-medium" for="match_summula_import_left_team_id">Equipe da esquerda no sistema</label>
          <%= select_tag "match_summula_import[left_team_id]",
                options_from_collection_for_select(@import_team_options, :id, :name, @match.team_a_id),
                class: "select select-bordered w-full",
                id: "match_summula_import_left_team_id" %>
        </div>

        <div class="form-control gap-2">
          <label class="label-text font-medium" for="match_summula_import_right_team_id">Equipe da direita no sistema</label>
          <%= select_tag "match_summula_import[right_team_id]",
                options_from_collection_for_select(@import_team_options, :id, :name, @match.team_b_id),
                class: "select select-bordered w-full",
                id: "match_summula_import_right_team_id" %>
        </div>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <div class="form-control gap-2">
          <label class="label-text font-medium" for="match_summula_import_score_a">Placar da equipe esquerda</label>
          <%= number_field_tag "match_summula_import[score_a]", header[:score_left], class: "input input-bordered w-full", id: "match_summula_import_score_a", min: 0 %>
        </div>

        <div class="form-control gap-2">
          <label class="label-text font-medium" for="match_summula_import_score_b">Placar da equipe direita</label>
          <%= number_field_tag "match_summula_import[score_b]", header[:score_right], class: "input input-bordered w-full", id: "match_summula_import_score_b", min: 0 %>
        </div>

        <div class="form-control gap-2">
          <label class="label-text font-medium" for="match_summula_import_scheduled_on">Data do jogo</label>
          <%= date_field_tag "match_summula_import[scheduled_on]", @match.scheduled_on, class: "input input-bordered w-full", id: "match_summula_import_scheduled_on" %>
        </div>

        <div class="form-control gap-2">
          <label class="label-text font-medium" for="match_summula_import_scheduled_time">Hora do jogo</label>
          <%= time_field_tag "match_summula_import[scheduled_time]", match_scheduled_time_value(@match.scheduled_time), class: "input input-bordered w-full", id: "match_summula_import_scheduled_time", step: 300 %>
        </div>
      </div>

      <div class="rounded-3xl border border-base-300 bg-base-200 p-4 text-sm text-base-content/70">
        Se o time ou o atleta estiver incerto, deixe o seletor aberto e siga para o próximo item. O PDF continua registrado para consulta durante esta confirmação.
      </div>

      <div class="flex flex-wrap gap-3">
        <%= link_to "Cancelar", match_path(@match), class: "btn btn-outline" %>
        <%= button_tag "Confirmar importação", class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>
</section>

<section class="grid gap-6 xl:grid-cols-2">
  <%= surface_card(
    title: "Equipe esquerda",
    subtitle: header[:left_team_name].presence || "Não detectada"
  ) do %>
    <% if left_rows.any? %>
      <div class="overflow-hidden rounded-3xl border border-base-300">
        <table class="table">
          <thead class="bg-base-200">
            <tr>
              <th>Nº</th>
              <th>Detectado no PDF</th>
              <th>Confiança</th>
              <th>De / Para</th>
            </tr>
          </thead>
          <tbody>
            <% left_rows.each_with_index do |row, index| %>
              <tr class="<%= row[:shirt_number].to_s == '05' ? 'bg-warning/10' : '' %>">
                <td class="font-semibold"><%= row[:shirt_number] %></td>
                <td>
                  <div class="font-medium"><%= row[:player_name] %></div>
                  <div class="text-xs text-base-content/50 break-all"><%= row[:source_line] %></div>
                </td>
                <td>
                  <% confidence = row.dig(:suggested_athlete, :confidence).to_f %>
                  <span class="badge <%= confidence >= 3.0 ? 'badge-success' : confidence >= 1.8 ? 'badge-warning' : 'badge-outline' %> badge-sm">
                    <%= confidence >= 3.0 ? "Alta" : confidence >= 1.8 ? "Média" : "Baixa" %>
                  </span>
                </td>
                <td>
                  <%= select_tag "match_summula_import[rows][left_#{index}][athlete_id]",
                        options_from_collection_for_select(@import_athletes, :id, :match_roster_label, row.dig(:suggested_athlete, :id)),
                        include_blank: "Selecionar atleta",
                        class: "select select-bordered w-full" %>
                  <%= hidden_field_tag "match_summula_import[rows][left_#{index}][side]", "left" %>
                  <%= hidden_field_tag "match_summula_import[rows][left_#{index}][shirt_number]", row[:shirt_number] %>
                  <%= hidden_field_tag "match_summula_import[rows][left_#{index}][player_name]", row[:player_name] %>
                  <%= hidden_field_tag "match_summula_import[rows][left_#{index}][source_line]", row[:source_line] %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state(
        title: "Sem jogadores detectados",
        description: "O PDF não trouxe uma lista legível para a equipe esquerda."
      ) %>
    <% end %>
  <% end %>

  <%= surface_card(
    title: "Equipe direita",
    subtitle: header[:right_team_name].presence || "Não detectada"
  ) do %>
    <% if right_rows.any? %>
      <div class="overflow-hidden rounded-3xl border border-base-300">
        <table class="table">
          <thead class="bg-base-200">
            <tr>
              <th>Nº</th>
              <th>Detectado no PDF</th>
              <th>Confiança</th>
              <th>De / Para</th>
            </tr>
          </thead>
          <tbody>
            <% right_rows.each_with_index do |row, index| %>
              <tr class="<%= row[:shirt_number].to_s == '05' ? 'bg-warning/10' : '' %>">
                <td class="font-semibold"><%= row[:shirt_number] %></td>
                <td>
                  <div class="font-medium"><%= row[:player_name] %></div>
                  <div class="text-xs text-base-content/50 break-all"><%= row[:source_line] %></div>
                </td>
                <td>
                  <% confidence = row.dig(:suggested_athlete, :confidence).to_f %>
                  <span class="badge <%= confidence >= 3.0 ? 'badge-success' : confidence >= 1.8 ? 'badge-warning' : 'badge-outline' %> badge-sm">
                    <%= confidence >= 3.0 ? "Alta" : confidence >= 1.8 ? "Média" : "Baixa" %>
                  </span>
                </td>
                <td>
                  <%= select_tag "match_summula_import[rows][right_#{index}][athlete_id]",
                        options_from_collection_for_select(@import_athletes, :id, :match_roster_label, row.dig(:suggested_athlete, :id)),
                        include_blank: "Selecionar atleta",
                        class: "select select-bordered w-full" %>
                  <%= hidden_field_tag "match_summula_import[rows][right_#{index}][side]", "right" %>
                  <%= hidden_field_tag "match_summula_import[rows][right_#{index}][shirt_number]", row[:shirt_number] %>
                  <%= hidden_field_tag "match_summula_import[rows][right_#{index}][player_name]", row[:player_name] %>
                  <%= hidden_field_tag "match_summula_import[rows][right_#{index}][source_line]", row[:source_line] %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state(
        title: "Sem jogadores detectados",
        description: "O PDF não trouxe uma lista legível para a equipe direita."
      ) %>
    <% end %>
  <% end %>
</section>
