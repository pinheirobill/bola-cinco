<% content_for :title, "Relatório de jogo | Arena" %>

<%= page_header(
  title: @match_report.match.code,
  subtitle: @match_report.referee&.name || "Relatório de jogo",
  badge: "Relatórios"
) %>

<%= stats_grid([
  { label: "Status", value: @match_report.status.titleize, value_class: "text-2xl" }
], columns: "md:grid-cols-1") %>

<%= surface_card(title: "Detalhes") do %>
  <div class="space-y-2 text-sm text-base-content/70">
    <p><strong>Notas:</strong> <%= @match_report.notes.presence || "-" %></p>
    <p><strong>Súmula:</strong> <%= @match_report.sheet_url.presence || "-" %></p>
    <p><strong>Enviado em:</strong> <%= @match_report.submitted_at.presence || "-" %></p>
    <p><strong>Aprovado em:</strong> <%= @match_report.approved_at.presence || "-" %></p>
  </div>
<% end %>
