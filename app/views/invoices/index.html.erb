<% content_for :title, "Financeiro | Arena" %>

<%= page_header(
  title: "Financeiro",
  subtitle: "Controle de cobranças, pagamentos e pendências do campeonato."
) %>

<%= surface_card do %>
  <% if @invoices.any? %>
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Entidade</th>
            <th>Campeonato</th>
            <th>Categoria</th>
            <th>Vencimento</th>
            <th>Valor</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% @invoices.each do |invoice| %>
            <tr>
              <td><%= invoice.entity.name %></td>
              <td><%= invoice.championship.name %></td>
              <td><%= invoice.category&.name || "-" %></td>
              <td><%= invoice.due_date || "-" %></td>
              <td><%= number_to_currency(invoice.amount) %></td>
              <td><%= status_badge(invoice.status) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= empty_state(
      title: "Nenhuma fatura encontrada",
      description: "As faturas aparecerão aqui quando o campeonato tiver registros financeiros."
    ) %>
  <% end %>
<% end %>
