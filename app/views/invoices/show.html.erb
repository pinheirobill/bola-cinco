<% content_for :title, "Fatura | Arena" %>

<%= page_header(
  title: @invoice.entity.name,
  subtitle: "#{@invoice.championship.name} · #{@invoice.category&.name || 'Sem categoria'}",
  badge: @invoice.status.to_s.tr("_", " ").humanize
) %>

<%= surface_card do %>
  <div class="flex flex-wrap gap-3">
    <div class="badge badge-neutral"><%= number_to_currency(@invoice.amount) %></div>
    <div class="badge badge-outline"><%= @invoice.due_date || "Sem vencimento" %></div>
  </div>
<% end %>
