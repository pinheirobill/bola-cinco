<div class="rounded-2xl bg-base-200 p-4">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="font-semibold"><%= row.team.name %></p>
      <p class="text-sm text-base-content/70">
        <%= row.category.name %>
        <% if row.group_key.present? %>
          · Chave <%= row.group_key %>
        <% end %>
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      <span class="badge badge-primary"><%= row.points %> pts</span>
      <span class="badge badge-neutral"><%= row.position %>º</span>
    </div>
  </div>

  <div class="mt-3 grid grid-cols-4 gap-2 text-sm">
    <div class="rounded-xl bg-base-100 px-3 py-2">
      <div class="text-base-content/50">J</div>
      <div class="font-semibold"><%= row.played %></div>
    </div>
    <div class="rounded-xl bg-base-100 px-3 py-2">
      <div class="text-base-content/50">V</div>
      <div class="font-semibold"><%= row.wins %></div>
    </div>
    <div class="rounded-xl bg-base-100 px-3 py-2">
      <div class="text-base-content/50">SG</div>
      <div class="font-semibold"><%= row.goal_diff %></div>
    </div>
    <div class="rounded-xl bg-base-100 px-3 py-2">
      <div class="text-base-content/50">GC</div>
      <div class="font-semibold"><%= row.goals_against %></div>
    </div>
  </div>
</div>
