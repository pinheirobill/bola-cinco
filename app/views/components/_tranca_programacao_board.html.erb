<% presenter = local_assigns.fetch(:presenter) %>
<% fixed_canvas = local_assigns.fetch(:fixed_canvas, false) %>
<% columns = presenter.columns %>
<% logo_present = championship_logo_attached?(presenter.championship) %>

<div class="<%= fixed_canvas ? 'w-[3840px]' : 'w-full' %> overflow-hidden rounded-[28px] border border-slate-300 bg-white text-slate-950 shadow-sm">
  <div class="flex items-start justify-between gap-4 px-6 py-4 sm:px-8">
    <div class="min-w-0">
      <p class="text-[11px] uppercase tracking-[0.32em] text-slate-700">ESPORTE CLUBE PINHEIROS</p>
      <p class="mt-2 text-[clamp(2rem,2.2vw,4rem)] font-black leading-[0.92] tracking-tight text-slate-950">
        <%= presenter.title %>
      </p>
      <p class="mt-2 text-[11px] font-bold uppercase tracking-[0.34em] text-slate-700">
        <%= presenter.subtitle %>
      </p>
    </div>

    <div class="flex shrink-0 items-start gap-4">
      <% if logo_present %>
        <%= championship_logo_tag(
          presenter.championship,
          class: "h-20 w-20 rounded-full border border-slate-300 bg-white p-1 shadow-sm"
        ) %>
      <% end %>
      <p class="pt-2 text-[11px] uppercase tracking-[0.28em] text-slate-700">
        <%= presenter.issued_at.strftime("%d/%m/%Y %H:%M") %>
      </p>
    </div>
  </div>

  <div class="border-y-[10px] border-[#102A66] bg-white px-6 py-2 sm:px-8"></div>

  <div class="grid gap-6 px-0 py-0 lg:grid-cols-2">
    <% columns.each_with_index do |sections, column_index| %>
      <div class="<%= column_index.zero? ? 'pb-0 lg:border-r lg:border-slate-200' : 'pb-0' %>">
        <% sections.each do |section| %>
          <section class="border-t-[10px] border-[#102A66]">
            <div class="grid grid-cols-[3.75rem_4rem_minmax(0,1fr)_2.4rem_6rem_2.4rem_minmax(0,1fr)] bg-[#F4B400] px-3 py-2 text-[11px] font-black uppercase tracking-wide text-slate-950">
              <div>JG</div>
              <div>mesa</div>
              <div></div>
              <div class="text-right">PTS</div>
              <div class="text-center">CHAVE <%= section[:label] %></div>
              <div>PTS</div>
              <div></div>
            </div>

            <% section[:rows].each_with_index do |row, index| %>
              <div class="grid grid-cols-[3.75rem_4rem_minmax(0,1fr)_2.4rem_6rem_2.4rem_minmax(0,1fr)] items-center px-3 py-2 text-[11px] font-semibold text-slate-950 <%= index.even? ? 'bg-[#FFF7E1]' : 'bg-white' %>">
                <div class="truncate font-black"><%= "JG #{row[:jg]}" %></div>
                <div class="text-center"><%= row[:mesa] %></div>
                <div class="truncate pr-2"><%= row[:team_a] %></div>
                <div class="text-center text-[10px] font-normal text-slate-700"><%= row[:score_a] %></div>
                <div class="text-center text-lg font-black leading-none text-[#D40000]">x</div>
                <div class="text-center text-[10px] font-normal text-slate-700"><%= row[:score_b] %></div>
                <div class="truncate pl-2"><%= row[:team_b] %></div>
              </div>
            <% end %>
          </section>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="flex items-center justify-center border-t border-slate-200 py-4 text-[11px] uppercase tracking-[0.22em] text-slate-600">
    <%= presenter.championship.name.parameterize.upcase.tr("-", " ") %>
  </div>
</div>
