<% rounds = Array(rounds) %>

<div class="rounded-[2rem] border border-base-300 bg-base-100 shadow-sm">
  <div class="border-b border-base-300 px-6 py-5">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-base-content/50">Mata-mata</p>
        <h2 class="mt-2 text-2xl font-black tracking-tight">Chaveamento da Tranca</h2>
        <p class="mt-2 text-sm text-base-content/70">Árvore de confrontos com vencedores e leitura visual da fase eliminatória.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <span class="badge badge-outline"><%= rounds.size %> rodada(s)</span>
        <span class="badge badge-neutral">Eliminatória</span>
      </div>
    </div>
  </div>

  <div class="space-y-6 bg-[radial-gradient(circle_at_top,rgba(255,183,3,0.12),transparent_28%),radial-gradient(circle_at_bottom_right,rgba(76,111,255,0.08),transparent_24%)] p-6">
    <% if rounds.any? %>
      <% initial_matches = rounds.first&.partidas&.size.to_i %>
      <% if initial_matches.positive? %>
        <% column_gap = 360 %>
        <% card_width = 300 %>
        <% card_height = 168 %>
        <% row_gap = 180 %>
        <% left_padding = 24 %>
        <% top_padding = 84 %>
        <% gradient_id = "tranca-bracket-line-#{rounds.first&.id || 'sem-rodada'}-#{rounds.size}-#{initial_matches}" %>
        <% total_rows = [initial_matches * 2 - 1, 1].max %>
        <% canvas_width = left_padding * 2 + ((rounds.size - 1) * column_gap) + card_width + 180 %>
        <% canvas_height = top_padding + ((total_rows - 1) * row_gap) + card_height + 80 %>

        <div class="overflow-x-auto px-4 pb-4">
          <div
            class="relative min-w-max rounded-[1.75rem] border border-base-300/70 bg-[linear-gradient(180deg,rgba(255,255,255,0.88),rgba(245,247,255,0.9))] p-4"
            style="min-width: <%= canvas_width %>px; height: <%= canvas_height %>px;"
          >
            <div class="pointer-events-none absolute inset-0 rounded-[1.75rem] bg-[radial-gradient(circle_at_top_left,rgba(255,183,3,0.12),transparent_24%),radial-gradient(circle_at_bottom_right,rgba(76,111,255,0.10),transparent_24%)]"></div>

            <svg
              class="pointer-events-none absolute inset-0 z-0"
              viewBox="0 0 <%= canvas_width %> <%= canvas_height %>"
              fill="none"
              aria-hidden="true"
            >
              <defs>
                <linearGradient id="<%= gradient_id %>" x1="0" x2="1" y1="0" y2="0">
                  <stop offset="0%" stop-color="#64748b" stop-opacity="0.2" />
                  <stop offset="100%" stop-color="#64748b" stop-opacity="0.72" />
                </linearGradient>
              </defs>

              <% rounds.each_with_index do |round, round_index| %>
                <% next_round = rounds[round_index + 1] %>
                <% next unless next_round.present? %>

                  <% next_round.partidas.each_with_index do |_, parent_index| %>
                  <% child_a = Array(round.partidas)[parent_index * 2] %>
                  <% child_b = Array(round.partidas)[parent_index * 2 + 1] %>
                  <% next unless child_a.present? && child_b.present? %>

                  <% child_a_slot = ((2**round_index) * (2 * (parent_index * 2) + 1)) - 1 %>
                  <% child_b_slot = ((2**round_index) * (2 * (parent_index * 2 + 1) + 1)) - 1 %>
                  <% parent_slot = ((2**(round_index + 1)) * (2 * parent_index + 1)) - 1 %>

                  <% child_x = left_padding + (round_index * column_gap) + card_width %>
                  <% merge_x = child_x + 44 %>
                  <% parent_x = left_padding + ((round_index + 1) * column_gap) %>

                  <% child_a_y = top_padding + (child_a_slot * row_gap) + (card_height / 2) %>
                  <% child_b_y = top_padding + (child_b_slot * row_gap) + (card_height / 2) %>
                  <% parent_y = top_padding + (parent_slot * row_gap) + (card_height / 2) %>

                  <line x1="<%= child_x %>" y1="<%= child_a_y %>" x2="<%= merge_x %>" y2="<%= child_a_y %>" stroke="url(#<%= gradient_id %>)" stroke-width="3" stroke-linecap="round" />
                  <line x1="<%= child_x %>" y1="<%= child_b_y %>" x2="<%= merge_x %>" y2="<%= child_b_y %>" stroke="url(#<%= gradient_id %>)" stroke-width="3" stroke-linecap="round" />
                  <line x1="<%= merge_x %>" y1="<%= child_a_y %>" x2="<%= merge_x %>" y2="<%= child_b_y %>" stroke="url(#<%= gradient_id %>)" stroke-width="3" stroke-linecap="round" />
                  <line x1="<%= merge_x %>" y1="<%= parent_y %>" x2="<%= parent_x %>" y2="<%= parent_y %>" stroke="url(#<%= gradient_id %>)" stroke-width="3" stroke-linecap="round" />
                <% end %>
              <% end %>
            </svg>

            <div class="pointer-events-none absolute left-1/2 top-1/2 z-20 w-[16rem] -translate-x-1/2 -translate-y-1/2">
              <div class="rounded-[2rem] border border-base-300 bg-base-100/95 px-6 py-5 text-center shadow-[0_24px_50px_rgba(15,23,42,0.16)] backdrop-blur">
                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full border-4 border-emerald-300/70 bg-gradient-to-br from-emerald-100 to-white shadow-lg">
                  <span class="text-4xl leading-none">🏆</span>
                </div>
                <p class="mt-4 text-xs font-semibold uppercase tracking-[0.3em] text-base-content/50">Dupla campeã</p>
                <p class="mt-2 text-lg font-black tracking-tight text-base-content"><%= rounds.first&.label || "Mata-mata" %></p>
                <p class="mt-1 text-sm text-base-content/65">Os vencedores avançam até a decisão final.</p>
              </div>
            </div>

            <div class="pointer-events-none absolute inset-x-0 top-4 z-20">
              <% rounds.each_with_index do |round, round_index| %>
                <% left = left_padding + (round_index * column_gap) %>
                <div class="absolute" style="left: <%= left %>px; width: <%= card_width %>px;">
                  <div class="mx-auto w-fit rounded-full border border-base-300 bg-base-100 px-4 py-1 text-xs font-semibold uppercase tracking-[0.25em] text-base-content/60 shadow-sm">
                    <%= round.label %>
                  </div>
                </div>
              <% end %>
            </div>

            <% rounds.each_with_index do |round, round_index| %>
                <% Array(round.partidas).each_with_index do |partida, partida_index| %>
                  <% slot_index = ((2**round_index) * (2 * partida_index + 1)) - 1 %>
                  <% top = top_padding + (slot_index * row_gap) %>
                  <% left = left_padding + (round_index * column_gap) %>
                  <% participants = [partida.dupla_a_nome, partida.dupla_b_nome].compact %>
                  <% teams_label = participants.any? ? participants.join(" x ") : "Confronto a definir" %>

                <div
                  class="absolute z-10"
                  style="left: <%= left %>px; top: <%= top %>px; width: <%= card_width %>px; height: <%= card_height %>px;"
                >
                  <div class="flex h-full flex-col rounded-2xl border border-base-300 bg-base-100 px-4 py-3 shadow-sm">
                    <div class="flex items-start justify-between gap-3">
                      <div class="min-w-0 flex-1">
                        <p class="truncate text-[11px] font-semibold uppercase tracking-[0.2em] text-base-content/50"><%= partida.code %></p>
                        <p class="mt-1 line-clamp-2 text-sm font-semibold leading-snug text-base-content"><%= teams_label %></p>
                      </div>
                      <div class="shrink-0 rounded-full bg-base-200 px-2 py-1 text-[11px] font-semibold text-base-content/60">
                        <%= round.phase_label %>
                      </div>
                    </div>

                    <div class="mt-2 flex items-center justify-between gap-3">
                      <p class="min-w-0 truncate text-xs text-base-content/60"><%= [partida.scheduled_on&.strftime("%d/%m/%Y"), partida.scheduled_time, partida.venue_name].compact.join(" • ") %></p>
                      <div class="shrink-0 rounded-xl bg-base-200 px-3 py-2 text-right">
                        <p class="whitespace-nowrap text-lg font-black leading-none tabular-nums tracking-tight"><%= partida.score_a.to_i %> x <%= partida.score_b.to_i %></p>
                      </div>
                    </div>

                    <div class="mt-2 flex flex-wrap items-center gap-1.5">
                      <span class="badge <%= partida.finished? ? 'badge-success' : 'badge-warning' %> badge-sm"><%= partida.status.humanize %></span>
                      <% if partida.winner.present? %>
                        <span class="badge badge-primary badge-sm"><%= partida.winner.name %></span>
                      <% else %>
                        <span class="badge badge-neutral badge-sm">Em aberto</span>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <%= empty_state(
        title: "Sem chaveamento",
        description: "Quando a fase eliminatória for gerada, as rodadas aparecem aqui."
      ) %>
    <% end %>
  </div>
</div>
