<div class="rounded-3xl border border-dashed border-base-300 bg-base-100 p-8 text-center shadow-sm">
  <h3 class="text-xl font-bold"><%= title %></h3>
  <p class="mt-2 text-sm text-base-content/70"><%= description %></p>

  <% if action.present? %>
    <div class="mt-4">
      <%= action %>
    </div>
  <% end %>
</div>
