<%= link_to athlete_path(athlete), class: "block rounded-2xl bg-base-200 p-4 transition hover:bg-base-100 hover:shadow-md" do %>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="flex items-start gap-3">
      <div class="h-12 w-12 overflow-hidden rounded-full border border-base-300 bg-base-100">
        <% if athlete.display_photo_url.present? %>
          <%= image_tag athlete.display_photo_url, class: "h-full w-full object-cover" %>
        <% else %>
          <div class="flex h-full w-full items-center justify-center bg-base-300 text-sm font-black text-base-content/60">
            <%= athlete.name.to_s.split.map(&:first).first(2).join.upcase %>
          </div>
        <% end %>
      </div>
      <div>
      <p class="font-semibold"><%= link_to athlete.name, athlete_path(athlete), class: "link link-primary" %></p>
      <p class="text-sm text-base-content/70"><%= athlete.team.name %> · <%= athlete.category.name %></p>
      <p class="text-xs text-base-content/50 mt-1">CPF <%= athlete.preferred_document.presence || "não informado" %></p>
      <% unless compact %>
        <p class="text-xs text-base-content/50 mt-1">Número <%= athlete.shirt_number.presence || "não informado" %></p>
      <% end %>
      </div>
    </div>

    <div class="flex flex-wrap gap-2">
      <div class="badge badge-neutral"><%= athlete.shirt_number.presence || "Sem número" %></div>
      <%= status_badge(athlete.status) %>
    </div>
  </div>
<% end %>
