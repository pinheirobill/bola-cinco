<section<% if id.present? %> id="<%= id %>"<% end %> class="<%= ['card', 'border border-base-300 bg-base-100 shadow-sm', classes].reject(&:blank?).join(' ') %>">
  <div class="card-body gap-4">
    <% if title.present? || subtitle.present? || badge.present? || actions.present? %>
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <% if badge.present? %>
            <div class="badge badge-outline"><%= badge %></div>
          <% end %>

          <% if title.present? %>
            <h2 class="mt-2 text-2xl font-black tracking-tight"><%= title %></h2>
          <% end %>

          <% if subtitle.present? %>
            <p class="mt-2 text-sm text-base-content/70"><%= subtitle %></p>
          <% end %>
        </div>

        <% if actions.present? %>
          <div class="flex flex-wrap gap-3">
            <% actions.each do |action| %>
              <%= action %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= body %>
  </div>
</section>
