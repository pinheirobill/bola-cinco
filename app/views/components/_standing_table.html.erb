<div>
  <div class="mb-3 flex items-center justify-between gap-3">
    <h3 class="text-xl font-bold"><%= category.name %></h3>
    <span class="badge badge-outline"><%= rows.size %> equipes</span>
  </div>

  <div class="overflow-x-auto">
    <table class="table table-zebra">
      <thead>
        <tr>
          <th>#</th>
          <th>Equipe</th>
          <th>J</th>
          <th>V</th>
          <th>E</th>
          <th>D</th>
          <th>GP</th>
          <th>GC</th>
          <th>SG</th>
          <th>Pts</th>
        </tr>
      </thead>
      <tbody>
        <% rows.each do |row| %>
          <tr>
            <td><%= row.position %></td>
            <td class="font-medium"><%= link_to row.team.name, team_path(row.team), class: "link link-primary" %></td>
            <td><%= row.played %></td>
            <td><%= row.wins %></td>
            <td><%= row.draws %></td>
            <td><%= row.losses %></td>
            <td><%= row.goals_for %></td>
            <td><%= row.goals_against %></td>
            <td><%= row.goal_diff %></td>
            <td class="font-semibold"><%= row.points %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
