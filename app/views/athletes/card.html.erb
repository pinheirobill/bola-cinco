<% content_for :title, "#{@athlete.name} · Carteirinha | Bola Cinco" %>

<section class="mx-auto w-full max-w-5xl rounded-[2rem] border border-slate-800 bg-slate-950 p-4 shadow-2xl print:shadow-none">
  <div class="overflow-hidden rounded-[1.75rem] bg-white text-slate-900 print:rounded-none print:border-0">
    <div class="grid gap-0 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="relative overflow-hidden bg-[linear-gradient(180deg,#0f172a,#111827_58%,#1f2937)] px-6 py-6 text-white">
        <div class="absolute inset-x-0 top-0 h-1 bg-red-500"></div>
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.35em] text-white/55">Carteira de jogador</p>
            <h1 class="mt-2 text-xl font-black tracking-tight text-white sm:text-2xl"><%= @athlete.championship&.name || @athlete.category.championship_name || "Carteira de jogador" %></h1>
          </div>
          <div class="rounded-full border border-white/15 bg-white/10 px-3 py-2 text-[0.65rem] font-semibold uppercase tracking-[0.28em] text-white/80">
            Profissional
          </div>
        </div>

        <div class="mt-6 flex items-start gap-4">
          <div class="h-24 w-24 overflow-hidden rounded-[1.5rem] border border-white/15 bg-white/10 shadow-lg">
            <% if @athlete.display_photo_url.present? %>
              <%= image_tag @athlete.display_photo_url, class: "h-full w-full object-cover" %>
            <% else %>
              <div class="flex h-full w-full items-center justify-center bg-white/10 text-2xl font-black text-white/80">
                <%= @athlete.initials %>
              </div>
            <% end %>
          </div>

          <div class="min-w-0 flex-1">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-white/50">Atleta</p>
            <h2 class="mt-1 text-3xl font-black tracking-tight text-white"><%= @athlete.name %></h2>
            <p class="mt-1 text-sm text-white/75"><%= @athlete.team.name %> · <%= @athlete.category.name %></p>

            <div class="mt-4 flex flex-wrap gap-2">
              <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold text-white"><%= @athlete.status.titleize %></span>
              <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold text-white">Nº <%= @athlete.shirt_number.presence || "-" %></span>
              <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold text-white"><%= @athlete.position.presence || "Sem posição" %></span>
            </div>
          </div>
        </div>

        <div class="mt-6 rounded-[1.5rem] border border-white/10 bg-white/8 p-4">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.3em] text-white/50">Resumo de performance</p>
          <div class="mt-3 grid grid-cols-4 gap-2">
            <%= card_metric("J", @performance_summary[:matches_played]) %>
            <%= card_metric("G", @performance_summary[:goals]) %>
            <%= card_metric("A", @performance_summary[:assists]) %>
            <%= card_metric("C", @performance_summary[:yellow_cards] + @performance_summary[:red_cards]) %>
          </div>
        </div>

        <div class="mt-4 rounded-[1.25rem] border border-white/10 bg-white/8 p-4">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.3em] text-white/50">Time / categoria</p>
          <p class="mt-2 text-base font-bold text-white"><%= @athlete.team.name %></p>
          <p class="text-sm text-white/70"><%= @athlete.category.name %></p>
        </div>
      </div>

      <div class="bg-[radial-gradient(circle_at_top_right,rgba(15,23,42,0.06),transparent_24%),linear-gradient(180deg,#ffffff,#f8fafc)] px-6 py-6">
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.3em] text-slate-500">Dados do documento</p>
            <h3 class="mt-1 text-xl font-black tracking-tight text-slate-950">Credencial oficial</h3>
          </div>
          <div class="rounded-full border border-slate-200 bg-slate-50 px-3 py-2 text-[0.65rem] font-semibold uppercase tracking-[0.28em] text-slate-500">
            Bola Cinco
          </div>
        </div>

        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          <div class="rounded-[1.25rem] border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-[0.65rem] font-semibold uppercase tracking-[0.28em] text-slate-500">Data de nascimento</p>
            <p class="mt-2 text-base font-semibold text-slate-950"><%= @athlete.birth_date&.strftime("%d/%m/%Y") || "-" %></p>
          </div>
          <div class="rounded-[1.25rem] border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-[0.65rem] font-semibold uppercase tracking-[0.28em] text-slate-500">Inscrição</p>
            <p class="mt-2 text-base font-semibold text-slate-950"><%= @athlete.registration_label.strftime("%d/%m/%Y %H:%M") %></p>
          </div>
          <div class="rounded-[1.25rem] border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-[0.65rem] font-semibold uppercase tracking-[0.28em] text-slate-500">Documento público</p>
            <p class="mt-2 text-base font-semibold text-slate-950">Disponível apenas na área interna</p>
          </div>
          <div class="rounded-[1.25rem] border border-slate-200 bg-white p-4 shadow-sm sm:col-span-2">
            <p class="text-[0.65rem] font-semibold uppercase tracking-[0.28em] text-slate-500">Vínculos no campeonato</p>
            <p class="mt-2 text-sm font-semibold text-slate-950"><%= @athlete.linked_teams.map(&:name).join(" · ").presence || "Sem equipes vinculadas" %></p>
          </div>
        </div>

        <div class="mt-5 rounded-[1.25rem] border border-slate-200 bg-slate-50 p-4">
          <p class="text-[0.65rem] font-semibold uppercase tracking-[0.28em] text-slate-500">Resumo rápido</p>
          <p class="mt-2 text-sm leading-6 text-slate-700">
            Jogos <strong><%= @performance_summary[:matches_played] %></strong>,
            gols <strong><%= @performance_summary[:goals] %></strong>,
            assistências <strong><%= @performance_summary[:assists] %></strong>,
            cartões <strong><%= @performance_summary[:yellow_cards] + @performance_summary[:red_cards] %></strong>
            e suspensões ativas <strong><%= @performance_summary[:active_suspensions] %></strong>.
          </p>
        </div>

        <div class="mt-5 flex flex-wrap gap-3 print:hidden">
          <button type="button" class="btn btn-outline" onclick="window.print()">Imprimir</button>
          <%= link_to "Ver atleta", athlete_path(@athlete), class: "btn btn-ghost" %>
        </div>
      </div>
    </div>
  </div>
</section>
