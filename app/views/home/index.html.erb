<% content_for :title, "Portal | Bola Cinco" %>

<%= page_header(
  title: "Portal público",
  subtitle: "Campeonato, classificação, equipes, atletas e jogos em uma entrada pública.",
  badge: "Visão pública",
  actions: [
    link_to("Ver campeonatos", championships_path, class: "btn btn-primary"),
    (user_signed_in? ? link_to("Área interna", "#area-interna", class: "btn btn-outline") : link_to("Entrar", new_user_session_path, class: "btn btn-outline"))
  ]
) %>

<%= stats_grid([
  { label: "Campeonatos", value: @championships.count, description: "Públicos para navegação" },
  { label: "Campeonato atual", value: @championship&.name || "-", description: @championship&.season || "Sem temporada", value_class: "text-2xl" },
  { label: "Equipes", value: @championship&.categories&.sum { |category| category.teams.size }.to_i, description: "Equipes no campeonato atual" },
  { label: "Atletas", value: @top_athletes.size, description: "Destaques exibidos" }
]) %>

<section class="grid gap-6 xl:grid-cols-[1.2fr_0.8fr]">
  <%= surface_card(
    title: "Campeonato em destaque",
    subtitle: @championship&.name || "Nenhum campeonato público disponível",
    badge: (@championship.present? ? @championship.status.to_s.tr("_", " ").humanize : nil),
    actions: [(@championship.present? ? link_to("Ver campeonato", championship_path(@championship), class: "link link-primary") : nil)].compact
  ) do %>
    <% if @championship.present? %>
      <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-2xl bg-base-200 p-4">
          <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Categorias</p>
          <p class="mt-2 text-2xl font-bold"><%= @championship.categories.count %></p>
        </div>
        <div class="rounded-2xl bg-base-200 p-4">
          <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Jogos</p>
          <p class="mt-2 text-2xl font-bold"><%= @championship.matches.count %></p>
        </div>
        <div class="rounded-2xl bg-base-200 p-4">
          <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Classificação</p>
          <p class="mt-2 text-2xl font-bold"><%= @championship.standing_rows.count %></p>
        </div>
      </div>
      <div class="mt-4 flex flex-wrap gap-2">
        <span class="badge badge-neutral"><%= @championship.competition_mode_label %></span>
        <span class="badge badge-neutral"><%= @championship.season %></span>
      </div>
    <% else %>
      <p class="text-sm text-base-content/70">Nenhum campeonato público disponível no momento.</p>
    <% end %>
  <% end %>

  <%= surface_card(title: "Parceiros em destaque", subtitle: "Apoiadores recentes do campeonato.") do %>
    <div class="space-y-4">
      <% if @featured_partners.any? %>
        <% @featured_partners.each do |partner| %>
          <div class="rounded-2xl bg-base-200 p-4">
            <p class="font-semibold"><%= partner.name %></p>
            <p class="mt-1 text-sm text-base-content/70"><%= partner.tier.titleize %></p>
          </div>
        <% end %>
      <% else %>
        <%= empty_state(
          title: "Sem parceiros em destaque",
          description: "Os apoiadores do campeonato vão aparecer aqui."
        ) %>
      <% end %>
    </div>
  <% end %>
</section>

<section class="grid gap-6 xl:grid-cols-2">
  <%= surface_card(title: "Últimos jogos", actions: [link_to("Ver jogos", matches_path, class: "link link-primary")]) do %>
    <div class="space-y-3">
      <% if @top_matches.any? %>
        <% @top_matches.each do |match| %>
          <%= match_card(match, compact: true) %>
        <% end %>
      <% else %>
        <%= empty_state(
          title: "Sem jogos recentes",
          description: "Quando houver partidas registradas, elas aparecerão nesta lista."
        ) %>
      <% end %>
    </div>
  <% end %>

  <%= surface_card(title: "Top atletas", actions: [link_to("Ver atletas", athletes_path, class: "link link-primary")]) do %>
    <div class="space-y-3">
      <% if @top_athletes.any? %>
        <% @top_athletes.each do |athlete| %>
          <%= athlete_card(athlete, compact: true) %>
        <% end %>
      <% else %>
        <%= empty_state(
          title: "Sem atletas em destaque",
          description: "Os atletas mais relevantes serão listados aqui quando houver dados."
        ) %>
      <% end %>
    </div>
  <% end %>
</section>

<section class="grid gap-6 xl:grid-cols-2">
  <%= surface_card(title: "Melhores equipes", actions: [link_to("Ver equipes", teams_path, class: "link link-primary")]) do %>
    <div class="space-y-3">
      <% if @top_teams.any? %>
        <% @top_teams.each do |team| %>
          <%= standing_row_card(team) %>
        <% end %>
      <% else %>
        <%= empty_state(
          title: "Sem equipes em destaque",
          description: "As equipes mais fortes do campeonato serão mostradas aqui."
        ) %>
      <% end %>
    </div>
  <% end %>

  <%= surface_card(title: "Atalhos", subtitle: "Entradas rápidas para os fluxos principais.") do %>
    <div class="grid gap-3 sm:grid-cols-2">
      <%= link_to "Classificação", standing_rows_path, class: "btn btn-outline btn-block justify-start" %>
      <%= link_to "Campeonatos", championships_path, class: "btn btn-outline btn-block justify-start" %>
      <%= link_to "Equipes", teams_path, class: "btn btn-outline btn-block justify-start" %>
      <%= link_to "Atletas", athletes_path, class: "btn btn-outline btn-block justify-start" %>
    </div>
  <% end %>
</section>

<% if user_signed_in? %>
  <section id="area-interna" class="space-y-6">
    <%= page_header(
      title: "Área interna",
      subtitle: "Tudo que antes estava no dashboard agora fica no Portal.",
      badge: "Área logada"
    ) %>

    <%= stats_grid([
      { label: "Campeonatos acessíveis", value: @accessible_championships.count },
      { label: "Categorias", value: @internal_categories.size },
      { label: "Jogos", value: Match.count },
      { label: "Classificações", value: StandingRow.count }
    ]) %>

    <section class="grid gap-6 xl:grid-cols-[1.35fr_0.95fr]">
      <%= surface_card(
        title: "Campeonato atual",
        subtitle: @internal_championship&.name || "Sem campeonato ativo",
        badge: (@internal_championship.present? ? @internal_championship.season : nil)
      ) do %>
        <% if @internal_championship.present? %>
          <div class="grid gap-4 md:grid-cols-3">
            <div class="rounded-2xl bg-base-200 p-4">
              <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Temporada</p>
              <p class="mt-2 text-2xl font-bold"><%= @internal_championship.season %></p>
            </div>
            <div class="rounded-2xl bg-base-200 p-4">
              <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Categorias</p>
              <p class="mt-2 text-2xl font-bold"><%= @internal_championship.categories.size %></p>
            </div>
            <div class="rounded-2xl bg-base-200 p-4">
              <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Jogos</p>
              <p class="mt-2 text-2xl font-bold"><%= @internal_championship.matches.count %></p>
            </div>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="badge badge-neutral"><%= @internal_championship.competition_mode_label %></span>
            <span class="badge badge-neutral"><%= @internal_championship.categories.count %> categorias</span>
          </div>
        <% else %>
          <p class="text-sm text-base-content/70">Sem campeonato ativo para mostrar.</p>
        <% end %>
      <% end %>

      <%= surface_card(title: "Campeonatos acessíveis", subtitle: "Contextos disponíveis para o usuário atual.") do %>
        <div class="space-y-3">
          <% if @accessible_championships.any? %>
            <% @accessible_championships.each do |championship| %>
              <div class="flex items-center justify-between gap-3 rounded-2xl bg-base-200 p-4">
                <div>
                  <p class="font-semibold"><%= championship.name %></p>
                  <p class="text-sm text-base-content/70"><%= championship.season %></p>
                </div>
                <%= link_to "Ver", championship_path(championship), class: "link link-primary" %>
              </div>
            <% end %>
          <% else %>
            <%= empty_state(
              title: "Nenhum campeonato acessível",
              description: "Quando o usuário tiver acesso a campeonatos, eles aparecem aqui."
            ) %>
          <% end %>
        </div>
      <% end %>
    </section>

    <section class="grid gap-6 xl:grid-cols-2">
      <%= surface_card(title: "Próximos jogos") do %>
        <div class="space-y-3">
          <% if @upcoming_matches.any? %>
            <% @upcoming_matches.each do |match| %>
              <%= match_card(match, compact: true) %>
            <% end %>
          <% else %>
            <%= empty_state(
              title: "Sem jogos agendados",
              description: "Partidas futuras aparecerão aqui quando forem cadastradas."
            ) %>
          <% end %>
        </div>
      <% end %>

      <%= surface_card(title: "Últimos resultados", actions: [link_to("Ver jogos", matches_path, class: "link link-primary")]) do %>
        <div class="space-y-3">
          <% if @recent_matches.any? %>
            <% @recent_matches.each do |match| %>
              <%= match_card(match, compact: true) %>
            <% end %>
          <% else %>
            <%= empty_state(
              title: "Sem resultados recentes",
              description: "Os jogos mais recentes vão aparecer aqui."
            ) %>
          <% end %>
        </div>
      <% end %>
    </section>

    <section class="grid gap-6 xl:grid-cols-2">
      <%= surface_card(title: "Classificação", actions: [link_to("Ver classificação", standing_rows_path, class: "link link-primary")]) do %>
        <div class="space-y-3">
          <% if @top_standings.any? %>
            <% @top_standings.each do |row| %>
              <%= standing_row_card(row) %>
            <% end %>
          <% else %>
            <%= empty_state(
              title: "Sem classificação publicada",
              description: "A tabela aparece aqui quando houver linhas de classificação."
            ) %>
          <% end %>
        </div>
      <% end %>

      <%= surface_card(title: "Categorias do campeonato atual") do %>
        <div class="space-y-3">
          <% if @internal_categories.any? %>
            <% @internal_categories.each do |category| %>
              <div class="flex items-center justify-between gap-3 rounded-2xl bg-base-200 p-4">
                <div>
                  <p class="font-semibold"><%= category.name %></p>
                  <p class="text-sm text-base-content/70"><%= category.teams.size %> equipes</p>
                </div>
                <%= link_to "Ver", category_path(category), class: "link link-primary" %>
              </div>
            <% end %>
          <% else %>
            <%= empty_state(
              title: "Sem categorias carregadas",
              description: "As categorias do campeonato ativo aparecerão aqui."
            ) %>
          <% end %>
        </div>
      <% end %>
    </section>
  </section>
<% end %>
