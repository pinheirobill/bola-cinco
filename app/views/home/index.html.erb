<% content_for :title, "Arena | Gestão esportiva" %>

<section class="relative isolate overflow-hidden rounded-[2rem] border border-base-300 bg-gradient-to-br from-primary/10 via-base-100 to-secondary/15 p-7 shadow-sm sm:p-10 xl:p-14">
  <div class="pointer-events-none absolute -right-24 -top-28 -z-10 h-80 w-80 rounded-full bg-primary/10 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-36 left-1/3 -z-10 h-80 w-80 rounded-full bg-secondary/15 blur-3xl"></div>

  <div class="grid items-center gap-10 xl:grid-cols-[minmax(0,1.25fr)_minmax(18rem,0.75fr)]">
    <div>
      <span class="badge badge-primary badge-outline">Plataforma de gestão esportiva</span>
      <h1 class="mt-6 max-w-3xl text-4xl font-black leading-tight tracking-tight sm:text-5xl xl:text-6xl">
        O esporte acontece em campo. A organização acontece na Arena.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-base-content/70">
        Organize competições, equipes, atletas e partidas em um só lugar. Acompanhe cada etapa e compartilhe as informações com quem participa.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <% if user_signed_in? %>
          <%= link_to "Acessar o sistema", championships_path, class: "btn btn-primary btn-lg" %>
        <% else %>
          <%= link_to "Entrar", new_user_session_path, class: "btn btn-primary btn-lg" %>
          <%= link_to "Criar conta", new_user_registration_path, class: "btn btn-outline btn-lg" %>
        <% end %>
        <%= link_to "Conhecer recursos", "#recursos", class: "btn btn-ghost btn-lg" %>
      </div>
    </div>

    <div class="mx-auto w-full max-w-md">
      <div class="rounded-[2rem] border border-base-300/80 bg-base-100/90 p-5 shadow-xl backdrop-blur sm:p-7">
        <div class="flex items-center justify-between gap-4 border-b border-base-300 pb-5">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.25em] text-base-content/45">Arena</p>
            <p class="mt-1 text-xl font-black">Gestão que acompanha o jogo</p>
          </div>
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary text-2xl font-black text-primary-content" aria-hidden="true">A</div>
        </div>

        <div class="mt-5 space-y-3">
          <% [
            ["01", "Planeje", "Configure categorias, equipes e formatos."],
            ["02", "Organize", "Gerencie partidas, rodadas e súmulas."],
            ["03", "Compartilhe", "Publique resultados e informações para todos."]
          ].each do |step| %>
            <div class="flex items-start gap-4 rounded-2xl bg-base-200 p-4">
              <span class="badge badge-primary badge-outline mt-0.5"><%= step[0] %></span>
              <div>
                <p class="font-bold"><%= step[1] %></p>
                <p class="mt-1 text-sm text-base-content/65"><%= step[2] %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="recursos" class="scroll-mt-8 py-4">
  <div class="mx-auto mb-8 max-w-3xl text-center">
    <span class="badge badge-outline">Tudo conectado</span>
    <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">Da inscrição ao resultado final</h2>
    <p class="mt-3 text-base text-base-content/65">Ferramentas para organizar o trabalho e deixar o jogo em destaque.</p>
  </div>

  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% [
      { icon: "🏆", title: "Competições", description: "Organize temporadas, categorias, regulamentos, fases e inscrições." },
      { icon: "📋", title: "Equipes e atletas", description: "Mantenha cadastros, elencos, vínculos e informações dos participantes." },
      { icon: "⚽", title: "Partidas e súmulas", description: "Monte rodadas, programe jogos e registre placares e eventos da partida." },
      { icon: "📊", title: "Classificação e estatísticas", description: "Acompanhe campanhas, artilharia, cartões e desempenho das equipes." },
      { icon: "🌐", title: "Portal público", description: "Compartilhe tabelas, programação, resultados, equipes e fotos sem exigir acesso interno." },
      { icon: "🔄", title: "Modalidades esportivas", description: "Use fluxos próprios para organizar competições de futebol e tranca." }
    ].each do |feature| %>
      <article class="rounded-3xl border border-base-300 bg-base-100 p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-base-200 text-2xl" aria-hidden="true"><%= feature[:icon] %></span>
        <h3 class="mt-5 text-xl font-bold"><%= feature[:title] %></h3>
        <p class="mt-2 leading-relaxed text-base-content/65"><%= feature[:description] %></p>
      </article>
    <% end %>
  </div>
</section>

<section class="rounded-[2rem] bg-neutral p-7 text-neutral-content sm:p-10 xl:p-12">
  <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-neutral-content/60">Mais tempo para o esporte</p>
      <h2 class="mt-3 text-3xl font-black">Sua próxima competição pode começar aqui.</h2>
      <p class="mt-3 text-neutral-content/70">Acesse a Arena para configurar sua operação e manter a comunidade esportiva por dentro de cada etapa.</p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-3">
      <% if user_signed_in? %>
        <%= link_to "Acessar o sistema", championships_path, class: "btn btn-primary" %>
      <% else %>
        <%= link_to "Criar conta", new_user_registration_path, class: "btn btn-primary" %>
        <%= link_to "Entrar", new_user_session_path, class: "btn btn-outline border-neutral-content/30 text-neutral-content hover:bg-neutral-content/10" %>
      <% end %>
    </div>
  </div>
</section>

<footer class="pb-2 pt-1 text-center text-sm text-base-content/50">
  Arena · Gestão esportiva para quem faz o esporte acontecer.
</footer>
