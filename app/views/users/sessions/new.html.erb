<% portal_modality = params[:portal].presence || session[:portal_modality].presence %>
<% portal_name = case portal_modality
when "tranca" then "Tranca"
when "football" then "Futebol"
end %>
<% content_for :title, [portal_name ? "Entrar no portal #{portal_name}" : "Entrar", "Bola Cinco"].join(" | ") %>

<div class="mx-auto w-full max-w-lg">
  <div class="rounded-[2rem] border border-base-300 bg-base-100 p-8 shadow-2xl">
    <div class="space-y-3">
      <% if portal_name.present? %>
        <p class="text-xs font-semibold uppercase tracking-[0.35em] text-base-content/50"><%= portal_name %></p>
        <h1 class="text-3xl font-black tracking-tight">Entrar no portal <%= portal_name.downcase %></h1>
        <p class="text-sm text-base-content/70">
          Use a mesma conta para navegar no portal do <%= portal_name.downcase %> sem recriar usuários ou permissões.
        </p>
      <% else %>
        <p class="text-xs font-semibold uppercase tracking-[0.35em] text-base-content/50">Acesso</p>
        <h1 class="text-3xl font-black tracking-tight">Entrar</h1>
        <p class="text-sm text-base-content/70">
          Use sua conta para acessar o Bola Cinco.
        </p>
      <% end %>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-5" }) do |f| %>
      <%= hidden_field_tag :portal, portal_modality %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="form-control gap-2">
        <%= f.label :email, class: "label-text font-medium" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input input-bordered w-full" %>
      </div>

      <div class="form-control gap-2">
        <%= f.label :password, class: "label-text font-medium" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "input input-bordered w-full" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="label cursor-pointer justify-start gap-3">
          <%= f.check_box :remember_me, class: "checkbox checkbox-primary" %>
          <span class="label-text">Manter conectado</span>
        </label>
      <% end %>

      <%= f.submit "Entrar", class: "btn btn-primary w-full" %>
    <% end %>

    <div class="mt-6 border-t border-base-300 pt-4 text-sm">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
