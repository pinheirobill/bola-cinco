<% content_for :title, "Entrar | Arena" %>

<div class="card mx-auto w-full max-w-lg border border-base-300 bg-base-100 shadow-xl">
  <div class="card-body gap-6">
    <div>
      <h1 class="card-title text-3xl">Entrar</h1>
      <p class="mt-2 text-sm text-base-content/70">Acesse a conta para continuar no Arena.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="form-control gap-2">
        <%= f.label :email, class: "label-text font-medium" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input input-bordered w-full" %>
      </div>

      <div class="form-control gap-2">
        <%= f.label :password, class: "label-text font-medium" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "input input-bordered w-full" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="label cursor-pointer justify-start gap-3">
          <%= f.check_box :remember_me, class: "checkbox checkbox-primary" %>
          <span class="label-text">Manter conectado</span>
        </label>
      <% end %>

      <%= f.submit "Entrar", class: "btn btn-primary w-full" %>
    <% end %>

    <div class="flex flex-col gap-2 border-t border-base-300 pt-4 text-sm">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
