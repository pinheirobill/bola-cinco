<% content_for :title, "Recuperar senha | Bola Cinco" %>

<div class="card mx-auto w-full max-w-lg border border-base-300 bg-base-100 shadow-xl">
  <div class="card-body gap-6">
    <div>
      <h1 class="card-title text-3xl">Recuperar senha</h1>
      <p class="mt-2 text-sm text-base-content/70">Enviaremos instruções de redefinição para seu e-mail.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="form-control gap-2">
        <%= f.label :email, class: "label-text font-medium" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input input-bordered w-full" %>
      </div>

      <%= f.submit "Enviar instruções", class: "btn btn-primary w-full" %>
    <% end %>

    <div class="flex flex-col gap-2 border-t border-base-300 pt-4 text-sm">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
