<% content_for :title, "Classificação | Bola Cinco" %>

<%= page_header(
  title: "Classificação",
  subtitle: "Tabela consolidada por categoria.",
  badge: "Tabela"
) %>

<%= stats_grid([
  { label: "Categorias", value: @standings_by_category.size, value_class: "text-2xl" },
  { label: "Linhas", value: @standings_by_category.values.sum(&:size), value_class: "text-2xl" }
], columns: "md:grid-cols-2") %>

<%= surface_card do %>
  <div class="space-y-8">
    <% if @standings_by_category.any? %>
      <% @standings_by_category.group_by(&:category).each do |category, rows| %>
        <%= standing_table(category, rows) %>
      <% end %>
    <% else %>
      <%= empty_state(
        title: "Classificação ainda não disponível",
        description: "Quando as partidas forem processadas, a tabela vai aparecer aqui."
      ) %>
    <% end %>
  </div>
<% end %>
