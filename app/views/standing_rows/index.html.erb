<% content_for :title, "Classificação | Bola Cinco" %>

<%= page_header(
  title: "Classificação",
  subtitle: "Tabela consolidada por categoria.",
  badge: "Tabela"
) %>

<%= stats_grid([
  { label: "Chaves", value: @standing_groups.size, value_class: "text-2xl" },
  { label: "Linhas", value: @standing_groups.sum { |group| group.rows.size }, value_class: "text-2xl" }
], columns: "md:grid-cols-2") %>

<%= surface_card do %>
  <div class="space-y-8">
    <% if @standing_groups.any? %>
      <% @standing_groups.each do |group| %>
        <%= standing_table(group.category, group.rows, group_key: group.group_key) %>
      <% end %>
    <% else %>
      <%= empty_state(
        title: "Classificação ainda não disponível",
        description: "Quando as partidas forem processadas, a tabela vai aparecer aqui."
      ) %>
    <% end %>
  </div>
<% end %>
