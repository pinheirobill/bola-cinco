<% content_for :title, "Locais | Arena" %>

<%= page_header(
  title: "Locais",
  subtitle: "Quadras e arenas vinculadas ao campeonato atual.",
  badge: "Operação",
  actions: [
    button_tag("Novo local", type: "button", class: "btn btn-primary", onclick: "document.getElementById('venue-modal').showModal()")
  ]
) %>

<%= stats_grid([
  { label: "Locais cadastrados", value: @venues.size, value_class: "text-2xl" },
  { label: "Campeonato atual", value: current_championship&.name || "-", value_class: "text-2xl" }
], columns: "md:grid-cols-2") %>

<section class="grid gap-6 xl:grid-cols-[1.1fr_0.9fr]">
  <%= surface_card(title: "Locais cadastrados") do %>
    <% if @venues.any? %>
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th>Nome</th>
              <th>Cidade</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @venues.each do |venue| %>
              <tr>
                <td class="font-medium"><%= venue.name %></td>
                <td><%= venue.city.presence || "-" %></td>
                <td><%= status_badge(venue.status) %></td>
                <td><%= link_to "Ver", venue_path(venue), class: "link link-primary" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state(
        title: "Nenhum local cadastrado",
        description: "Crie o primeiro local para vincular jogos ao campeonato."
      ) %>
    <% end %>
  <% end %>
</section>

<dialog id="venue-modal" class="modal" <%= "open" if @venue.errors.any? %>>
  <div class="modal-box max-w-3xl">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-xs uppercase tracking-[0.35em] text-base-content/50">Novo local</p>
        <h3 class="mt-2 text-2xl font-black">Cadastre uma quadra, arena ou ginásio</h3>
        <p class="mt-2 text-sm text-base-content/70">O local entra vinculado ao campeonato atual assim que for criado.</p>
      </div>
      <button type="button" class="btn btn-ghost btn-sm" onclick="document.getElementById('venue-modal').close()">Fechar</button>
    </div>

    <%= form_with model: @venue, url: venues_path, class: "mt-6 space-y-4" do |f| %>
      <%= hidden_field_tag :championship_id, current_championship&.id %>
      <div class="grid gap-4 md:grid-cols-2">
        <div class="form-control gap-2">
          <%= f.label :name, "Nome", class: "label-text font-medium" %>
          <%= f.text_field :name, class: "input input-bordered w-full", placeholder: "Nome" %>
        </div>

        <div class="form-control gap-2">
          <%= f.label :short_name, "Nome curto", class: "label-text font-medium" %>
          <%= f.text_field :short_name, class: "input input-bordered w-full", placeholder: "Nome curto" %>
        </div>

        <div class="form-control gap-2">
          <%= f.label :city, "Cidade", class: "label-text font-medium" %>
          <%= f.text_field :city, class: "input input-bordered w-full", placeholder: "Cidade" %>
        </div>

        <div class="form-control gap-2">
          <%= f.label :status, "Status", class: "label-text font-medium" %>
          <%= f.select :status, Venue.statuses.keys.map { |value| [value.humanize, value] }, {}, class: "select select-bordered w-full" %>
        </div>
      </div>

      <div class="form-control gap-2">
        <%= f.label :address, "Endereço", class: "label-text font-medium" %>
        <%= f.text_field :address, class: "input input-bordered w-full", placeholder: "Endereço" %>
      </div>

      <div class="form-control gap-2">
        <%= f.label :notes, "Observações", class: "label-text font-medium" %>
        <%= f.text_area :notes, class: "textarea textarea-bordered w-full", rows: 4, placeholder: "Observações" %>
      </div>

      <div class="flex flex-wrap gap-3">
        <%= f.submit "Criar local", class: "btn btn-primary" %>
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('venue-modal').close()">Cancelar</button>
      </div>
    <% end %>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>Fechar</button>
  </form>
</dialog>
