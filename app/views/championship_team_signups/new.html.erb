<% content_for :title, "Inscrição de equipes | Bola Cinco" %>

<%= page_header(
  title: "Inscrição de equipes",
  subtitle: @championship.name,
  badge: "Público"
) %>

<% if @team&.errors&.any? %>
  <div class="alert alert-error shadow-sm">
    <span><%= @team.errors.full_messages.join(" · ") %></span>
  </div>
<% end %>

<section class="grid gap-6">
  <%= surface_card(title: "Ficha de inscrição", subtitle: "Selecione um time já cadastrado para vincular ao campeonato.") do %>
    <%= render "form",
      championship: @championship,
      teams: @teams,
      categories: @categories,
      team: @team,
      selected_category: @category,
      back_link_path: championship_path(@championship),
      back_link_label: "Voltar" %>
  <% end %>
</section>
