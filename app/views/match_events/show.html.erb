<% content_for :title, "Evento de jogo | Arena" %>

<%= page_header(
  title: @match_event.kind.humanize,
  subtitle: @match_event.match&.code || @match_event.championship&.name || "Evento",
  badge: "Eventos"
) %>

<%= stats_grid([
  { label: "Período", value: @match_event.period.presence || "-", value_class: "text-2xl" },
  { label: "Minuto", value: @match_event.minute.presence || "-", value_class: "text-2xl" }
], columns: "md:grid-cols-2") %>

<%= surface_card(title: "Detalhes") do %>
  <div class="space-y-2 text-sm text-base-content/70">
    <p><strong>Campeonato:</strong> <%= @match_event.championship&.name || "-" %></p>
    <p><strong>Equipe:</strong> <%= @match_event.team&.name || "-" %></p>
    <p><strong>Atleta:</strong> <%= @match_event.athlete&.name || "-" %></p>
    <p><strong>Notas:</strong> <%= @match_event.notes.presence || "-" %></p>
  </div>
<% end %>
