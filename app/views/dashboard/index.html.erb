<% content_for :title, "Dashboard | Bola Cinco" %>

<section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
  <% stats = [
    ["Campeonatos", @championships.count],
    ["Categorias", @championship&.categories&.count.to_i],
    ["Equipes", Team.count],
    ["Jogos", Match.count]
  ] %>

  <% stats.each do |label, value| %>
    <div class="card border border-base-300 bg-base-100 shadow-sm">
      <div class="card-body">
        <div class="text-sm text-base-content/60"><%= label %></div>
        <div class="text-4xl font-black"><%= value %></div>
      </div>
    </div>
  <% end %>
</section>

<section class="grid gap-6 xl:grid-cols-[2fr_1fr]">
  <div class="card border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body">
      <div class="flex items-center justify-between gap-4">
        <div>
          <h2 class="card-title text-2xl">Campeonato atual</h2>
          <p class="text-sm text-base-content/70"><%= @championship&.name || "Nenhum campeonato importado" %></p>
        </div>
        <% if @championship.present? %>
          <%= status_badge(@championship.status) %>
        <% end %>
      </div>

      <% if @championship.present? %>
        <div class="mt-4 grid gap-4 md:grid-cols-3">
          <div class="rounded-2xl bg-base-200 p-4">
            <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Temporada</p>
            <p class="mt-2 text-2xl font-bold"><%= @championship.season %></p>
          </div>
          <div class="rounded-2xl bg-base-200 p-4">
            <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Categorias</p>
            <p class="mt-2 text-2xl font-bold"><%= @championship.categories.size %></p>
          </div>
          <div class="rounded-2xl bg-base-200 p-4">
            <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Jogos</p>
            <p class="mt-2 text-2xl font-bold"><%= @championship.matches.count %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body">
      <h2 class="card-title text-2xl">Próximos jogos</h2>
      <div class="space-y-3">
        <% @upcoming_matches.each do |match| %>
          <div class="rounded-2xl bg-base-200 p-4">
            <div class="flex items-center justify-between gap-3">
              <div>
                <p class="font-semibold"><%= match.code %></p>
                <p class="text-sm text-base-content/70"><%= match.team_a&.name || "A definir" %> x <%= match.team_b&.name || "A definir" %></p>
              </div>
              <span class="text-xs text-base-content/50"><%= [match.scheduled_on, match.scheduled_time].compact.join(" • ") %></span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<section class="grid gap-6 xl:grid-cols-2">
  <div class="card border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body">
      <div class="flex items-center justify-between">
        <h2 class="card-title text-2xl">Últimos resultados</h2>
        <%= link_to "Ver jogos", matches_path, class: "link link-primary" %>
      </div>
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th>Jogo</th>
              <th>Confronto</th>
              <th>Placar</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_matches.each do |match| %>
              <tr>
                <td><%= match.code %></td>
                <td><%= [match.team_a&.name, match.team_b&.name].compact.join(" x ") %></td>
                <td><%= match.score_a || "-" %> x <%= match.score_b || "-" %></td>
                <td><%= status_badge(match.status) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="card border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body">
      <div class="flex items-center justify-between">
        <h2 class="card-title text-2xl">Classificação</h2>
        <%= link_to "Abrir classificação", standing_rows_path, class: "link link-primary" %>
      </div>
      <div class="space-y-3">
        <% @top_standings.each do |row| %>
          <div class="rounded-2xl bg-base-200 p-4">
            <div class="flex items-center justify-between gap-3">
              <div>
                <p class="font-semibold"><%= row.team.name %></p>
                <p class="text-sm text-base-content/70"><%= row.category.name %></p>
              </div>
              <div class="text-right">
                <p class="font-black"><%= row.points %> pts</p>
                <p class="text-xs text-base-content/50"><%= row.position %>º lugar</p>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
